<UserControl x:Class="GoDental.Wpf.Controls.PasswordEntry" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="True" IsTabStop="False" KeyboardNavigation.TabNavigation="Local" GotKeyboardFocus="EntryFocused" PreviewKeyUp="EntryKeyUp" LostKeyboardFocus="EntryLostFocus">
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <PasswordBox x:Name="MaskedInput" MaxLength="128" AutomationProperties.Name="{Binding Label,ElementName=Root}" PasswordChanged="MaskedChanged"/>
      <TextBox x:Name="VisibleInput" MaxLength="128" AutomationProperties.Name="{Binding Label,ElementName=Root}" Visibility="Collapsed" IsUndoEnabled="False" SpellCheck.IsEnabled="False" TextChanged="VisibleChanged"/>
      <Button x:Name="RevealButton" Grid.Column="1" Content="Mostrar" Width="78" Padding="8,6" Margin="6,0,0,0" Click="RevealClicked" ToolTip="Mostrar u ocultar la contraseña" AutomationProperties.Name="Mostrar contraseña"/>
    </Grid>
    <TextBlock x:Name="CapsNotice" Text="Bloq Mayús está activado." Style="{StaticResource MutedText}" Foreground="{DynamicResource WarningBrush}" Margin="2,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
