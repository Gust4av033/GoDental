<UserControl x:Class="GoDental.Wpf.Controls.BrandLogoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="GoDental, depósito dental" Focusable="False" IsHitTestVisible="False">
  <Viewbox Stretch="Uniform">
    <!-- Coordenadas del PNG original; la máscara conserva exactamente su rotulación. -->
    <Grid Width="1400" Height="1130">
      <Image Source="{StaticResource GoDentalLogo}" Stretch="Fill"/>
      <Rectangle Height="293" VerticalAlignment="Bottom" Fill="{DynamicResource BrandWordmarkBrush}">
        <Rectangle.OpacityMask>
          <ImageBrush ImageSource="{StaticResource GoDentalLogo}" Viewbox="0,0.7407079646,1,0.2592920354" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill"/>
        </Rectangle.OpacityMask>
      </Rectangle>
    </Grid>
  </Viewbox>
</UserControl>
