<Window x:Class="GoDental.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoDental"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{DynamicResource Brush.Surface.Sidebar}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="20,24">
        <TextBlock Text="GoDental"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,24"
                   Text="ERP / POS dental"
                   Foreground="{DynamicResource Brush.Text.Secondary}" />
        <TextBlock Text="Estructura base lista"
                   Style="{StaticResource Text.Body}" />
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" Margin="32">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="GoDental"
                   Style="{StaticResource Text.H1}"
                   HorizontalAlignment="Center" />
        <TextBlock Margin="0,12,0,0"
                   MaxWidth="620"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="Bootstrap de arquitectura completado. Login, Shell, navegación y módulos se implementarán siguiendo ARQ-01 y UX-01." />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
