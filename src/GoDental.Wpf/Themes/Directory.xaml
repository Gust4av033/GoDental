<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:format="clr-namespace:GoDental.Wpf.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <format:CustomerOptionalTextConverter x:Key="DirectoryOptionalText"/>
  <Style x:Key="DirectoryAvatar" TargetType="Border" BasedOn="{StaticResource CommerceAvatar}">
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
    <Setter Property="CornerRadius" Value="15"/><Setter Property="TextElement.FontSize" Value="11"/>
  </Style>
  <Style x:Key="DirectoryIdentity" TargetType="Border" BasedOn="{StaticResource CommerceAvatar}">
    <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
    <Setter Property="CornerRadius" Value="24"/>
  </Style>
  <Style x:Key="DirectoryField" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,0,16,16"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
      <StackPanel>
        <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource FieldLabel}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,8" MinHeight="36">
          <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DirectoryOptionalText}}" Foreground="{DynamicResource TextBrush}"/>
        </Border>
      </StackPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DirectoryEditorField" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,16,16"/>
  </Style>
  <Style x:Key="DirectorySection" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,20,0,0"/>
  </Style>
  <Style x:Key="DirectoryNote" TargetType="Border" BasedOn="{StaticResource SoftPanel}">
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0,16,0,0"/>
  </Style>
</ResourceDictionary>
