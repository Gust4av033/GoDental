<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <BitmapImage x:Key="GoDentalLogo" UriSource="/GoDental;component/Resources/Branding/GoDentalLogo.png"/>
  <!-- El logo original conserva sus colores sobre una placa clara en ambos temas. -->
  <SolidColorBrush x:Key="BrandPaperBrush" Color="{StaticResource LightSurface}"/>
  <SolidColorBrush x:Key="PreviewLightBrush" Color="{StaticResource LightBackground}"/>
  <SolidColorBrush x:Key="PreviewDarkBrush" Color="{StaticResource DarkBackground}"/>
  <Style x:Key="BrandPlate" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrandPaperBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style x:Key="SettingsTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="MinWidth" Value="132"/><Setter Property="Padding" Value="20,12"/>
  </Style>
  <Style x:Key="ThemeChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="180"/><Setter Property="Height" Value="124"/>
    <Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="LightThemeChoice" TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
    <Style.Triggers><DataTrigger Binding="{Binding IsDark}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource TintBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="DarkThemeChoice" TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
    <Style.Triggers><DataTrigger Binding="{Binding IsDark}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource TintBrush}"/></DataTrigger></Style.Triggers>
  </Style>
</ResourceDictionary>
