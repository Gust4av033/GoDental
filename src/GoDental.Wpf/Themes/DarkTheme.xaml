<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource DarkBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkSurface}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource DarkText}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource DarkMuted}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource DarkPrimary}" />
    <SolidColorBrush x:Key="TintBrush" Color="{StaticResource DarkTint}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource DarkSuccess}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource DarkAccent}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource DarkBackground}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#192B3A" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#E5EDF6" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#ADC0D5" />
    <SolidColorBrush x:Key="SidebarSelectionBrush" Color="#2A4160" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#8ED1D4" />
</ResourceDictionary>

