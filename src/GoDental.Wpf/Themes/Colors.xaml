<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tokens semánticos; los Hex definitivos se cerrarán en UX-01 v0.2. -->
  <Color x:Key="Color.Primary">#2563EB</Color>
  <Color x:Key="Color.Secondary">#38BDF8</Color>
  <Color x:Key="Color.Success">#16A34A</Color>
  <Color x:Key="Color.Warning">#D97706</Color>
  <Color x:Key="Color.Danger">#DC2626</Color>
</ResourceDictionary>
