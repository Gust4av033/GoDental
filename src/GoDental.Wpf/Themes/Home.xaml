<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:format="clr-namespace:GoDental.Wpf.Converters">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/></ResourceDictionary.MergedDictionaries>
  <format:HomeColumnsConverter x:Key="HomeColumns"/>
  <Style x:Key="HomeMetricSurface" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="MinHeight" Value="120"/>
  </Style>
  <Style x:Key="HomePanel" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,12"/>
  </Style>
  <Style x:Key="HomeMetricIcon" TargetType="Border" BasedOn="{StaticResource CommerceSymbol}">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="TextElement.FontSize" Value="15"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Sales"><Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Stock"><Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Orders"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="HomeMetricTemplate">
    <Border Style="{StaticResource HomeMetricSurface}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
        <DockPanel Grid.Row="1" Margin="0,2,0,8">
          <Border DockPanel.Dock="Right" Style="{StaticResource HomeMetricIcon}" Margin="8,0,0,0"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="{Binding Value, StringFormat={}{0:N0}, TargetNullValue=—}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="11" LineHeight="17"/>
      </Grid>
    </Border>
  </DataTemplate>
  <Style x:Key="HomeQuickAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
    <Setter Property="Margin" Value="0,0,8,8"/>
  </Style>
</ResourceDictionary>
