<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:format="clr-namespace:GoDental.Wpf.Converters">
  <format:ProductStockCaptionConverter x:Key="ProductStockCaption"/>
  <format:InventoryCostConverter x:Key="InventoryCost"/>
  <Style x:Key="InventorySymbol" TargetType="Border">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="{StaticResource IconRadius}"/>
    <Setter Property="Background" Value="{DynamicResource SidebarSelectionBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style x:Key="InventoryIdentitySymbol" TargetType="Border" BasedOn="{StaticResource InventorySymbol}">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="TextElement.FontSize" Value="22"/>
  </Style>
  <Style x:Key="InventoryIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
  </Style>
  <Style x:Key="InventoryTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,11"/>
  </Style>
  <Style x:Key="InventoryCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="InventoryNumber" TargetType="TextBlock" BasedOn="{StaticResource InventoryCell}">
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style x:Key="InventoryMovementQuantity" TargetType="TextBlock" BasedOn="{StaticResource InventoryNumber}">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
    <Style.Triggers><DataTrigger Binding="{Binding Quantity, Converter={StaticResource IsNegativeAmount}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="InventoryRowLink" TargetType="Button" BasedOn="{StaticResource TextButton}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style x:Key="InventoryField" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,0,16,16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource FieldLabel}"/>
            <Border CornerRadius="{StaticResource ControlRadius}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="10,8" MinHeight="36">
              <TextBlock x:Name="Value" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Sin registrar}" Foreground="{DynamicResource TextBrush}"/>
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="">
              <Setter TargetName="Value" Property="Text" Value="Sin registrar"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="InventoryEmpty" TargetType="ContentControl">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Margin" Value="0,36,0,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource SurfaceBrush}" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
              <Border Style="{StaticResource InventoryIdentitySymbol}" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" Style="{StaticResource MutedText}"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="InventoryState" TargetType="Border" BasedOn="{StaticResource StateBadge}">
    <Style.Triggers>
      <Trigger Property="Tag" Value="Con stock">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Vigente">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="CERRADO">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Stock bajo">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Próximo a vencer">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Sin fecha">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Agotado">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Bloqueado">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Vencido">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="DAÑO">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="VENCIMIENTO">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="TRANSFERENCIA">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectionBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="InventoryYesNo">
    <Border x:Name="Badge" Background="{DynamicResource TintBrush}" CornerRadius="{StaticResource BadgeRadius}" Padding="8,2" HorizontalAlignment="Left">
      <TextBlock x:Name="Caption" Text="No" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding}" Value="True">
        <Setter TargetName="Caption" Property="Text" Value="Sí"/>
        <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SidebarSelectionBrush}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
