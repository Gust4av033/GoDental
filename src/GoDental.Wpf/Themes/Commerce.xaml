<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:format="clr-namespace:GoDental.Wpf.Converters">
  <format:CustomerInitialsConverter x:Key="CommerceInitials"/>
  <format:SaleCustomerNameConverter x:Key="SaleCustomerName"/>
  <Style x:Key="CommerceTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,11"/>
  </Style>
  <Style x:Key="CommerceIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
  </Style>
  <Style x:Key="CommerceCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CommerceNumber" TargetType="TextBlock" BasedOn="{StaticResource CommerceCell}">
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style x:Key="CommerceSymbol" TargetType="Border">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="{StaticResource IconRadius}"/>
    <Setter Property="Background" Value="{DynamicResource SidebarSelectionBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="TextElement.FontSize" Value="18"/>
  </Style>
  <Style x:Key="CommerceAvatar" TargetType="Border" BasedOn="{StaticResource CommerceSymbol}">
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="CommerceList" TargetType="StackPanel">
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CommerceDetail" TargetType="StackPanel">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CommerceField" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,0,16,16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource FieldLabel}"/>
            <Border CornerRadius="{StaticResource ControlRadius}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="10,8" MinHeight="36" TextElement.Foreground="{DynamicResource TextBrush}">
              <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Sin registrar}" ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
            </Border>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CommerceRowLink" TargetType="Button" BasedOn="{StaticResource TextButton}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource TintBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource TintBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CommerceEmpty" TargetType="ContentControl">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Margin" Value="0,36,0,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource SurfaceBrush}" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
              <Border Style="{StaticResource CommerceSymbol}" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource MutedText}" TextAlignment="Center"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CommerceState" TargetType="Border" BasedOn="{StaticResource StateBadge}">
    <Style.Triggers>
      <Trigger Property="Tag" Value="EMITIDA">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="CONVERTIDA">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="CERRADO">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="RECIBIDO">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectionBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="PREPARANDO">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="LISTO">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="EN_RUTA">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectionBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="INCIDENCIA">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="SIN_VENTA">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="PENDIENTE">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="PAGADO">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="BLOQUEADO">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CommerceTextInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMultiline}" Value="True">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MinHeight" Value="66"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="CommerceYesNo">
    <TextBlock x:Name="Caption" Text="No" Style="{StaticResource CommerceCell}"/>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding}" Value="True">
        <Setter TargetName="Caption" Property="Text" Value="Sí"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="CommerceSummary" TargetType="Border" BasedOn="{StaticResource SoftPanel}">
    <Setter Property="Padding" Value="12"/>
  </Style>
</ResourceDictionary>
