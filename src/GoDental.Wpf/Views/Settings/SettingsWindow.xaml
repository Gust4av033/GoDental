<Window x:Class="GoDental.Wpf.Views.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:GoDental.Wpf.Behaviors" xmlns:settings="clr-namespace:GoDental.Wpf.Views.Settings" Title="Ajustes · GoDental" Width="760" Height="680" MinWidth="540" MinHeight="360" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFontFamily}" FontSize="14">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Cerrar ajustes" Style="{StaticResource ActionButton}" Click="CloseClicked" AutomationProperties.Name="Cerrar ajustes"/>
        <TextBlock Text="Ajustes" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0"/>
      </DockPanel>
    </Border>
    <ProgressBar x:Name="SettingsLoading" Grid.Row="0" Height="3" VerticalAlignment="Bottom" IsIndeterminate="True" IsHitTestVisible="False" AutomationProperties.Name="Procesando ajustes">
      <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding CommercialParameters.IsBusy, ElementName=SettingsContent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers></Style></ProgressBar.Style>
    </ProgressBar>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <settings:SettingsView behaviors:WorkspaceViewport.HasPinnedLoading="True" x:Name="SettingsContent" Margin="24"/>
    </ScrollViewer>
  </Grid>
</Window>
