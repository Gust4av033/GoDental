<UserControl x:Class="GoDental.Wpf.Views.Settings.CommercialParametersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:operations="clr-namespace:GoDental.Wpf.Views.Operations">
  <Border Style="{StaticResource Card}" Margin="0,16,0,0">
    <StackPanel>
      <TextBlock Text="Descuentos de venta" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Umbrales compartidos por todas las estaciones. Las ventas anteriores conservan sus importes." Style="{StaticResource MutedText}" Margin="0,4,0,16"/>
      <WrapPanel Margin="0,0,0,12">
        <Button Content="Actualizar parámetros" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
        <Button Content="Editar parámetros" Command="{Binding ChangeCommand}" IsEnabled="{Binding CanChange}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,8"/>
      </WrapPanel>
      <ProgressBar Style="{StaticResource InlineLoadingIndicator}" IsIndeterminate="True" Height="3"/>
      <StackPanel DataContext="{Binding Parameters}" Margin="0,0,0,12">
        <TextBlock Text="Motivo obligatorio por encima de" Style="{StaticResource MutedText}"/>
        <TextBlock Text="{Binding Justification, StringFormat='{}{0:0.####} %', TargetNullValue='Sin consultar'}" FontWeight="SemiBold" FontSize="20" Margin="0,4,0,12"/>
        <TextBlock Text="Autorización administrativa por encima de" Style="{StaticResource MutedText}"/>
        <TextBlock Text="{Binding Authorization, StringFormat='{}{0:0.####} %', TargetNullValue='Sin consultar'}" FontWeight="SemiBold" FontSize="20" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
      <operations:OperationStatusView DataContext="{Binding Operation}"/>
    </StackPanel>
  </Border>
</UserControl>
