<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.PosView">
  <StackPanel>
    <TextBlock Text="Punto de venta" Style="{StaticResource Heading}"/>
    <TextBlock Text="Registra ventas de productos y revisa tu carrito antes de cobrar." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0" IsEnabled="{Binding CanChangeCart}"><TextBlock Text="Caja / almacén" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding Box}" DisplayMemberPath="Name" AutomationProperties.Name="Caja / almacén"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0" IsEnabled="{Binding CanChangeCart}"><TextBlock Text="Lista de precio" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding PriceLists}" SelectedItem="{Binding PriceList}" DisplayMemberPath="Name" AutomationProperties.Name="Lista de precio"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Cliente" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><Button Content="Seleccionar cliente" Tag="&#xE77B;" Command="{Binding SelectCustomerCommand}" IsEnabled="{Binding CanChooseCustomer}" Style="{StaticResource PrimaryButton}"/></StackPanel>
      </Grid>
    </Border>
    <DockPanel Margin="0,0,0,12">
      <WrapPanel DockPanel.Dock="Right"><Button Content="Actualizar" Tag="&#xE72C;" Command="{Binding ReloadCommand}" Margin="0,0,8,0"/><Button Content="Vaciar carrito" Tag="&#xE74D;" Command="{Binding ClearCartCommand}" IsEnabled="{Binding CanEdit}"/></WrapPanel>
      <StackPanel><TextBlock Text="{Binding Customer.Selected.Name, TargetNullValue=Selecciona un cliente}" FontWeight="SemiBold"/><TextBlock Text="{Binding QuotationId, StringFormat=Cotización de origen: {0}}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding QuotationId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
    </DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
    <TabControl IsEnabled="{Binding CanEdit}">
      <TabItem Header="Catálogo">
        <StackPanel>
          <WrapPanel Margin="0,12,0,4">
            <StackPanel Width="270" Margin="0,0,16,12">
              <TextBlock Text="SKU, nombre o código de barras" Margin="0,0,0,6"/>
              <TextBox Style="{StaticResource SearchBox}" Tag="Buscar…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU, nombre o código de barras"/>
            </StackPanel>
            <Button Tag="&#xE721;" Content="Buscar" Command="{Binding SearchCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="250" AutomationProperties.Name="Products" SelectedItem="{Binding Product}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="105"/>
              <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="110"/>
              <DataGridTextColumn Header="Precio público" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="105"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,12,0,4">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
            <Button Content="Agregar al carrito" Command="{Binding AddItemCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanChangeCart}"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Carrito y cálculo">
        <StackPanel>
          <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="200" AutomationProperties.Name="Items" SelectedItem="{Binding SelectedLine}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="105"/>
              <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/>
              <DataGridTextColumn Header="Descuento %" Binding="{Binding DiscountPercent}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,12,0,4">
            <Button Content="Calcular" Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/>
            <Button Content="Editar línea" Command="{Binding EditItemCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanChangeCart}"/>
            <Button Content="Quitar línea" Command="{Binding RemoveItemCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanChangeCart}"/>
          </WrapPanel>
          <WrapPanel IsEnabled="{Binding CanChangeCart}">
            <StackPanel Width="190" Margin="0,0,16,12">
              <TextBlock Text="Descuento global (%)" Margin="0,0,0,6"/>
              <TextBox Text="{Binding GlobalDiscount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descuento global (%)"/>
            </StackPanel>
            <StackPanel Width="190" Margin="0,0,16,12">
              <TextBlock Text="Cargo de entrega" Margin="0,0,0,6"/>
              <TextBox Text="{Binding DeliveryCharge, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cargo de entrega"/>
            </StackPanel>
          </WrapPanel>
          <WrapPanel Margin="0,12,0,4">

          </WrapPanel>
          <DataGrid ItemsSource="{Binding Quote.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="180" AutomationProperties.Name="Quote.Lines">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100"/>
              <DataGridTextColumn Header="Descuento" Binding="{Binding Discount, StringFormat={}{0:N2}}" Width="100"/>
              <DataGridTextColumn Header="Impuesto" Binding="{Binding Tax, StringFormat={}{0:N2}}" Width="100"/>
              <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </TabItem>
    </TabControl>    <Border Style="{StaticResource Card}" Margin="16,0,0,0" Grid.Column="1" VerticalAlignment="Top" ToolTip="{Binding QuoteLabel}">
      <StackPanel>
        <TextBlock Text="Resumen de venta" Style="{StaticResource SectionHeading}" Margin="0,0,0,16"/>
        <StackPanel>
          <TextBlock Text="{Binding Quote.Subtotal, StringFormat=Subtotal: {0:N2}}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Quote.Discount, StringFormat=Descuento: {0:N2}}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Quote.Tax, StringFormat=Impuestos: {0:N2}}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
        </StackPanel>
        <Border Background="{DynamicResource TintBrush}" CornerRadius="4" Padding="12" Margin="0,8,0,4"><StackPanel><TextBlock Text="Total a pagar" FontWeight="SemiBold"/><TextBlock Text="{Binding Quote.Total, StringFormat={}{0:N2}}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
        <StackPanel Margin="0,12,0,4">
          <Button Content="Autorizar descuento" Command="{Binding AuthorizeCommand}" Style="{StaticResource ActionButton}" Margin="0,0,0,8" IsEnabled="{Binding CanAuthorize}"/>
          <Button Content="Emitir cotización" Command="{Binding SaveQuotationCommand}" Style="{StaticResource ActionButton}" Margin="0,0,0,8" IsEnabled="{Binding CanQuote}"/>
          <Button Content="Cobrar" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,8" IsEnabled="{Binding CanSell}"/>
        </StackPanel>
        <TextBlock Text="{Binding ConfirmedSale.Sale.Number, StringFormat=Venta confirmada: {0}}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding ConfirmedSale}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding ConfirmedSale.Sale.Change, StringFormat=Cambio confirmado: {0:N2}}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding ConfirmedSale}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
    </Border>
    </Grid>
  </StackPanel>
</UserControl>
