<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.PosView">

<StackPanel><TextBlock Text="VENTAS" Style="{StaticResource PageEyebrow}" /><TextBlock Text="Punto de venta" Style="{StaticResource Heading}" /><TextBlock Text="Agrega productos, calcula con los precios vigentes y revisa el cobro en una ventana separada." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/><local:OperationStatusView DataContext="{Binding Operation}"/><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><WrapPanel IsEnabled="{Binding CanEdit}"><StackPanel Width="260" Margin="0,0,16,12"><TextBlock Text="Caja / almacén" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding Box}" DisplayMemberPath="Name" AutomationProperties.Name="Caja / almacén"/></StackPanel><StackPanel Width="300" Margin="0,0,16,12"><TextBlock Text="Lista de precio" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding PriceLists}" SelectedItem="{Binding PriceList}" DisplayMemberPath="Name" AutomationProperties.Name="Lista de precio"/></StackPanel></WrapPanel><WrapPanel Margin="0,12,0,4"><Button Content="Actualizar" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Elegir cliente" Command="{Binding SelectCustomerCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanChooseCustomer}"/><Button Content="Vaciar carrito" Command="{Binding ClearCartCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/></WrapPanel><TextBlock Text="{Binding Customer.Selected.Name}" Style="{StaticResource SectionHeading}" /><TextBlock Text="{Binding QuotationId, StringFormat=Cotización de origen: {0}}" Style="{StaticResource MutedText}" /></StackPanel></Border><TabControl IsEnabled="{Binding CanEdit}"><TabItem Header="Catálogo"><StackPanel><WrapPanel Margin="0,12,0,4"><StackPanel Width="320" Margin="0,0,16,12"><TextBlock Text="SKU, nombre o código de barras" Margin="0,0,0,6"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU, nombre o código de barras"/></StackPanel><Button Content="Buscar" Command="{Binding SearchCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/></WrapPanel><DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="230" AutomationProperties.Name="Products" SelectedItem="{Binding Product}"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="110"/><DataGridTextColumn Header="Precio público" Binding="{Binding Price}" Width="120"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Anterior" Command="{Binding PreviousCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Agregar al carrito" Command="{Binding AddItemCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/></WrapPanel></StackPanel></TabItem><TabItem Header="Carrito y cálculo"><StackPanel><DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="200" AutomationProperties.Name="Items" SelectedItem="{Binding SelectedLine}"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="Descuento %" Binding="{Binding DiscountPercent}" Width="110"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Editar línea" Command="{Binding EditItemCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/><Button Content="Quitar línea" Command="{Binding RemoveItemCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/></WrapPanel><WrapPanel IsEnabled="{Binding CanEdit}"><StackPanel Width="190" Margin="0,0,16,12"><TextBlock Text="Descuento global (%)" Margin="0,0,0,6"/><TextBox Text="{Binding GlobalDiscount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descuento global (%)"/></StackPanel><StackPanel Width="190" Margin="0,0,16,12"><TextBlock Text="Cargo de entrega" Margin="0,0,0,6"/><TextBox Text="{Binding DeliveryCharge, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cargo de entrega"/></StackPanel></WrapPanel><WrapPanel Margin="0,12,0,4"><Button Content="Calcular" Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/></WrapPanel><DataGrid ItemsSource="{Binding Quote.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="180" AutomationProperties.Name="Quote.Lines"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice}" Width="100"/><DataGridTextColumn Header="Descuento" Binding="{Binding Discount}" Width="100"/><DataGridTextColumn Header="Impuesto" Binding="{Binding Tax}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></TabItem></TabControl><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{Binding QuoteLabel}" Style="{StaticResource SectionHeading}" /><WrapPanel><TextBlock Text="{Binding Quote.Subtotal, StringFormat=Subtotal: {0:N2}}" Style="{StaticResource MutedText}" Margin="0,0,20,8"/><TextBlock Text="{Binding Quote.Discount, StringFormat=Descuento: {0:N2}}" Style="{StaticResource MutedText}" Margin="0,0,20,8"/><TextBlock Text="{Binding Quote.Tax, StringFormat=Impuestos: {0:N2}}" Style="{StaticResource MutedText}" Margin="0,0,20,8"/></WrapPanel><TextBlock Text="{Binding Quote.Total, StringFormat=Total: {0:N2}}" Style="{StaticResource MetricValue}" /><WrapPanel Margin="0,12,0,4"><Button Content="Autorizar descuento" Command="{Binding AuthorizeCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanAuthorize}"/><Button Content="Emitir cotización" Command="{Binding SaveQuotationCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanQuote}"/><Button Content="Cobrar" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanSell}"/></WrapPanel><TextBlock Text="{Binding ConfirmedSale.Sale.Number, StringFormat=Venta confirmada: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ConfirmedSale.Sale.Change, StringFormat=Cambio confirmado: {0:N2}}" Style="{StaticResource MutedText}" /></StackPanel></Border></StackPanel>
</UserControl>
