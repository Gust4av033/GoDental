<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.PosView" x:Name="PosRoot">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F2" Command="{Binding SelectCustomerCommand}"/>
    <KeyBinding Key="F3" Command="{Binding SearchCommand}"/>
  </UserControl.InputBindings>
  <StackPanel>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <StackPanel Style="{StaticResource CommerceList}" Tag="{Binding HasConfirmedSale}">
      <DockPanel Margin="0,0,0,16">
        <Button Content="Cliente (F2)" Command="{Binding SelectCustomerCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanChooseCustomer}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Punto de venta" Style="{StaticResource Heading}"/>
          <TextBlock Text="Elige productos, revisa tu carrito y continúa al cobro." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Grid Margin="0,0,0,16" IsEnabled="{Binding CanChangeCart}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Caja / almacén" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding Box}" DisplayMemberPath="Name" AutomationProperties.Name="Caja / almacén"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Lista de precio" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding PriceLists}" SelectedItem="{Binding PriceList}" DisplayMemberPath="Name" AutomationProperties.Name="Lista de precio"/>
            </StackPanel>
          </Grid>
          <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CartCountLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="{Binding Customer.Selected.Name, TargetNullValue=Venta sin cliente, FallbackValue=Venta sin cliente}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding QuotationId, StringFormat=Cotización de origen: {0}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding QuotationId}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </DockPanel>
          <TabControl IsEnabled="{Binding CanEdit}">
            <TabItem Header="Productos" Style="{StaticResource CommerceTab}">
              <StackPanel Margin="0,16,0,0">
                <DockPanel Margin="0,0,0,12">
                  <Button Content="" Command="{Binding ReloadCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Actualizar productos" AutomationProperties.Name="Actualizar productos" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <Button Content="" Command="{Binding SearchCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Buscar productos" AutomationProperties.Name="Buscar productos" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <TextBox x:Name="PosSearch" Style="{StaticResource SearchBox}" Tag="SKU, nombre o código de barras…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU, nombre o código de barras">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                  </TextBox>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                  <Button Content="Agregar al carrito" Command="{Binding AddItemCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanAddProduct}" DockPanel.Dock="Right"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="‹" Command="{Binding PreviousCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
                    <Button Content="›" Command="{Binding NextCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
                  </StackPanel>
                </DockPanel>
                <Grid>
                  <ListBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" Style="{StaticResource CatalogSelector}" ItemContainerStyle="{StaticResource CatalogTile}" ItemTemplate="{StaticResource PosProductCard}" Height="250" AutomationProperties.Name="Catálogo de productos del POS">
                    <ListBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"/>
                    </ListBox.InputBindings>
                  </ListBox>
                  <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Products.Count}" Content="No hay productos disponibles para esta búsqueda."/>
                </Grid>
              </StackPanel>
            </TabItem>
            <TabItem Header="Carrito y cálculo" Style="{StaticResource CommerceTab}">
              <StackPanel Margin="0,16,0,0">
                <DockPanel Margin="0,0,0,12">
                  <Button Content="" Command="{Binding ClearCartCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Vaciar carrito" AutomationProperties.Name="Vaciar carrito" DockPanel.Dock="Right" IsEnabled="{Binding CanEdit}"/>
                  <TextBlock Text="Carrito de venta" Style="{StaticResource SectionHeading}"/>
                </DockPanel>
                <WrapPanel Margin="0,0,0,12" IsEnabled="{Binding CanChangeCart}">
                  <Button Content="Editar línea" Command="{Binding EditItemCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                  <Button Content="Quitar línea" Command="{Binding RemoveItemCommand}" Style="{StaticResource ActionButton}"/>
                </WrapPanel>
                <Grid>
                  <DataGrid ItemsSource="{Binding CartRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="235" AutomationProperties.Name="CartRows" SelectedValuePath="Input" SelectedValue="{Binding SelectedLine}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CommerceCell}" MinWidth="180"/>
                      <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="75" ElementStyle="{StaticResource CommerceCell}"/>
                      <DataGridTextColumn Header="Precio" Binding="{Binding Calculation.UnitPrice, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                      <DataGridTextColumn Header="Descuento" Binding="{Binding Calculation.Discount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                      <DataGridTextColumn Header="Impuesto" Binding="{Binding Calculation.Tax, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                      <DataGridTextColumn Header="Total" Binding="{Binding Calculation.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding CartRows.Count}" Content="Tu carrito está vacío. Agrega productos desde el catálogo."/>
                </Grid>
                <Expander Header="Descuento global y entrega" IsEnabled="{Binding CanChangeCart}">
                  <UniformGrid Columns="2" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="Descuento global (%)" Style="{StaticResource FieldLabel}"/>
                      <TextBox Text="{Binding GlobalDiscount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descuento global (%)"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Cargo de entrega USD" Style="{StaticResource FieldLabel}"/>
                      <TextBox Text="{Binding DeliveryCharge, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cargo de entrega"/>
                    </StackPanel>
                  </UniformGrid>
                </Expander>
              </StackPanel>
            </TabItem>
          </TabControl>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource CommerceSummary}" Margin="16,0,0,0" VerticalAlignment="Top" ToolTip="{Binding QuoteLabel}">
          <StackPanel>
            <TextBlock Text="Resumen de venta" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Subtotal, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Subtotal" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Discount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Descuento" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Tax, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Impuestos" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Cart.DeliveryCharge, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Entrega" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <Border Style="{StaticResource CommerceSummary}" Margin="0,8,0,12">
                <StackPanel>
                  <TextBlock Text="Total a pagar" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding Quote.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <Button Content="Calcular" Command="{Binding CalculateCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <Button Content="Cobrar" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanSell}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
            <Expander Header="Cotización y autorización">
              <StackPanel Margin="0,12,0,0">
                <Button Content="Emitir cotización" Command="{Binding SaveQuotationCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanQuote}" Margin="0,0,0,8"/>
                <Button Content="Autorizar descuento" Command="{Binding AuthorizeCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanAuthorize}"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
    <StackPanel Style="{StaticResource CommerceDetail}" Tag="{Binding HasConfirmedSale}" MaxWidth="720" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Border Style="{StaticResource CommerceAvatar}" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Venta registrada correctamente" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" TextAlignment="Center"/>
      <TextBlock Text="La venta y sus pagos quedaron confirmados." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,20"/>
      <Border Style="{StaticResource SoftPanel}">
        <UniformGrid Columns="2" Margin="0,0,-16,0">
          <ContentControl Style="{StaticResource CommerceField}" Tag="Comprobante interno" Content="{Binding ConfirmedSale.Sale.Number}"/>
          <ContentControl Style="{StaticResource CommerceField}" Tag="Cliente" Content="{Binding ConfirmedSale.Sale, Converter={StaticResource SaleCustomerName}}"/>
          <ContentControl Style="{StaticResource CommerceField}" Tag="Saldo pendiente" Content="{Binding ConfirmedSale.Sale.Pending, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
          <ContentControl Style="{StaticResource CommerceField}" Tag="Fecha" Content="{Binding ConfirmedSale.Sale.Date}" ContentStringFormat="{}{0:dd/MM/yyyy HH:mm}"/>
          <ContentControl Style="{StaticResource CommerceField}" Tag="Total de la venta" Content="{Binding ConfirmedSale.Sale.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
          <ContentControl Style="{StaticResource CommerceField}" Tag="Cambio confirmado" Content="{Binding ConfirmedSale.Sale.Change, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
        </UniformGrid>
      </Border>
      <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
        <Button Content="Ver comprobante" Command="{Binding OpenReceiptCommand, ElementName=PosRoot}" CommandParameter="{Binding ConfirmedSale.Sale}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
        <Button Content="Nueva venta" Command="{Binding NewSaleCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanEdit}"/>
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
