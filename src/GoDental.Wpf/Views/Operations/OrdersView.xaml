<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.OrdersView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <StackPanel Style="{StaticResource CommerceList}" Tag="{Binding IsDetailOpen}">
      <DockPanel Margin="0,0,0,20">
        <Button Content="Nuevo pedido" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanCreate}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Pedidos y entregas" Style="{StaticResource Heading}"/>
          <TextBlock Text="Organiza pedidos, ventas vinculadas y entregas." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <DockPanel Margin="0,0,0,16">
        <Button Content="Consultar pedidos" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Estado del pedido" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" AutomationProperties.Name="Estado del pedido"/>
        </StackPanel>
      </DockPanel>
      <Grid>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="300" AutomationProperties.Name="Items">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Pedido" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource CommerceRowLink}" Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Id, StringFormat=Abrir pedido {0}}">
                    <TextBlock Text="{Binding Id, StringFormat=#{0}}" FontWeight="SemiBold"/>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTemplateColumn Header="Estado" Width="125">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CommerceState}" Tag="{Binding State}">
                    <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Fecha prevista" Binding="{Binding Scheduled, StringFormat=dd/MM/yyyy}" Width="120" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTemplateColumn Header="Pago" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CommerceState}" Tag="{Binding PaymentState}">
                    <TextBlock Text="{Binding PaymentState}" FontSize="11" TextWrapping="NoWrap"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Pendiente USD" Binding="{Binding Pending, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="125" ElementStyle="{StaticResource CommerceNumber}"/>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Items.Count}" Content="No hay pedidos para este estado."/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <Button Content="Ver detalle" Command="{Binding DetailCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Content="‹" Command="{Binding PreviousCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
            <Button Content="›" Command="{Binding NextCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
          </StackPanel>
          <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
      </DockPanel>
    </StackPanel>
    <StackPanel Style="{StaticResource CommerceDetail}" Tag="{Binding IsDetailOpen}">
      <DockPanel Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="16,0,0,0">
          <Button Content="Cambiar estado" Command="{Binding TransitionCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanTransition}" Margin="0,0,8,0"/>
          <Button Content="Pasar al POS" Command="{Binding PassToPosCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanPassToPos}"/>
        </StackPanel>
        <Button Content="Volver a pedidos" Tag="" Command="{Binding ReturnToListCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,20">
        <Border Style="{StaticResource CommerceSymbol}" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource CommerceState}" Tag="{Binding Detail.Order.State}" DockPanel.Dock="Right">
          <TextBlock Text="{Binding Detail.Order.State}" FontSize="11"/>
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding Detail.Order.Customer}" Style="{StaticResource Heading}"/>
          <TextBlock Text="{Binding Detail.Order.Id, StringFormat=Pedido #{0}}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <DockPanel Margin="0,0,0,16">
        <Button Content="" Command="{Binding DetailCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Actualizar pedido" AutomationProperties.Name="Actualizar pedido" DockPanel.Dock="Right"/>
        <TextBlock Text="{Binding Detail.Order.Scheduled, StringFormat=Entrega prevista: {0:dd/MM/yyyy}}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
      <TabControl>
        <TabItem Header="Detalle y entrega" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Información de entrega" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Dirección y contacto conservados al registrar el pedido." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <UniformGrid Columns="2" Margin="0,0,-16,0">
              <ContentControl Style="{StaticResource CommerceField}" Tag="Contacto" Content="{Binding Detail.Order.Contact}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Teléfono" Content="{Binding Detail.Order.Phone}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Responsable" Content="{Binding Detail.Order.Responsible}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Dirección" Content="{Binding Detail.Order.Address}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Departamento" Content="{Binding Detail.Order.Department}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Municipio" Content="{Binding Detail.Order.Municipality}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Referencia" Content="{Binding Detail.Order.Reference}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Entrega registrada" Content="{Binding Detail.Order.Delivered}" ContentStringFormat="{}{0:dd/MM/yyyy HH:mm}"/>
            </UniformGrid>
            <TextBlock Text="Confirma la venta antes de considerar el pedido listo para salir. LISTO no reserva inventario." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <Expander Header="Vincular una venta existente (recuperación)">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Usa este enlace manual sólo si la venta ya se confirmó por otro recorrido." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <Button Content="Vincular venta" Command="{Binding LinkCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanLink}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Expander>
            <DataGrid ItemsSource="{Binding Detail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="200" AutomationProperties.Name="Detail.Lines">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100" ElementStyle="{StaticResource CommerceCell}"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="Venta y cobro" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Venta y cobro" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="El estado del pago procede de la venta vinculada y sus cuentas." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <UniformGrid Columns="2" Margin="0,0,-16,0">
              <ContentControl Style="{StaticResource CommerceField}" Tag="Venta vinculada" Content="{Binding Detail.Order.SaleId}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Estado del pago" Content="{Binding Detail.Order.PaymentState}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Cargo de entrega" Content="{Binding Detail.Order.DeliveryCharge, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Saldo de la venta" Content="{Binding Detail.Order.Pending, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
            </UniformGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="Historial" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Historial del pedido" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Estados y observaciones registrados, en orden de consulta." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <Grid>
              <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="290" AutomationProperties.Name="Events">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="160" ElementStyle="{StaticResource CommerceCell}"/>
                  <DataGridTemplateColumn Header="Estado" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource CommerceState}" Tag="{Binding State}">
                          <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="ID de usuario" Binding="{Binding UserId}" Width="110" ElementStyle="{StaticResource CommerceCell}"/>
                  <DataGridTextColumn Header="Observación" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
                </DataGrid.Columns>
              </DataGrid>
              <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Events.Count}" Content="No hay eventos para este pedido."/>
            </Grid>
            <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="‹" Command="{Binding PreviousEventsCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
                <Button Content="›" Command="{Binding NextEventsCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
              </StackPanel>
              <TextBlock Text="{Binding EventsPageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </StackPanel>
</UserControl>
