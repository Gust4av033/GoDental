<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.OrdersView">

<StackPanel><TextBlock Text="PEDIDOS Y ENTREGAS" Style="{StaticResource PageEyebrow}" /><TextBlock Text="Seguimiento de pedidos" Style="{StaticResource Heading}" /><TextBlock Text="Conserva dirección y contacto de entrega, vincula una venta y registra cada cambio de estado." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/><local:OperationStatusView DataContext="{Binding Operation}"/><WrapPanel><StackPanel Width="220" Margin="0,0,16,12"><TextBlock Text="Estado" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="" AutomationProperties.Name="Estado"/></StackPanel><Button Content="Actualizar" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Nuevo pedido" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanCreate}"/></WrapPanel><TabControl><TabItem Header="Listado"><StackPanel><DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="260" AutomationProperties.Name="Items" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="125"/><DataGridTextColumn Header="Previsto" Binding="{Binding Scheduled}" Width="130"/><DataGridTextColumn Header="Pago" Binding="{Binding PaymentState}" Width="120"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Anterior" Command="{Binding PreviousCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Consultar detalle" Command="{Binding DetailCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></TabItem><TabItem Header="Detalle y entrega"><StackPanel><TextBlock Text="{Binding Detail.Order.Customer}" Style="{StaticResource SectionHeading}" /><TextBlock Text="{Binding Detail.Order.Id, StringFormat=Pedido: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.Contact, StringFormat=Contacto: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.Phone, StringFormat=Teléfono: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.Address, StringFormat=Dirección: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.Responsible, StringFormat=Responsable: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.State, StringFormat=Estado: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.SaleId, StringFormat=Venta vinculada: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.PaymentState, StringFormat=Pago: {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.Pending, StringFormat=Saldo de la venta: {0:N2}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Detail.Order.Delivered, StringFormat=Entregado: {0}}" Style="{StaticResource MutedText}" /><WrapPanel Margin="0,12,0,4"><Button Content="Vincular venta" Command="{Binding LinkCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanLink}"/><Button Content="Cambiar estado" Command="{Binding TransitionCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanTransition}"/></WrapPanel><DataGrid ItemsSource="{Binding Detail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="180" AutomationProperties.Name="Detail.Lines"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/></DataGrid.Columns></DataGrid><TextBlock Text="Historial del pedido" Style="{StaticResource SectionHeading}" Margin="0,16,0,12"/><DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="180" AutomationProperties.Name="Events"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="155"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Usuario" Binding="{Binding UserId}" Width="90"/><DataGridTextColumn Header="Observación" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Anterior" Command="{Binding PreviousEventsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextEventsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></TabItem></TabControl></StackPanel>
</UserControl>
