<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.OrdersView">
  <StackPanel>
    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Tag="&#xE710;" Content="Nuevo pedido" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryActionButton}" Margin="12,0,0,0" IsEnabled="{Binding CanCreate}"/><TextBlock Text="Seguimiento de pedidos" Style="{StaticResource Heading}"/></DockPanel>
    <TextBlock Text="Conserva dirección y contacto de entrega, vincula una venta y registra cada cambio de estado." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <WrapPanel>
      <StackPanel Width="220" Margin="0,0,16,12">
        <TextBlock Text="Estado" Margin="0,0,0,6"/>
        <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="" AutomationProperties.Name="Estado"/>
      </StackPanel>
      <Button Tag="&#xE72C;" Content="Actualizar" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>

    </WrapPanel>
    <TabControl>
      <TabItem Header="Listado">
        <StackPanel>
          <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="260" AutomationProperties.Name="Items" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
              <DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*"/>
              <DataGridTemplateColumn Header="Estado" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StateBadge}" Tag="{Binding State}"><TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Previsto" Binding="{Binding Scheduled, StringFormat=dd/MM/yyyy}" Width="130"/>
              <DataGridTextColumn Header="Pago" Binding="{Binding PaymentState}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,12,0,4">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
            <Button Content="Consultar detalle" Command="{Binding DetailCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Detalle y entrega">
        <StackPanel>
          <TextBlock Text="{Binding Detail.Order.Customer}" Style="{StaticResource SectionHeading}"/>
          <TextBlock Text="{Binding Detail.Order.Id, StringFormat=Pedido: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.Contact, StringFormat=Contacto: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.Phone, StringFormat=Teléfono: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.Address, StringFormat=Dirección: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.Responsible, StringFormat=Responsable: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.State, StringFormat=Estado: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.SaleId, StringFormat=Venta vinculada: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.PaymentState, StringFormat=Pago: {0}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.Pending, StringFormat=Saldo de la venta: {0:N2}}" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Detail.Order.Delivered, StringFormat=Entregado: {0}}" Style="{StaticResource MutedText}"/>
          <WrapPanel Margin="0,12,0,4">
            <Button Content="Vincular venta" Command="{Binding LinkCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanLink}"/>
            <Button Content="Cambiar estado" Command="{Binding TransitionCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanTransition}"/>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Detail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="180" AutomationProperties.Name="Detail.Lines">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
              <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Historial del pedido" Style="{StaticResource SectionHeading}" Margin="0,16,0,12"/>
          <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="180" AutomationProperties.Name="Events">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/>
              <DataGridTemplateColumn Header="Estado" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StateBadge}" Tag="{Binding State}"><TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Usuario" Binding="{Binding UserId}" Width="90"/>
              <DataGridTextColumn Header="Observación" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,12,0,4">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousEventsCommand}" Margin="0,0,8,8"/>
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextEventsCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
