<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.MvpFormView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate xmlns:vm="clr-namespace:GoDental.Wpf.ViewModels.Operations" DataType="{x:Type vm:CustomerLookupModel}">
        <local:CustomerLookupView/>
      </DataTemplate>
      <DataTemplate xmlns:vm="clr-namespace:GoDental.Wpf.ViewModels.Operations" DataType="{x:Type vm:CheckoutModel}">
        <local:CheckoutView/>
      </DataTemplate>
      <DataTemplate xmlns:vm="clr-namespace:GoDental.Wpf.ViewModels.Operations" DataType="{x:Type vm:PurchaseOrderDraftModel}"><local:PurchaseOrderDraftView/></DataTemplate>
      <DataTemplate xmlns:vm="clr-namespace:GoDental.Wpf.ViewModels.Operations" DataType="{x:Type vm:ImportCostDraftModel}"><local:ImportCostDraftView/></DataTemplate>
      <DataTemplate xmlns:vm="clr-namespace:GoDental.Wpf.ViewModels.Operations" DataType="{x:Type vm:PurchaseReceiptDraftModel}"><local:PurchaseReceiptDraftView/></DataTemplate>
      <DataTemplate xmlns:vm="clr-namespace:GoDental.Wpf.ViewModels.Operations" DataType="{x:Type vm:OrderDraftModel}">
        <local:OrderDraftView/>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <StackPanel IsEnabled="{Binding CanEdit}">
      <ContentControl Content="{Binding Body}" Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16"/>
      <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommerceTextInput}" MaxLength="500" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/>
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="{Binding DisplayMember}" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/>
              <DatePicker SelectedDate="{Binding Date}" Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Border Style="{StaticResource SoftPanel}" IsEnabled="{Binding CanEnterSecret}" Visibility="{Binding SecretRequired, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Autorización administrativa" Style="{StaticResource SectionHeading}"/>
        <TextBlock Text="Contraseña del administrador" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Secret" MaxLength="128" AutomationProperties.Name="Contraseña de autorización administrativa"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
