<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:GoDental.Wpf.ViewModels.Operations" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.MvpFormView">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type vm:CustomerLookupModel}">
      <local:CustomerLookupView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CheckoutModel}">
      <local:CheckoutView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:OrderDraftModel}">
      <local:OrderDraftView/>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <TabControl IsEnabled="{Binding CanEdit}">
      <TabItem Header="Datos" IsSelected="{Binding ShowFieldsFirst, Mode=OneTime}">
        <StackPanel Margin="0,16,0,0">
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="300" Margin="0,0,20,16">
                  <TextBlock Text="{Binding Label}" Margin="0,0,0,6"/>
                  <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/>
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="{Binding DisplayMember}" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/>
                  <DatePicker SelectedDate="{Binding Date}" Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </TabItem>
      <TabItem Header="Selección y detalle" Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" IsSelected="{Binding HasBody, Mode=OneTime}">
        <ContentControl Content="{Binding Body}" Margin="0,16,0,0"/>
      </TabItem>
    </TabControl>
    <StackPanel IsEnabled="{Binding CanEnterSecret}" Visibility="{Binding SecretRequired, Converter={StaticResource BoolToVisibility}}">
      <Label Content="Contraseña del administrador" Target="{Binding ElementName=Secret}"/>
      <PasswordBox x:Name="Secret" MaxLength="128" AutomationProperties.Name="Contraseña de autorización administrativa"/>
    </StackPanel>
    <CheckBox Content="Revisé los datos y confirmo esta acción" IsChecked="{Binding Confirmed}" IsEnabled="{Binding CanEdit}" Margin="0,20,0,12" AutomationProperties.Name="Confirmar la operación"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
  </StackPanel>
</UserControl>
