<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CashView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <ProgressBar Style="{StaticResource InlineLoadingIndicator}" Height="3" IsIndeterminate="True"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <DockPanel Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="16,0,0,0">
        <Button Content="Abrir caja" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" Margin="0,0,8,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasOpenShift}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="Movimiento" Command="{Binding MoveCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanMove}" Margin="0,0,8,0"/>
        <Button Content="Cerrar caja" Command="{Binding CloseCommand}" IsEnabled="{Binding CanClose}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource DestructiveActionButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasOpenShift}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Caja y turnos" Style="{StaticResource Heading}"/>
        <TextBlock Text="Apertura, movimientos y cierre de efectivo." Style="{StaticResource MutedText}"/>
      </StackPanel>
    </DockPanel>
    <DockPanel Margin="0,0,0,16" IsEnabled="{Binding IsNotBusy}">
      <Button Content="" Command="{Binding ReloadCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Actualizar cajas" AutomationProperties.Name="Actualizar cajas" DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <Button Content="Turno actual" Command="{Binding LoadShiftCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
      <StackPanel>
        <TextBlock Text="Caja de operación" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding Box}" DisplayMemberPath="Name" AutomationProperties.Name="Caja"/>
      </StackPanel>
    </DockPanel>
    <WrapPanel Margin="0,0,0,16">
      <Expander Header="Consultar turno anterior" Margin="0,0,24,0">
        <DockPanel Margin="0,12,0,0">
          <Button Content="Buscar turno" Command="{Binding FindShiftCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox Text="{Binding ShiftLookup, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Consultar turno por número" Width="150"/>
        </DockPanel>
      </Expander>
      <Expander Header="Administrar cajas" IsEnabled="{Binding CanManageBoxes}">
        <WrapPanel Margin="0,12,0,0">
          <Button Content="Nueva caja" Command="{Binding NewBoxCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanManageBoxes}" Margin="0,0,8,0"/>
          <Button Content="Editar caja" Command="{Binding UpdateBoxCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanManageBoxes}"/>
        </WrapPanel>
      </Expander>
    </WrapPanel>
    <DockPanel Margin="0,0,0,16">
      <Border Style="{StaticResource CommerceState}" Tag="{Binding Shift.State}" DockPanel.Dock="Right">
        <TextBlock Text="{Binding Shift.State}" FontSize="11"/>
      </Border>
      <StackPanel>
        <TextBlock Text="{Binding ShiftLabel}" Style="{StaticResource SectionHeading}"/>
        <TextBlock Text="{Binding Shift.Opened, StringFormat=Apertura: {0:dd/MM/yyyy HH:mm}}" Style="{StaticResource MutedText}"/>
      </StackPanel>
    </DockPanel>
    <TabControl>
      <TabItem Header="Resumen" Style="{StaticResource CommerceTab}">
        <StackPanel Margin="0,16,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Resumen del turno" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Importes de efectivo calculados por el servicio de caja." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <UniformGrid Columns="2" Margin="0,0,-12,16">
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Fondo de apertura" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Shift.Opening, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Efectivo esperado" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Shift.Expected, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <UniformGrid Columns="2" Margin="0,0,-12,16">
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Efectivo contado" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Shift.Counted, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource SuccessBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Diferencia al cierre" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Shift.Difference, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource DangerBrush}"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <ContentControl Style="{StaticResource CommerceField}" Tag="Cierre del turno" Content="{Binding Shift.Closed}" ContentStringFormat="{}{0:dd/MM/yyyy HH:mm}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Movimientos" Style="{StaticResource CommerceTab}">
        <StackPanel Margin="0,16,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Movimientos del turno" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Ingresos y retiros registrados, con su motivo." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <Grid>
            <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="290" AutomationProperties.Name="Movements">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="160" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTemplateColumn Header="Tipo" Width="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource CommerceState}" Tag="{Binding Type}">
                        <TextBlock Text="{Binding Type}" FontSize="11" TextWrapping="NoWrap"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Importe USD" Binding="{Binding Amount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="130" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
              </DataGrid.Columns>
            </DataGrid>
            <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Movements.Count}" Content="No hay movimientos para este turno."/>
          </Grid>
          <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button Content="‹" Command="{Binding PreviousCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
              <Button Content="›" Command="{Binding NextCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
            </StackPanel>
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
