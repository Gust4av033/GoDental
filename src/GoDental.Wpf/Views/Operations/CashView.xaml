<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CashView">
  <StackPanel>
    <TextBlock Text="Control de caja" Style="{StaticResource Heading}"/>
    <TextBlock Text="Consulta un turno, registra sus movimientos y realiza el arqueo al cerrar." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><StackPanel>
      <WrapPanel VerticalAlignment="Center">
        <StackPanel Width="210" Margin="0,0,12,8"><TextBlock Text="Caja" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding Box}" DisplayMemberPath="Name" AutomationProperties.Name="Caja"/></StackPanel>
        <StackPanel Width="145" Margin="0,0,12,8"><TextBlock Text="Número de turno" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><TextBox Text="{Binding ShiftLookup, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Consultar turno por número"/></StackPanel>
        <Button Content="Buscar" Tag="&#xE721;" Command="{Binding FindShiftCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
        <Button Content="Turno actual" Command="{Binding LoadShiftCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
        <Button Content="Actualizar" Tag="&#xE72C;" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
      </WrapPanel>
      <WrapPanel><Button Content="Nueva caja" Tag="&#xE710;" Command="{Binding NewBoxCommand}" Style="{StaticResource TextButton}" IsEnabled="{Binding CanManageBoxes}" Margin="0,0,20,0"/><Button Content="Editar caja" Tag="&#xE70F;" Command="{Binding UpdateBoxCommand}" Style="{StaticResource TextButton}" IsEnabled="{Binding CanManageBoxes}"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel Margin="0,0,0,12">        <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
          <Button Content="Abrir caja" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" IsEnabled="{Binding CanOpen}"/>
          <Button Content="Movimiento" Command="{Binding MoveCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0" IsEnabled="{Binding CanMove}"/>
          <Button Content="Cerrar caja" Command="{Binding CloseCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0" IsEnabled="{Binding CanClose}"/>
        </WrapPanel><TextBlock Text="{Binding ShiftLabel}" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/></DockPanel>
        <UniformGrid Columns="3">
          <Border Background="{DynamicResource TintBrush}" CornerRadius="4" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Fondo de apertura" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Shift.Opening, StringFormat={}{0:N2}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
          <Border Background="{DynamicResource TintBrush}" CornerRadius="4" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Efectivo esperado" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Shift.Expected, StringFormat={}{0:N2}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
          <Border Background="{DynamicResource TintBrush}" CornerRadius="4" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Diferencia al cierre" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Shift.Difference, StringFormat={}{0:N2}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Movimientos del turno" Style="{StaticResource SectionHeading}"/>
        <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="170" AutomationProperties.Name="Movements">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/>
            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="130"/>
            <DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,12,0,4">
          <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
          <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
