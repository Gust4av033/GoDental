<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CashView">

<StackPanel><TextBlock Text="CAJA Y COBROS" Style="{StaticResource PageEyebrow}" /><TextBlock Text="Control de caja" Style="{StaticResource Heading}" /><TextBlock Text="Consulta un turno, registra sus movimientos y realiza el arqueo al cerrar." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/><local:OperationStatusView DataContext="{Binding Operation}"/><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><WrapPanel><StackPanel Width="260" Margin="0,0,16,12"><TextBlock Text="Caja" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding Box}" DisplayMemberPath="Name" AutomationProperties.Name="Caja"/></StackPanel><StackPanel Width="190" Margin="0,0,16,12"><TextBlock Text="Consultar turno por número" Margin="0,0,0,6"/><TextBox Text="{Binding ShiftLookup, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Consultar turno por número"/></StackPanel></WrapPanel><WrapPanel Margin="0,12,0,4"><Button Content="Actualizar" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Turno actual" Command="{Binding LoadShiftCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Buscar turno" Command="{Binding FindShiftCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel><WrapPanel Margin="0,12,0,4"><Button Content="Nueva caja" Command="{Binding NewBoxCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanManageBoxes}"/><Button Content="Editar caja" Command="{Binding UpdateBoxCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanManageBoxes}"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding ShiftLabel}" Style="{StaticResource SectionHeading}" /><WrapPanel><StackPanel Width="200"><TextBlock Text="Apertura" Style="{StaticResource PageEyebrow}" /><TextBlock Text="{Binding Shift.Opening, StringFormat={}{0:N2}}" Style="{StaticResource MetricValue}" /></StackPanel><StackPanel Width="200"><TextBlock Text="Efectivo esperado" Style="{StaticResource PageEyebrow}" /><TextBlock Text="{Binding Shift.Expected, StringFormat={}{0:N2}}" Style="{StaticResource MetricValue}" /></StackPanel><StackPanel Width="180"><TextBlock Text="Diferencia al cierre" Style="{StaticResource PageEyebrow}" /><TextBlock Text="{Binding Shift.Difference, StringFormat={}{0:N2}}" Style="{StaticResource MetricValue}" /></StackPanel></WrapPanel><WrapPanel Margin="0,12,0,4"><Button Content="Abrir caja" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanOpen}"/><Button Content="Movimiento" Command="{Binding MoveCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanMove}"/><Button Content="Cerrar caja" Command="{Binding CloseCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanClose}"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Movimientos del turno" Style="{StaticResource SectionHeading}" /><DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="240" AutomationProperties.Name="Movements"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="155"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="130"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="120"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Anterior" Command="{Binding PreviousCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border></StackPanel>
</UserControl>
