<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.OperationStatusView">
  <StackPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="Resultado pendiente de confirmar" Style="{StaticResource SectionHeading}"/>
        <TextBlock Text="{Binding OperationId}" TextWrapping="Wrap" AutomationProperties.Name="Identificador de la operación pendiente"/>
        <TextBlock Text="Conservamos la solicitud original. Consultar no vuelve a registrar la operación; reenviar envía exactamente la misma solicitud." Style="{StaticResource MutedText}"/>
        <WrapPanel Margin="0,12,0,0">
          <Button Content="Consultar estado" Command="{Binding CheckCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanResolve}" Margin="0,0,8,8"/>
          <Button Content="Reenviar solicitud" Command="{Binding RetryCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanResolve}" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
