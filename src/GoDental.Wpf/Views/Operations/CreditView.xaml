<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CreditView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <StackPanel Style="{StaticResource CommerceList}" Tag="{Binding IsDetailOpen}">
      <DockPanel Margin="0,0,0,20">
        <Button Content="Registrar abono" Command="{Binding PayCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanPay}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Crédito y abonos" Style="{StaticResource Heading}"/>
          <TextBlock Text="Consulta cuentas pendientes y registra pagos parciales." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <DockPanel Margin="0,0,0,16">
        <Button Content="Consultar cuentas" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right"/>
        <CheckBox Content="Sólo cuentas vencidas" IsChecked="{Binding OverdueOnly}" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="300" AutomationProperties.Name="Items">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Cuenta" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTemplateColumn Header="Cliente" Width="*" MinWidth="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource CommerceRowLink}" Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="{Binding Customer}" AutomationProperties.Name="{Binding Customer}">
                    <DockPanel>
                      <Border Style="{StaticResource CommerceAvatar}" Width="28" Height="28" DockPanel.Dock="Left" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Customer, Converter={StaticResource CommerceInitials}}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="{Binding Customer}" Style="{StaticResource CommerceCell}"/>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Venta" Binding="{Binding Sale}" Width="120" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTextColumn Header="Vence" Binding="{Binding Due, StringFormat=dd/MM/yyyy}" Width="110" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTextColumn Header="Saldo USD" Binding="{Binding Balance, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="125" ElementStyle="{StaticResource CommerceNumber}"/>
            <DataGridTemplateColumn Header="Estado" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CommerceState}" Tag="{Binding State}">
                    <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Items.Count}" Content="No hay cuentas para este filtro."/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <Button Content="Ver cuenta" Command="{Binding OpenSelectedCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Content="‹" Command="{Binding PreviousCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
            <Button Content="›" Command="{Binding NextCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
          </StackPanel>
          <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
      </DockPanel>
    </StackPanel>
    <StackPanel Style="{StaticResource CommerceDetail}" Tag="{Binding IsDetailOpen}">
      <DockPanel Margin="0,0,0,16">
        <Button Content="Registrar abono" Command="{Binding PayCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanPay}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <Button Content="" Command="{Binding RefreshAccountCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Actualizar cuenta" AutomationProperties.Name="Actualizar cuenta" DockPanel.Dock="Right"/>
        <Button Content="Volver a cuentas" Tag="" Command="{Binding ReturnToListCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,20">
        <Border Style="{StaticResource CommerceAvatar}" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock Text="{Binding Selected.Customer, Converter={StaticResource CommerceInitials}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource CommerceState}" Tag="{Binding Selected.State}" DockPanel.Dock="Right">
          <TextBlock Text="{Binding Selected.State}" FontSize="11"/>
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding Selected.Customer}" Style="{StaticResource Heading}"/>
          <TextBlock Text="{Binding Selected.Sale, StringFormat=Venta: {0}}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <UniformGrid Columns="3" Margin="0,0,-12,20">
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Importe original" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Selected.Original, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Saldo de esta cuenta" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Selected.Balance, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource DangerBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Vencimiento" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Selected.Due, StringFormat=dd/MM/yyyy}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <TabControl>
        <TabItem Header="Cuenta y saldos" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Cuenta seleccionada" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="El abono se aplica a esta cuenta, con la versión consultada." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <UniformGrid Columns="2" Margin="0,0,-16,0">
              <ContentControl Style="{StaticResource CommerceField}" Tag="Número de cuenta" Content="{Binding Selected.Id}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Venta de origen" Content="{Binding Selected.Sale}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Próximo aviso" Content="{Binding Selected.NextNotice}" ContentStringFormat="{}{0:dd/MM/yyyy}"/>
            </UniformGrid>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Saldos del cliente" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Estos importes agrupan las cuentas del cliente." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <UniformGrid Columns="3" Margin="0,0,-12,0">
              <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="Saldo utilizado" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding Balance.Outstanding, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="Vencido" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding Balance.Overdue, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="Disponible nominal" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding Balance.Available, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="Abonos del cliente" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Abonos del cliente" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Historial de todas sus cuentas. La columna Cuenta identifica cada aplicación." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <Grid>
              <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="270" AutomationProperties.Name="Payments">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="155" ElementStyle="{StaticResource CommerceCell}"/>
                  <DataGridTextColumn Header="Recibo" Binding="{Binding Receipt}" Width="130" ElementStyle="{StaticResource CommerceCell}"/>
                  <DataGridTextColumn Header="Cuenta" Binding="{Binding AccountId}" Width="75" ElementStyle="{StaticResource CommerceCell}"/>
                  <DataGridTextColumn Header="Forma" Binding="{Binding Method}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
                  <DataGridTextColumn Header="Importe USD" Binding="{Binding Amount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="120" ElementStyle="{StaticResource CommerceNumber}"/>
                  <DataGridTemplateColumn Header="Anulado" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ContentControl Content="{Binding Voided}" ContentTemplate="{StaticResource CommerceYesNo}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Payments.Count}" Content="El cliente no tiene abonos registrados."/>
            </Grid>
            <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="‹" Command="{Binding PreviousHistoryCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
                <Button Content="›" Command="{Binding NextHistoryCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
              </StackPanel>
              <TextBlock Text="{Binding HistoryPageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </StackPanel>
</UserControl>
