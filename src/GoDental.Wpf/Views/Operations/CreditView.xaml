<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CreditView">

<StackPanel><TextBlock Text="CRÉDITO" Style="{StaticResource PageEyebrow}" /><TextBlock Text="Cuentas y abonos" Style="{StaticResource Heading}" /><TextBlock Text="Consulta saldos y vencimientos. Los abonos se registran con la versión de la cuenta seleccionada." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/><local:OperationStatusView DataContext="{Binding Operation}"/><WrapPanel Margin="0,12,0,4"><CheckBox Content="Sólo vencidas" IsChecked="{Binding OverdueOnly}" VerticalAlignment="Center" Margin="0,0,20,8"/><Button Content="Actualizar" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Registrar abono" Command="{Binding PayCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanPay}"/><Button Content="Historial del cliente" Command="{Binding HistoryCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="230" AutomationProperties.Name="Items" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*"/><DataGridTextColumn Header="Venta" Binding="{Binding Sale}" Width="120"/><DataGridTextColumn Header="Vence" Binding="{Binding Due}" Width="130"/><DataGridTextColumn Header="Saldo" Binding="{Binding Balance}" Width="110"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Anterior" Command="{Binding PreviousCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Abonos del cliente seleccionado" Style="{StaticResource SectionHeading}" /><DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="200" AutomationProperties.Name="Payments"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Recibo" Binding="{Binding Receipt}" Width="130"/><DataGridTextColumn Header="Forma" Binding="{Binding Method}" Width="130"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="100"/><DataGridTextColumn Header="Anulado" Binding="{Binding Voided}" Width="80"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Anterior" Command="{Binding PreviousHistoryCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextHistoryCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border></StackPanel>
</UserControl>
