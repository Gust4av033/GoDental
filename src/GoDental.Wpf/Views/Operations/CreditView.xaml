<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CreditView">
  <StackPanel>
    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="Registrar abono" Command="{Binding PayCommand}" Style="{StaticResource PrimaryActionButton}" Margin="12,0,0,0" IsEnabled="{Binding CanPay}"/><TextBlock Text="Cuentas y abonos" Style="{StaticResource Heading}"/></DockPanel>
    <TextBlock Text="Consulta saldos y vencimientos. Los abonos se registran con la versión de la cuenta seleccionada." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <WrapPanel Margin="0,12,0,4">
      <CheckBox Content="Sólo vencidas" IsChecked="{Binding OverdueOnly}" VerticalAlignment="Center" Margin="0,0,20,8"/>
      <Button Tag="&#xE72C;" Content="Actualizar" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>

      <Button Content="Historial del cliente" Command="{Binding HistoryCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
    </WrapPanel>
    <Border Style="{StaticResource CreditSelectionPanel}" Margin="0,0,0,16">
      <StackPanel><DockPanel Margin="0,0,0,12"><Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" Tag="{Binding Selected.State}"><TextBlock Text="{Binding Selected.State}"/></Border><TextBlock Text="{Binding Selected.Customer}" Style="{StaticResource SectionHeading}"/></DockPanel>
        <UniformGrid Columns="3">
          <StackPanel><TextBlock Text="Importe original" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Selected.Original, Converter={StaticResource UsdMoney}}" Style="{StaticResource SectionHeading}"/></StackPanel>
          <StackPanel><TextBlock Text="Saldo de esta cuenta" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Selected.Balance, Converter={StaticResource UsdMoney}}" Foreground="{DynamicResource DangerBrush}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
          <StackPanel><TextBlock Text="Vencimiento" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Selected.Due, StringFormat=dd/MM/yyyy}" Style="{StaticResource SectionHeading}"/></StackPanel>
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="230" AutomationProperties.Name="Items" SelectedItem="{Binding Selected}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
            <DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*"/>
            <DataGridTextColumn Header="Venta" Binding="{Binding Sale}" Width="120"/>
            <DataGridTextColumn Header="Vence" Binding="{Binding Due, StringFormat=dd/MM/yyyy}" Width="130"/>
            <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, Converter={StaticResource UsdMoney}}" Width="110" ElementStyle="{StaticResource MoneyCellText}"/>
            <DataGridTemplateColumn Header="Estado" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StateBadge}" Tag="{Binding State}"><TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,12,0,4">
          <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
          <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Abonos del cliente seleccionado" Style="{StaticResource SectionHeading}"/>
        <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="200" AutomationProperties.Name="Payments">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
            <DataGridTextColumn Header="Recibo" Binding="{Binding Receipt}" Width="130"/>
            <DataGridTextColumn Header="Forma" Binding="{Binding Method}" Width="130"/>
            <DataGridTextColumn Header="Importe" Binding="{Binding Amount, Converter={StaticResource UsdMoney}}" Width="100" ElementStyle="{StaticResource MoneyCellText}"/>
            <DataGridTextColumn Header="Anulado" Binding="{Binding Voided}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,12,0,4">
          <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousHistoryCommand}" Margin="0,0,8,8"/>
          <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextHistoryCommand}" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
