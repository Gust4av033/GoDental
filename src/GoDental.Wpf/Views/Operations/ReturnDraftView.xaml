<UserControl x:Class="GoDental.Wpf.Views.Operations.ReturnDraftView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy,Converter={StaticResource BoolToVisibility}}"/>
  <ListBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Líneas de devolución">
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6">
    <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Style="{StaticResource FieldLabel}"/>
    <WrapPanel IsEnabled="{Binding Editable}">
     <StackPanel Width="120" Margin="0,0,12,0"><TextBlock Text="Cantidad"/><TextBox Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad a devolver"/></StackPanel>
     <StackPanel Width="200" Margin="0,0,12,0"><TextBlock Text="Condición"/><ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" AutomationProperties.Name="Condición del producto"/></StackPanel>
     <CheckBox Content="Reingreso vendible" IsChecked="{Binding Restock}" VerticalAlignment="Center"/>
    </WrapPanel>
    <TextBlock Text="Motivo si no reingresa (defecto, daño, cuarentena…)" Margin="0,6,0,0"/>
    <TextBox Text="{Binding NoRestockReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" IsEnabled="{Binding Editable}" AutomationProperties.Name="Motivo de no reingreso"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <WrapPanel Margin="0,12,0,8"><Button Content="Adjuntar fotos a la línea seleccionada" Command="{Binding AttachCommand}" Margin="0,0,12,0"/><Button Content="Quitar foto seleccionada" Command="{Binding RemovePhotoCommand}"/></WrapPanel>
  <ListBox ItemsSource="{Binding SelectedLine.Evidence}" SelectedItem="{Binding SelectedLine.SelectedEvidence}" DisplayMemberPath="Name" MaxHeight="100" AutomationProperties.Name="Fotos adjuntas"/>
 </StackPanel>
</UserControl>
