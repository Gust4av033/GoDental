<UserControl x:Class="GoDental.Wpf.Views.Operations.PurchasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations">
  <StackPanel>
    <DockPanel Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="Nueva orden" Command="{Binding NewCommand}" IsEnabled="{Binding CanCreate}" Style="{StaticResource PrimaryActionButton}" Margin="12,0,0,0"/>
      <StackPanel><TextBlock Text="Compras y recepciones" Style="{StaticResource Heading}"/><TextBlock Text="Órdenes a proveedores y entradas físicas con costo en USD." Style="{StaticResource MutedText}"/></StackPanel>
    </DockPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <StackPanel Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
      <WrapPanel Margin="0,0,0,12"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" MaxLength="200" AutomationProperties.Name="Buscar compra por número o proveedor" Margin="0,0,8,8"/><ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" Width="180" AutomationProperties.Name="Estado de compra" Margin="0,0,8,8"/><Button Content="Actualizar compras" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,8"/></WrapPanel>
      <Border Style="{StaticResource Card}"><StackPanel>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="300" AutomationProperties.Name="Órdenes de compra">
          <DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="140"/><DataGridTextColumn Header="Proveedor" Binding="{Binding Supplier}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="95"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="75"/><DataGridTextColumn Header="Total origen" Binding="{Binding Total, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="150"/></DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,12,0,0"><Button Content="Abrir orden" Command="{Binding OpenCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,8,8"/><Button Content="Anterior" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextCommand}" Margin="0,0,8,8"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/></WrapPanel>
      </StackPanel></Border>
    </StackPanel>
    <StackPanel Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
      <WrapPanel Margin="0,0,0,12"><Button Content="Volver a compras" Command="{Binding BackCommand}" Margin="0,0,8,8"/><Button Content="Actualizar orden" Command="{Binding RefreshDetailCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,8,8"/><Button Content="Editar borrador" Command="{Binding EditOrderCommand}" IsEnabled="{Binding CanEditOrder}" Margin="0,0,8,8"/><Button Content="Cambiar estado" Command="{Binding TransitionCommand}" IsEnabled="{Binding CanTransition}" Margin="0,0,8,8"/><Button Content="Preparar recepción" Command="{Binding PrepareCommand}" IsEnabled="{Binding CanPrepare}" Margin="0,0,0,8"/></WrapPanel>
      <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="{Binding Detail.Order.Number}" Style="{StaticResource SectionHeading}"/>
        <TextBlock Text="{Binding Detail.Order.Supplier}" FontWeight="SemiBold" Margin="0,4,0,4"/>
        <WrapPanel><TextBlock Text="{Binding Detail.Order.State}" Margin="0,0,20,0"/><TextBlock Text="{Binding Detail.Order.Currency}" Margin="0,0,20,0"/><TextBlock Text="{Binding Detail.Order.Total, StringFormat='Total origen: {0:N2}'}"/></WrapPanel>
        <TabControl Margin="0,16,0,0">
          <TabItem Header="Productos y pendientes"><DataGrid ItemsSource="{Binding Detail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="270" AutomationProperties.Name="Pendientes de la orden">
            <DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Ordenado" Binding="{Binding Quantity}" Width="85"/><DataGridTextColumn Header="Recibido" Binding="{Binding Received}" Width="85"/><DataGridTextColumn Header="Pendiente" Binding="{Binding Pending}" Width="85"/><DataGridTextColumn Header="Costo origen" Binding="{Binding UnitCost}" Width="110"/><DataGridTextColumn Header="Desc." Binding="{Binding Discount}" Width="75"/></DataGrid.Columns>
          </DataGrid></TabItem>
          <TabItem Header="Recepciones"><StackPanel>
            <DataGrid ItemsSource="{Binding Detail.Receipts}" SelectedItem="{Binding SelectedReceipt}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="200" AutomationProperties.Name="Recepciones de la orden">
              <DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="140"/><DataGridTextColumn Header="Almacén" Binding="{Binding Warehouse}" Width="*" MinWidth="120"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="100"/><DataGridCheckBoxColumn Header="Costo completo" Binding="{Binding CostsComplete}" Width="110"/><DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="130"/></DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,12,0,12"><Button Content="Consultar recepción" Command="{Binding ReadReceiptCommand}" Margin="0,0,8,8"/><Button Content="Aplicar recepción" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanActOnReceipt}" Margin="0,0,8,8"/><Button Content="Anular borrador" Command="{Binding CancelReceiptCommand}" IsEnabled="{Binding CanActOnReceipt}" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="{Binding ReceiptDetail.Receipt.Number}" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Costos unitarios de recepción en USD. Aplicar ingresa unidades; anular sólo se permite al borrador." Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
            <DataGrid ItemsSource="{Binding ReceiptDetail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" AutomationProperties.Name="Costos y lotes de recepción">
              <DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="80"/><DataGridTextColumn Header="Compra USD" Binding="{Binding PurchaseCostUsd}" Width="100"/><DataGridTextColumn Header="Extra/unidad" Binding="{Binding ExtraUnitCostUsd}" Width="100"/><DataGridTextColumn Header="Puesto bodega" Binding="{Binding LandedUnitCost}" Width="110"/><DataGridTextColumn Header="Gasto total USD" Binding="{Binding ImportExpenseTotalUsd, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Residuo USD" Binding="{Binding ExpenseRoundingUsd}" Width="110"/><DataGridTextColumn Header="Lote" Binding="{Binding LotNumber}" Width="100"/><DataGridTextColumn Header="Vence" Binding="{Binding Expires, StringFormat=dd/MM/yyyy}" Width="95"/></DataGrid.Columns>
            </DataGrid>
          </StackPanel></TabItem>
          <TabItem Header="Importación"><local:ImportationView/></TabItem>
        </TabControl>
      </StackPanel></Border>
    </StackPanel>
  </StackPanel>
</UserControl>
