<UserControl x:Class="GoDental.Wpf.Views.Operations.ImportationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Importación y costo puesto en bodega" Style="{StaticResource SectionHeading}" Margin="0,8,0,4"/>
    <TextBlock Text="Una importación por OC. La logística no ingresa stock. Registra todos los gastos, revisa el reparto y cierra costos antes de preparar la recepción." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <WrapPanel><Button Content="Crear importación" Command="{Binding CreateImportCommand}" IsEnabled="{Binding CanCreateImport}" Margin="0,0,8,8"/><Button Content="Evento / logística" Command="{Binding ImportEventCommand}" IsEnabled="{Binding CanEditImport}" Margin="0,0,8,8"/><Button Content="Registrar gasto" Command="{Binding AddImportExpenseCommand}" IsEnabled="{Binding CanEditImportCosts}" Margin="0,0,8,8"/><Button Content="Cerrar costos" Command="{Binding CloseImportCostsCommand}" IsEnabled="{Binding CanEditImportCosts}" Margin="0,0,0,8"/></WrapPanel>
    <StackPanel Visibility="{Binding HasImportation, Converter={StaticResource BoolToVisibility}}">
      <WrapPanel Margin="0,4,0,12"><TextBlock Text="{Binding Importation.Importation.State}" FontWeight="SemiBold" Margin="0,0,20,0"/><TextBlock Text="{Binding Importation.Importation.Courier, TargetNullValue='Sin courier'}" Margin="0,0,20,0"/><TextBlock Text="{Binding Importation.Importation.Guide, TargetNullValue='Sin guía'}" Margin="0,0,20,0"/><TextBlock Text="{Binding Importation.Importation.ExpectedDate, StringFormat='Estimada: {0:dd/MM/yyyy}'}"/></WrapPanel>
      <WrapPanel Margin="0,0,0,12"><CheckBox IsChecked="{Binding Importation.Importation.CostsClosed, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Content="Costos cerrados" Margin="0,0,20,0"/><TextBlock Text="{Binding Importation.ActiveExpensesUsd, StringFormat='Gastos activos USD: {0:N2}'}" Margin="0,0,20,0"/><TextBlock Text="{Binding Importation.Importation.Rate, StringFormat='Cambio congelado: {0:0.########}'}"/></WrapPanel>
      <TextBlock Text="Gastos (los anulados se conservan)" Style="{StaticResource FieldLabel}"/>
      <DataGrid ItemsSource="{Binding Importation.Expenses}" SelectedItem="{Binding SelectedImportExpense}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" AutomationProperties.Name="Gastos de importación">
        <DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" MinWidth="140"/><DataGridTextColumn Header="Origen" Binding="{Binding Amount, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="70"/><DataGridTextColumn Header="Cambio" Binding="{Binding Rate}" Width="95"/><DataGridTextColumn Header="USD" Binding="{Binding AmountUsd, StringFormat=N2}" Width="95"/><DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Voided}" Width="65"/></DataGrid.Columns>
      </DataGrid>
      <Button Content="Anular gasto" Command="{Binding VoidImportExpenseCommand}" IsEnabled="{Binding CanVoidImportExpense}" HorizontalAlignment="Left" Margin="0,8,0,16"/>
      <TextBlock Text="Presupuesto congelado por producto" Style="{StaticResource FieldLabel}"/>
      <DataGrid ItemsSource="{Binding Detail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="120" AutomationProperties.Name="Presupuesto de importación">
        <DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="140"/><DataGridTextColumn Header="Compra/unidad USD" Binding="{Binding ImportPurchaseCostUsd}" Width="150"/><DataGridTextColumn Header="Gasto total USD" Binding="{Binding ImportExpenseUsd, StringFormat=N2}" Width="130"/><DataGridTextColumn Header="Recibido" Binding="{Binding Received}" Width="90"/><DataGridTextColumn Header="Pendiente" Binding="{Binding Pending}" Width="90"/></DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Eventos manuales · historial inmutable" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
      <DataGrid ItemsSource="{Binding Importation.Events}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" AutomationProperties.Name="Historial de importación">
        <DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/><DataGridTextColumn Header="Evento" Binding="{Binding Type}" Width="140"/><DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="140"/></DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding IsNotBusy}"><Button Content="Anterior" Command="{Binding PreviousImportEventsCommand}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextImportEventsCommand}" Margin="0,0,8,8"/><TextBlock Text="{Binding ImportEventsLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
