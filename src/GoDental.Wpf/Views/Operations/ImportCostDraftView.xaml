<UserControl x:Class="GoDental.Wpf.Views.Operations.ImportCostDraftView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Cambio real de la mercadería · USD por unidad de moneda" Style="{StaticResource FieldLabel}"/>
    <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cambio de cierre de importación" MaxLength="24"/>
    <WrapPanel Margin="0,12,0,12"><Button Content="Calcular reparto" Command="{Binding CalculateCommand}" Margin="0,0,16,0"/><TextBlock Text="{Binding TotalExpensesUsd, StringFormat='Gastos USD: {0:N2}'}" VerticalAlignment="Center"/></WrapPanel>
    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220" AutomationProperties.Name="Revisión de prorrateo por valor neto">
      <DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="*" MinWidth="140"/><DataGridTextColumn Header="Neto origen" Binding="{Binding NetValue, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Compra/unid. USD" Binding="{Binding PurchaseUnitUsd}" Width="130"/><DataGridTextColumn Header="Gasto total USD" Binding="{Binding ExpenseUsd, StringFormat=N2}" Width="115"/><DataGridTextColumn Header="Puesto/unid. USD" Binding="{Binding LandedUnitUsd}" Width="130"/></DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="El gasto total se concilia en centavos. El costo unitario y promedio se conservan a seis decimales; los residuos de conversión se consultan en el detalle de recepción." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
