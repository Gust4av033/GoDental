<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CheckoutView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="220"/>
    </Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="Métodos de pago" Style="{StaticResource SectionHeading}"/>
        <TextBlock Text="Selecciona una forma y agrega el importe que corresponde." Style="{StaticResource MutedText}"/>
      </StackPanel>
      <ListBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Style="{StaticResource CatalogSelector}" ItemContainerStyle="{StaticResource PaymentMethodTile}" ItemTemplate="{StaticResource PaymentMethodCard}" MaxHeight="155" AutomationProperties.Name="Forma de pago"/>
      <UniformGrid Columns="2" Margin="0,12,-16,0">
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Importe aplicado USD" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Importe aplicado"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Efectivo recibido USD" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Efectivo recibido"/>
          <TextBlock Text="Dinero recibido del cliente; se registra aparte del pago aplicado." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Referencia del pago" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Referencia"/>
        </StackPanel>
      </UniformGrid>
      <WrapPanel Margin="0,0,0,12">
        <Button Content="Agregar pago" Command="{Binding AddCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
        <Button Content="Quitar pago" Command="{Binding RemoveCommand}" Style="{StaticResource ActionButton}"/>
      </WrapPanel>
      <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="155" AutomationProperties.Name="Payments">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Forma" Binding="{Binding Method}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
          <DataGridTextColumn Header="Aplicado" Binding="{Binding Amount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="115" ElementStyle="{StaticResource CommerceNumber}"/>
          <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="160" ElementStyle="{StaticResource CommerceCell}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Style="{StaticResource SoftPanel}" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="Resumen del cobro" Style="{StaticResource SectionHeading}" Margin="0,0,0,16"/>
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Subtotal, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
            <TextBlock Text="Subtotal" Style="{StaticResource MutedText}"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Discount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
            <TextBlock Text="Descuento" Style="{StaticResource MutedText}"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Tax, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
            <TextBlock Text="Impuestos" Style="{StaticResource MutedText}"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.Cart.DeliveryCharge, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
            <TextBlock Text="Entrega" Style="{StaticResource MutedText}"/>
          </DockPanel>
          <Border Style="{StaticResource SoftPanel}" Margin="0,8,0,12">
            <StackPanel>
              <TextBlock Text="Total a pagar" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Quote.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Text="Los pagos aplicados deben cubrir exactamente el total. El efectivo recibido se registra por separado." Style="{StaticResource MutedText}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
