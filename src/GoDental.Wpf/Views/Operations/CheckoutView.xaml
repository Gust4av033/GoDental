<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CheckoutView">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0">
    <TextBlock Text="Pagos aplicados" Style="{StaticResource SectionHeading}"/>

    <WrapPanel Margin="0,16,0,0">
      <StackPanel Width="230" Margin="0,0,16,12">
        <TextBlock Text="Forma de pago" Margin="0,0,0,6"/>
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" DisplayMemberPath="Name" AutomationProperties.Name="Forma de pago"/>
      </StackPanel>
      <StackPanel Width="160" Margin="0,0,16,12">
        <TextBlock Text="Importe aplicado" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Importe aplicado"/>
      </StackPanel>
      <StackPanel Width="230" Margin="0,0,16,12">
        <TextBlock Text="Referencia" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Referencia"/>
      </StackPanel>
    </WrapPanel>
    <WrapPanel Margin="0,12,0,4">
      <Button Content="Agregar pago" Command="{Binding AddCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Content="Quitar pago" Command="{Binding RemoveCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
    </WrapPanel>
    <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="150" AutomationProperties.Name="Payments" SelectedItem="{Binding Selected}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Forma" Binding="{Binding Method}" Width="*"/>
        <DataGridTextColumn Header="Aplicado" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130"/>
        <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="200"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Width="220" Margin="0,0,16,12">
      <TextBlock Text="Efectivo recibido" Margin="0,0,0,6"/>
      <TextBox Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Efectivo recibido"/>
    </StackPanel>
    <TextBlock Text="El cambio se confirma al registrar la venta. Utiliza sólo la referencia del pago." Style="{StaticResource MutedText}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
</StackPanel><Border Grid.Column="1" Style="{StaticResource Card}" Background="{DynamicResource TintBrush}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Total a pagar" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding Quote.Total, StringFormat={}{0:N2}}" Style="{StaticResource MetricValue}" Margin="0,8,0,16"/><TextBlock Text="Revisa los pagos aplicados antes de confirmar." Style="{StaticResource MutedText}"/></StackPanel></Border></Grid></UserControl>
