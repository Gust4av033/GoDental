<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.QuotationsView">

<StackPanel><TextBlock Text="VENTAS" Style="{StaticResource PageEyebrow}" /><TextBlock Text="Cotizaciones" Style="{StaticResource Heading}" /><TextBlock Text="Consulta lo emitido y recupera su carrito en POS. La conversión recalcula precios y disponibilidad." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/><local:OperationStatusView DataContext="{Binding Operation}"/><WrapPanel Margin="0,12,0,4"><Button Content="Actualizar" Command="{Binding ReloadQuotationsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Ver detalle" Command="{Binding ReadQuotationCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Llevar al POS" Command="{Binding ConvertCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanConvert}"/></WrapPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><DataGrid ItemsSource="{Binding Quotations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="250" AutomationProperties.Name="Quotations" SelectedItem="{Binding SelectedQuotation}"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Vigencia" Binding="{Binding ValidUntil}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="125"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,4"><Button Content="Anterior" Command="{Binding PreviousQuotationsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Siguiente" Command="{Binding NextQuotationsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Cálculo emitido" Style="{StaticResource SectionHeading}" /><TextBlock Text="{Binding QuotationDetail.Total, StringFormat=Total: {0:N2}}" Style="{StaticResource MetricValue}" /><DataGrid ItemsSource="{Binding QuotationDetail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="210" AutomationProperties.Name="QuotationDetail.Lines"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="115"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="Impuesto" Binding="{Binding Tax}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel>
</UserControl>
