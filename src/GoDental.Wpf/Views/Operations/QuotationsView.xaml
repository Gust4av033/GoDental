<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.QuotationsView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <ProgressBar Style="{StaticResource InlineLoadingIndicator}" Height="3" IsIndeterminate="True"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <StackPanel Style="{StaticResource CommerceList}" Tag="{Binding IsQuotationDetailOpen}">
      <DockPanel Margin="0,0,0,20">
        <Button Content="Actualizar" Command="{Binding ReloadQuotationsCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Cotizaciones" Style="{StaticResource Heading}"/>
          <TextBlock Text="Consulta lo emitido y recupera su carrito en el punto de venta." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <Grid>
        <DataGrid ItemsSource="{Binding Quotations}" SelectedItem="{Binding SelectedQuotation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="300" AutomationProperties.Name="Quotations">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTemplateColumn Header="Número" Width="*" MinWidth="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource CommerceRowLink}" Command="{Binding DataContext.OpenQuotationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Number}">
                    <TextBlock Text="{Binding Number}" Style="{StaticResource CommerceCell}" FontWeight="SemiBold"/>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="160" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTextColumn Header="Vigencia" Binding="{Binding ValidUntil, StringFormat=dd/MM/yyyy}" Width="110" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTemplateColumn Header="Estado" Width="125">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CommerceState}" Tag="{Binding State}">
                    <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="115" ElementStyle="{StaticResource CommerceNumber}"/>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Quotations.Count}" Content="No hay cotizaciones emitidas."/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <Button Content="Ver detalle" Command="{Binding ReadQuotationCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanOpenSelectedQuotation}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Content="‹" Command="{Binding PreviousQuotationsCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
            <Button Content="›" Command="{Binding NextQuotationsCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
          </StackPanel>
          <TextBlock Text="{Binding QuotationsPageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
      </DockPanel>
    </StackPanel>
    <StackPanel Style="{StaticResource CommerceDetail}" Tag="{Binding IsQuotationDetailOpen}">
      <DockPanel Margin="0,0,0,16">
        <Button Content="Llevar al POS" Command="{Binding ConvertCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanConvert}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <Button Content="" Command="{Binding ReadQuotationCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Actualizar detalle" AutomationProperties.Name="Actualizar detalle" DockPanel.Dock="Right"/>
        <Button Content="Volver a cotizaciones" Tag="" Command="{Binding ReturnToQuotationsCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,20">
        <Border Style="{StaticResource CommerceSymbol}" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="{Binding QuotationRecord.Number}" Style="{StaticResource Heading}" Margin="0,0,12,4"/>
            <Border Style="{StaticResource CommerceState}" Tag="{Binding QuotationRecord.State}">
              <TextBlock Text="{Binding QuotationRecord.State}" FontSize="11"/>
            </Border>
          </WrapPanel>
          <TextBlock Text="Cotización emitida · Precios sujetos a revisión al convertir" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <UniformGrid Columns="3" Margin="0,0,-12,20">
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding QuotationRecord.Date, StringFormat=dd/MM/yyyy}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Total" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding QuotationRecord.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Vigencia" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding QuotationRecord.ValidUntil, StringFormat=dd/MM/yyyy}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <TabControl>
        <TabItem Header="Productos" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <DataGrid ItemsSource="{Binding QuotationDetail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="280" AutomationProperties.Name="QuotationDetail.Lines">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="80" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Descuento" Binding="{Binding Discount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="105" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Impuesto" Binding="{Binding Tax, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="110" ElementStyle="{StaticResource CommerceNumber}"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="Resumen" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding QuotationDetail.Subtotal, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Subtotal" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding QuotationDetail.Discount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Descuento" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding QuotationDetail.Tax, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Impuestos" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <Border Style="{StaticResource SoftPanel}" Margin="0,8,0,12">
                <StackPanel>
                  <TextBlock Text="Total" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding QuotationDetail.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <ContentControl Style="{StaticResource CommerceField}" Tag="Cargo de entrega" Content="{Binding QuotationDetail.Cart.DeliveryCharge, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </StackPanel>
</UserControl>
