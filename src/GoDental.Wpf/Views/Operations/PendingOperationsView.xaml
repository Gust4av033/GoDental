<UserControl x:Class="GoDental.Wpf.Views.Operations.PendingOperationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Operaciones pendientes" Style="{StaticResource Heading}"/>
    <TextBlock Text="Solicitudes guardadas antes del envío, de tu cuenta, estación y base actuales. Nunca se reenvían automáticamente al iniciar." Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
    <Button Content="Actualizar" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Style="{StaticResource ActionButton}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="280" Margin="0,12,0,12" AutomationProperties.Name="Solicitudes pendientes de recuperar">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Fecha" Binding="{Binding Created, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
        <DataGridTextColumn Header="Operación" Binding="{Binding Ticket.Type}" Width="*"/>
        <DataGridTextColumn Header="Identificador" Binding="{Binding Ticket.OperationId}" Width="280"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="Consultar no modifica el negocio. Resolver y liberar recupera una confirmación existente; si el envío terminó sin confirmar, lo cierra definitivamente para permitir una nueva captura. No anula ventas ni cobros ya confirmados." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <WrapPanel>
      <Button Content="Consultar estado" Command="{Binding CheckCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Content="Resolver y liberar" Command="{Binding ResolveAndReleaseCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
    </WrapPanel>
  </StackPanel>
</UserControl>
