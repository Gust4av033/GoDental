<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Operations.OnlinePlanningDraftView">
  <StackPanel>
    <StackPanel Visibility="{Binding HasName,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Nombre del registro Online" Margin="0,0,0,12"/>
    </StackPanel>
    <UniformGrid Columns="2" Visibility="{Binding HasLocation,Converter={StaticResource BoolToVisibility}}">
      <StackPanel Margin="0,0,16,12">
        <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Location.Departments}" SelectedItem="{Binding Location.Department}" AutomationProperties.Name="Departamento de zona o segmento"/>
      </StackPanel>
      <StackPanel Margin="0,0,16,12">
        <TextBlock Text="Municipio · opcional" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Location.Municipalities}" SelectedItem="{Binding Location.Municipality}" AutomationProperties.Name="Municipio de zona o segmento"/>
      </StackPanel>
    </UniformGrid>
    <StackPanel Visibility="{Binding IsZone,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Prioridad · menor número primero" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Priority,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Prioridad de la zona" Margin="0,0,0,12"/>
    </StackPanel>
    <StackPanel Visibility="{Binding HasChannel,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Canal" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" AutomationProperties.Name="Canal comercial" Margin="0,0,0,12"/>
    </StackPanel>
    <StackPanel Visibility="{Binding IsSegment,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Tipo de negocio · opcional, coincidencia exacta" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Type,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Tipo de negocio del segmento" Margin="0,0,0,12"/>
      <UniformGrid Columns="2">
        <StackPanel Margin="0,0,16,12">
          <TextBlock Text="Estado" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" AutomationProperties.Name="Estado del segmento"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,12">
          <TextBlock Text="Fuente" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" AutomationProperties.Name="Fuente del segmento"/>
        </StackPanel>
      </UniformGrid>
      <TextBlock Text="Los filtros se combinan. Se excluyen convertidos, descartados y no contactar; preparar la campaña vuelve a validar el contacto." Style="{StaticResource MutedText}"/>
    </StackPanel>
    <StackPanel Visibility="{Binding IsTemplate,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Mensaje · texto plano, marcador {nombre}" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Content,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" MinHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Contenido de la plantilla"/>
      <TextBlock Text="Vista previa · sin envío" Style="{StaticResource SectionHeading}" Margin="0,12,0,6"/>
      <Border Style="{StaticResource SoftPanel}">
        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>
    <CheckBox Content="Activo" IsChecked="{Binding Active}" Margin="0,16,0,0"/>
  </StackPanel>
</UserControl>
