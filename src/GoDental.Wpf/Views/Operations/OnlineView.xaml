<UserControl x:Class="GoDental.Wpf.Views.Operations.OnlineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<StackPanel><TextBlock Text="Online · gestión interna" Style="{StaticResource Heading}"/><TextBlock Text="Prospectos públicos, fuentes y exclusiones. Sin búsqueda automática ni envío de comunicaciones; los datos públicos no acreditan consentimiento." Style="{StaticResource MutedText}"/>
<ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolToVisibility}}"/><local:OperationStatusView DataContext="{Binding Operation}"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
<TabControl>
<TabItem Header="Prospectos" Style="{StaticResource CommerceTab}"><StackPanel Margin="0,16,0,0"><WrapPanel IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,12"><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Width="230" Margin="0,0,8,8" AutomationProperties.Name="Buscar prospectos por nombre teléfono correo o ID"/><ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" Width="160" Margin="0,0,8,8" AutomationProperties.Name="Estado de prospecto"/><Button Content="Consultar" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Nuevo prospecto" Command="{Binding CreateCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanManage}"/><Button Content="Consultar ficha" Command="{Binding OpenCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="260" AutomationProperties.Name="Prospectos públicos registrados"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="210"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="115"/><DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Contacto" Binding="{Binding SuppressionLabel}" Width="270"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}"/><WrapPanel IsEnabled="{Binding IsNotBusy}"><Button Content="‹" AutomationProperties.Name="Página anterior de prospectos" Command="{Binding PreviousCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="›" AutomationProperties.Name="Página siguiente de prospectos" Command="{Binding NextCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></TabItem><TabItem Header="Ficha, fuentes e historial" Style="{StaticResource CommerceTab}"><StackPanel Margin="0,16,0,0"><TextBlock Text="{Binding DetailMessage}" Style="{StaticResource StatusMessage}"/><WrapPanel Margin="0,12,0,8"><Button Content="Actualizar ficha" Command="{Binding OpenCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Editar datos" Command="{Binding EditCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanChange}"/><Button Content="Añadir fuente" Command="{Binding AddSourceCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanManage}"/><Button Content="Revisar / descartar" Command="{Binding ChangeStateCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanChange}"/><Button Content="No contactar" Command="{Binding BlockCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanExclude}"/></WrapPanel><UniformGrid Columns="2"><ContentControl Style="{StaticResource CommerceField}" Tag="Nombre público" Content="{Binding Detail.Name}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Tipo de negocio" Content="{Binding Detail.Type}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Teléfono" Content="{Binding Detail.Phone}"/><ContentControl Style="{StaticResource CommerceField}" Tag="WhatsApp" Content="{Binding Detail.WhatsApp}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Correo" Content="{Binding Detail.Email}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Sitio empresarial" Content="{Binding Detail.Website}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Instagram" Content="{Binding Detail.Instagram}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Facebook" Content="{Binding Detail.Facebook}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Departamento" Content="{Binding Detail.Department}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Municipio" Content="{Binding Detail.Municipality}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Distrito" Content="{Binding Detail.District}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Cliente vinculado" Content="{Binding Detail.Customer}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Compra que acreditó conversión" Content="{Binding Detail.ConversionSale}"/></UniformGrid><TextBlock Text="Fuentes conservadas" Style="{StaticResource SectionHeading}"/><DataGrid ItemsSource="{Binding Sources}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="190" AutomationProperties.Name="Fuentes públicas del prospecto"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Fecha local" Binding="{Binding LocalDate}" Width="150"/><DataGridTextColumn Header="URL documental" Binding="{Binding Url}" Width="300"/><DataGridTextColumn Header="Dato obtenido" Binding="{Binding Description}" Width="200"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding SourcePageLabel}" Style="{StaticResource MutedText}"/><WrapPanel IsEnabled="{Binding IsNotBusy}"><Button Content="‹" AutomationProperties.Name="Página anterior de fuentes" Command="{Binding PreviousSourceCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="›" AutomationProperties.Name="Página siguiente de fuentes" Command="{Binding NextSourceCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="Coincidencias actuales · revisar identidad, sin fusión automática" Style="{StaticResource SectionHeading}"/><DataGrid ItemsSource="{Binding Matches}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" AutomationProperties.Name="Coincidencias de prospectos y clientes"><DataGrid.Columns><DataGridTextColumn Header="Entidad" Binding="{Binding Entity}" Width="100"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="240"/><DataGridTextColumn Header="Coincidencia" Binding="{Binding Match}" Width="220"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding MatchPageLabel}" Style="{StaticResource MutedText}"/><WrapPanel IsEnabled="{Binding IsNotBusy}"><Button Content="‹" AutomationProperties.Name="Página anterior de coincidencias" Command="{Binding PreviousMatchCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="›" AutomationProperties.Name="Página siguiente de coincidencias" Command="{Binding NextMatchCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="Historial interno" Style="{StaticResource SectionHeading}"/><DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" AutomationProperties.Name="Historial del prospecto"><DataGrid.Columns><DataGridTextColumn Header="Fecha local" Binding="{Binding LocalDate}" Width="150"/><DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="150"/><DataGridTextColumn Header="Operación" Binding="{Binding Action}" Width="180"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="300"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding HistoryPageLabel}" Style="{StaticResource MutedText}"/><WrapPanel IsEnabled="{Binding IsNotBusy}"><Button Content="‹" AutomationProperties.Name="Página anterior de historial" Command="{Binding PreviousHistoryCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="›" AutomationProperties.Name="Página siguiente de historial" Command="{Binding NextHistoryCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></TabItem><TabItem Header="Vincular compra" Style="{StaticResource CommerceTab}"><StackPanel Margin="0,16,0,0"><TextBlock Text="Selecciona primero el prospecto y consulta su ficha. Busca una venta confirmada de un cliente activo y verifica que corresponde al mismo negocio. Si falta cliente, regístralo desde Clientes y confirma su compra en POS." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DetailMessage}" Style="{StaticResource StatusMessage}"/><WrapPanel IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,12"><TextBox Text="{Binding SaleSearch,UpdateSourceTrigger=PropertyChanged}" Width="240" MaxLength="200" AutomationProperties.Name="Buscar compra confirmada para conversión" Margin="0,0,8,8"/><Button Content="Buscar compras" Command="{Binding FindSalesCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanReadSales}"/><Button Content="Vincular y convertir" Command="{Binding ConvertCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanConvert}"/></WrapPanel><DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="260" AutomationProperties.Name="Ventas confirmadas para conversión"><DataGrid.Columns><DataGridTextColumn Header="Venta" Binding="{Binding Number}" Width="170"/><DataGridTextColumn Header="Cliente original" Binding="{Binding Converter={StaticResource SaleCustomerName}}" Width="250"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Total USD" Binding="{Binding Total}" Width="120"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding SalePageLabel}" Style="{StaticResource MutedText}"/><WrapPanel IsEnabled="{Binding IsNotBusy}"><Button Content="‹" AutomationProperties.Name="Página anterior de compras" Command="{Binding PreviousSaleCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="›" AutomationProperties.Name="Página siguiente de compras" Command="{Binding NextSaleCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="La vinculación no crea otra venta, cliente ni deuda; conserva la fuente y todas las exclusiones. No otorga consentimiento de marketing." Style="{StaticResource MutedText}"/></StackPanel></TabItem><TabItem Header="No contactar" Style="{StaticResource CommerceTab}"><StackPanel Margin="0,16,0,0"><TextBlock Text="Lista central por canal. Permite registrar o reactivar una exclusión; levantarla requiere una política futura de consentimiento. No hay envío de mensajes." Style="{StaticResource MutedText}"/><WrapPanel IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,12"><TextBox Text="{Binding ExclusionSearch,UpdateSourceTrigger=PropertyChanged}" Width="260" MaxLength="200" AutomationProperties.Name="Buscar exclusión comercial" Margin="0,0,8,8"/><Button Content="Consultar exclusiones" Command="{Binding FindExclusionsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="Registrar exclusión" Command="{Binding AddExclusionCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanExclude}"/></WrapPanel><DataGrid ItemsSource="{Binding Exclusions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="260" AutomationProperties.Name="Lista central de no contactar"><DataGrid.Columns><DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="120"/><DataGridTextColumn Header="Identificador" Binding="{Binding Identifier}" Width="240"/><DataGridTextColumn Header="Activa" Binding="{Binding Active}" Width="75"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="250"/><DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="150"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding ExclusionPageLabel}" Style="{StaticResource MutedText}"/><WrapPanel IsEnabled="{Binding IsNotBusy}"><Button Content="‹" AutomationProperties.Name="Página anterior de exclusiones" Command="{Binding PreviousExclusionCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/><Button Content="›" AutomationProperties.Name="Página siguiente de exclusiones" Command="{Binding NextExclusionCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/></WrapPanel></StackPanel></TabItem></TabControl></StackPanel></UserControl>