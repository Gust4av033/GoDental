<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:format="clr-namespace:GoDental.Wpf.Converters" x:Class="GoDental.Wpf.Views.Operations.ReceiptPreviewView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <format:ReceiptPageImageConverter x:Key="ReceiptPageImage"/>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintReceiptCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportCommand}"/>
  </UserControl.InputBindings>
  <StackPanel>
    <DockPanel Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Guardar PDF" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
        <Button Content="Imprimir" Command="{Binding PrintReceiptCommand}" IsEnabled="{Binding CanExport}" Style="{StaticResource PrimaryActionButton}"/>
      </StackPanel>
      <Button Content="Volver a la venta" Command="{Binding CloseReceiptPreviewCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource TextButton}" HorizontalAlignment="Left"/>
    </DockPanel>
    <TextBlock Text="Vista previa del comprobante" Style="{StaticResource Heading}"/>
    <TextBlock Text="{Binding SaleDetail.Sale.Number}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <DockPanel Margin="0,0,0,12" IsEnabled="{Binding IsNotBusy}">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource PaginationButton}" ToolTip="Reducir zoom" AutomationProperties.Name="Reducir zoom"/>
        <TextBlock Text="{Binding ZoomLabel}" Style="{StaticResource MutedText}" Margin="10,0" VerticalAlignment="Center"/>
        <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource PaginationButton}" ToolTip="Aumentar zoom" AutomationProperties.Name="Aumentar zoom"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="‹" Command="{Binding PreviousPreviewPageCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior del comprobante" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding PreviewPageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button Content="›" Command="{Binding NextPreviewPageCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente del comprobante"/>
      </StackPanel>
    </DockPanel>
    <Border Style="{StaticResource SoftPanel}" Padding="8">
      <ScrollViewer Height="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False" AutomationProperties.Name="Vista previa de páginas">
        <Image Source="{Binding PreviewPage, Converter={StaticResource ReceiptPageImage}}" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.Name="Página del comprobante"/>
      </ScrollViewer>
    </Border>
  </StackPanel>
</UserControl>
