<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.OrderDraftView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <TabControl>
      <TabItem Header="Cliente y dirección" Style="{StaticResource CommerceTab}">
        <StackPanel>
          <local:CustomerLookupView DataContext="{Binding Customer}"/>
          <WrapPanel Margin="0,12,0,4">
            <Button Content="Recargar datos" Command="{Binding AddressesCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
          </WrapPanel>
          <StackPanel Margin="0,0,16,12">
            <TextBlock Text="Dirección guardada (opcional)" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding Address}" DisplayMemberPath="Address" AutomationProperties.Name="Dirección guardada (opcional)"/>
          </StackPanel>
          <TextBlock Text="Al seleccionar el cliente se cargan sus datos. Revísalos en Datos de entrega; no se modifica su ficha." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Datos de entrega" Style="{StaticResource CommerceTab}">
        <StackPanel Margin="0,16,0,0" IsEnabled="{Binding CanEditDelivery}">
          <TextBlock Text="Datos sugeridos del cliente; puedes corregirlos sólo para este pedido." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
          <UniformGrid Columns="2" Margin="0,0,-16,0">
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Contacto guardado (opcional)" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding Contact}" DisplayMemberPath="Name" AutomationProperties.Name="Contacto guardado (opcional)"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Contacto de entrega" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.Name="Contacto de entrega"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.Name="Teléfono"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Departamento"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Municipio" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Municipality, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Municipio"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Referencia" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Referencia"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Dirección de entrega" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Dirección de entrega" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="Editar la dirección la convierte en una dirección específica del pedido; la dirección guardada del cliente se conserva." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Productos" Style="{StaticResource CommerceTab}">
        <StackPanel>
          <WrapPanel Margin="0,12,0,4">
            <StackPanel Width="300" Margin="0,0,16,12">
              <TextBlock Text="SKU o nombre" Margin="0,0,0,6"/>
              <TextBox Style="{StaticResource SearchBox}" Tag="Buscar…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU o nombre"/>
            </StackPanel>
            <Button Tag="" Content="Buscar" Command="{Binding SearchCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="160" AutomationProperties.Name="Products" SelectedItem="{Binding Product}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" ElementStyle="{StaticResource CommerceCell}"/>
              <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,12,0,4">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
          <WrapPanel Margin="0,12,0,4">
            <StackPanel Width="140" Margin="0,0,16,12">
              <TextBlock Text="Cantidad" Margin="0,0,0,6"/>
              <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad"/>
            </StackPanel>
            <Button Content="Agregar / cambiar" Command="{Binding AddCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
            <Button Content="Quitar" Command="{Binding RemoveCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="160" AutomationProperties.Name="Items" SelectedItem="{Binding SelectedLine}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" ElementStyle="{StaticResource CommerceCell}"/>
              <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
              <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="110" ElementStyle="{StaticResource CommerceCell}"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </TabItem>
    </TabControl>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
