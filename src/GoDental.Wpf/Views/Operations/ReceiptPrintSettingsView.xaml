<UserControl x:Class="GoDental.Wpf.Views.Operations.ReceiptPrintSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,0,0,12">
    <TextBlock Text="Formato del documento" Style="{StaticResource SectionHeading}"/>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <StackPanel Width="150" Margin="0,4,8,0"><TextBlock Text="Documento" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PrintSettings.Kinds}" SelectedItem="{Binding PrintSettings.Kind}" AutomationProperties.Name="Tipo de documento"/></StackPanel>
      <StackPanel Width="150" Margin="0,4,8,0"><TextBlock Text="Papel" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PrintSettings.Papers}" SelectedItem="{Binding PrintSettings.Paper}" AutomationProperties.Name="Formato de papel"/></StackPanel>
      <StackPanel Width="90" Margin="0,4,8,0"><TextBlock Text="Ancho (mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Width, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Ancho del papel en milímetros"/></StackPanel>
      <StackPanel Width="90" Margin="0,4,8,0"><TextBlock Text="Alto (mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Height, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Alto del papel en milímetros"/></StackPanel>
      <StackPanel Width="90" Margin="0,4,8,0"><TextBlock Text="Margen (mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Margin, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Margen del documento en milímetros"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="Los tickets se paginan con el alto indicado. Entrega requiere pedido asociado. Cambia las medidas y actualiza la vista previa antes de guardar o imprimir." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
  </StackPanel>
</UserControl>
