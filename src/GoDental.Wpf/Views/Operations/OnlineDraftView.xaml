<UserControl x:Class="GoDental.Wpf.Views.Operations.OnlineDraftView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
<StackPanel Visibility="{Binding ShowData,Converter={StaticResource BoolToVisibility}}">
<UniformGrid Columns="2">
<StackPanel Margin="0,0,16,12"><TextBlock Text="Negocio / nombre público" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Nombre público del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Tipo de negocio (opcional)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.Type,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Tipo de negocio del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Teléfono público · + y código opcionales SV" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.Phone,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Teléfono público del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="WhatsApp público" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.WhatsApp,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="WhatsApp público del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Correo empresarial público" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.Email,UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Correo público del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Sitio propio del negocio · HTTPS" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.Website,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="Sitio empresarial del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Instagram · URL pública HTTPS" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.Instagram,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Instagram público del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Facebook · URL pública HTTPS" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Data.Facebook,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Facebook público del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Location.Departments}" SelectedItem="{Binding Location.Department}" AutomationProperties.Name="Departamento del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Municipio" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Location.Municipalities}" SelectedItem="{Binding Location.Municipality}" AutomationProperties.Name="Municipio del prospecto"/></StackPanel>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Distrito (opcional)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Location.Districts}" SelectedItem="{Binding Location.District}" AutomationProperties.Name="Distrito del prospecto"/></StackPanel>
</UniformGrid>
<Button Content="Comparar coincidencias" Command="{Binding CheckMatchesCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
<ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy,Converter={StaticResource BoolToVisibility}}"/>
<TextBlock Text="{Binding MatchMessage}" Style="{StaticResource MutedText}" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite"/>
<DataGrid ItemsSource="{Binding Matches}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="150" AutomationProperties.Name="Coincidencias antes de guardar prospecto"><DataGrid.Columns><DataGridTextColumn Header="Entidad" Binding="{Binding Entity}" Width="90"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="Coincidencia" Binding="{Binding Match}" Width="180"/></DataGrid.Columns></DataGrid>
</StackPanel>
<StackPanel Visibility="{Binding NeedsSource,Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
<TextBlock Text="Fuente pública · sólo referencia documental" Style="{StaticResource SectionHeading}"/>
<TextBlock Text="URL HTTPS sin credenciales, parámetros ni fragmentos. No se consulta el sitio. La procedencia pública no equivale a consentimiento." Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
<UniformGrid Columns="2"><StackPanel Margin="0,0,16,12"><TextBlock Text="Tipo de fuente" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SourceType}" AutomationProperties.Name="Tipo de fuente pública"/></StackPanel><StackPanel Margin="0,0,16,12"><TextBlock Text="Fecha de obtención" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding Obtained}" AutomationProperties.Name="Fecha de obtención de la fuente"/></StackPanel></UniformGrid>
<TextBlock Text="URL de procedencia" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SourceUrl,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="URL de fuente pública" Margin="0,0,0,12"/>
<TextBlock Text="Qué dato se obtuvo (opcional, 300)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Dato obtenido de la fuente"/>
</StackPanel>
</StackPanel>
</UserControl>
