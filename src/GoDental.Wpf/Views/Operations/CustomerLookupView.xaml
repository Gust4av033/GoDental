<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CustomerLookupView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <DockPanel Margin="0,0,0,16">
      <Button Content="Sin cliente" Command="{Binding ClearCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <Button Content="" Command="{Binding SearchCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Buscar clientes" AutomationProperties.Name="Buscar clientes" DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <TextBox Style="{StaticResource SearchBox}" Tag="Buscar por nombre o código…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre o código">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
        </TextBox.InputBindings>
      </TextBox>
    </DockPanel>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <Grid>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="240" AutomationProperties.Name="Items">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource CommerceCell}"/>
          <DataGridTemplateColumn Header="Cliente" Width="*" MinWidth="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DockPanel>
                  <Border Style="{StaticResource CommerceAvatar}" Width="28" Height="28" DockPanel.Dock="Left" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name, Converter={StaticResource CommerceInitials}}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource CommerceCell}"/>
                </DockPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="140" ElementStyle="{StaticResource CommerceCell}"/>
        </DataGrid.Columns>
      </DataGrid>
      <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Items.Count}" Content="Busca un cliente y selecciónalo en el listado."/>
    </Grid>
    <WrapPanel Margin="0,12,0,12">
      <Button Content="‹" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,6,0"/>
      <Button Content="›" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}"/>
    </WrapPanel>
    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionHeading}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
