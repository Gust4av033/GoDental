<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.CustomerLookupView">
  <StackPanel>
    <StackPanel.InputBindings>
      <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
    </StackPanel.InputBindings>
    <WrapPanel Margin="0,12,0,4">
      <StackPanel Width="300" Margin="0,0,16,12">
        <TextBlock Text="Nombre o código" Margin="0,0,0,6"/>
        <TextBox Style="{StaticResource SearchBox}" Tag="Buscar…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre o código"/>
      </StackPanel>
      <Button Tag="&#xE721;" Content="Buscar" Command="{Binding SearchCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Content="Sin cliente" Command="{Binding ClearCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
    </WrapPanel>
    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="190" AutomationProperties.Name="Items" SelectedItem="{Binding Selected}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="110"/>
        <DataGridTemplateColumn Header="Cliente" Width="*" MinWidth="180" CellTemplate="{StaticResource PersonName}"/>
        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Margin="0,12,0,4">
      <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
      <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
    </WrapPanel>
    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionHeading}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
