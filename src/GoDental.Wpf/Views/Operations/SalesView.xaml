<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.SalesView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <ProgressBar Style="{StaticResource InlineLoadingIndicator}" Height="3" IsIndeterminate="True"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <local:ReceiptPrintSettingsView Visibility="{Binding IsReceiptPreviewOpen, Converter={StaticResource BoolToVisibility}}"/>
    <local:ReceiptPreviewView Visibility="{Binding IsReceiptPreviewOpen, Converter={StaticResource BoolToVisibility}}"/>
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsReceiptPreviewOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
    <StackPanel Style="{StaticResource CommerceList}" Tag="{Binding IsSaleDetailOpen}">
      <DockPanel Margin="0,0,0,20">
        <Button Content="Actualizar" Command="{Binding ReloadSalesCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Ventas y comprobantes" Style="{StaticResource Heading}"/>
          <TextBlock Text="Consulta ventas y guarda su comprobante PDF interno." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <Grid>
        <DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="300" AutomationProperties.Name="Sales">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTemplateColumn Header="Número" Width="*" MinWidth="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource CommerceRowLink}" Command="{Binding DataContext.OpenSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Number}">
                    <TextBlock Text="{Binding Number}" Style="{StaticResource CommerceCell}" FontWeight="SemiBold"/>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Cliente" Binding="{Binding Converter={StaticResource SaleCustomerName}}" Width="180" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="160" ElementStyle="{StaticResource CommerceCell}"/>
            <DataGridTemplateColumn Header="Estado" Width="125">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CommerceState}" Tag="{Binding State}">
                    <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="115" ElementStyle="{StaticResource CommerceNumber}"/>
            <DataGridTextColumn Header="Pendiente" Binding="{Binding Pending, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="115" ElementStyle="{StaticResource CommerceNumber}"/>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Sales.Count}" Content="No hay ventas registradas."/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <Button Content="Ver detalle" Command="{Binding ReadSaleCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanOpenSelectedSale}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Content="‹" Command="{Binding PreviousSalesCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
            <Button Content="›" Command="{Binding NextSalesCommand}" Style="{StaticResource PaginationButton}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
          </StackPanel>
          <TextBlock Text="{Binding SalesPageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
      </DockPanel>
    </StackPanel>
    <StackPanel Style="{StaticResource CommerceDetail}" Tag="{Binding IsSaleDetailOpen}">
      <DockPanel Margin="0,0,0,16">
        <Button Content="Guardar PDF" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanExport}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <Button Content="Previsualizar" Command="{Binding PreviewReceiptCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanExport}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <Button Content="" Command="{Binding ReadSaleCommand}" Style="{StaticResource CommerceIconButton}" ToolTip="Actualizar detalle" AutomationProperties.Name="Actualizar detalle" DockPanel.Dock="Right"/>
        <Button Content="Volver a ventas" Tag="" Command="{Binding ReturnToSalesCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,20">
        <Border Style="{StaticResource CommerceSymbol}" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="{Binding SaleDetail.Sale.Number}" Style="{StaticResource Heading}" Margin="0,0,12,4"/>
            <Border Style="{StaticResource CommerceState}" Tag="{Binding SaleDetail.Sale.State}">
              <TextBlock Text="{Binding SaleDetail.Sale.State}" FontSize="11"/>
            </Border>
          </WrapPanel>
          <TextBlock Text="Comprobante operativo interno · No es un DTE fiscal" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding SaleDetail.Sale, Converter={StaticResource SaleCustomerName}}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <local:ReceiptPrintSettingsView/>
      <UniformGrid Columns="3" Margin="0,0,-12,20">
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding SaleDetail.Sale.Date, StringFormat=dd/MM/yyyy}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Total" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding SaleDetail.Sale.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Pendiente" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding SaleDetail.Sale.Pending, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource DangerBrush}"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <TabControl>
        <TabItem Header="Productos" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <DataGrid ItemsSource="{Binding SaleDetail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="280" AutomationProperties.Name="SaleDetail.Lines">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="80" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Descuento" Binding="{Binding Discount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="105" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Impuesto" Binding="{Binding Tax, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="100" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="110" ElementStyle="{StaticResource CommerceNumber}"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="Pagos" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <DataGrid ItemsSource="{Binding SaleDetail.Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="200" AutomationProperties.Name="SaleDetail.Payments">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Forma" Binding="{Binding Method}" Width="*" ElementStyle="{StaticResource CommerceCell}"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding Amount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Width="130" ElementStyle="{StaticResource CommerceNumber}"/>
                <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="250" ElementStyle="{StaticResource CommerceCell}"/>
              </DataGrid.Columns>
            </DataGrid>
            <UniformGrid Columns="2" Margin="0,16,-16,0">
              <ContentControl Style="{StaticResource CommerceField}" Tag="Efectivo recibido" Content="{Binding SaleDetail.Sale.CashTendered, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
              <ContentControl Style="{StaticResource CommerceField}" Tag="Cambio confirmado" Content="{Binding SaleDetail.Sale.Change, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
            </UniformGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="Resumen" Style="{StaticResource CommerceTab}">
          <StackPanel Margin="0,16,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SaleDetail.Sale.Subtotal, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Subtotal" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SaleDetail.Sale.Discount, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Descuento" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SaleDetail.Sale.Tax, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MoneyCellText}"/>
                <TextBlock Text="Impuestos" Style="{StaticResource MutedText}"/>
              </DockPanel>
              <Border Style="{StaticResource SoftPanel}" Margin="0,8,0,12">
                <StackPanel>
                  <TextBlock Text="Total" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SaleDetail.Sale.Total, Converter={StaticResource UsdMoney}, FallbackValue=—}" Style="{StaticResource MetricValue}"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <ContentControl Style="{StaticResource CommerceField}" Tag="Cargo de entrega" Content="{Binding SaleDetail.Sale.DeliveryCharge, Converter={StaticResource UsdMoney}, FallbackValue=—}"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Devoluciones / anulaciones" Style="{StaticResource CommerceTab}"><local:SaleReturnsView/></TabItem>
      </TabControl>
    </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
