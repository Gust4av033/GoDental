<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Operations" x:Class="GoDental.Wpf.Views.Operations.SalesView">
  <StackPanel>
    <TextBlock Text="Ventas y comprobantes" Style="{StaticResource Heading}"/>
    <TextBlock Text="Consulta ventas confirmadas y guarda su comprobante PDF interno. No es un DTE fiscal." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <local:OperationStatusView DataContext="{Binding Operation}"/>
    <WrapPanel Margin="0,12,0,4">
      <Button Tag="&#xE72C;" Content="Actualizar" Command="{Binding ReloadSalesCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Content="Ver detalle" Command="{Binding ReadSaleCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Tag="&#xE8A5;" Content="Guardar PDF" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="{Binding CanExport}"/>
    </WrapPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="240" AutomationProperties.Name="Sales" SelectedItem="{Binding SelectedSale}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
            <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="*"/>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/>
            <DataGridTemplateColumn Header="Estado" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StateBadge}" Tag="{Binding State}"><TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource UsdMoney}}" Width="100" ElementStyle="{StaticResource MoneyCellText}"/>
            <DataGridTextColumn Header="Pendiente" Binding="{Binding Pending, Converter={StaticResource UsdMoney}}" Width="110" ElementStyle="{StaticResource MoneyCellText}"/>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,12,0,4">
          <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousSalesCommand}" Margin="0,0,8,8"/>
          <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextSalesCommand}" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{Binding SaleDetail.Sale.Number}" Style="{StaticResource SectionHeading}"/>
        <TextBlock Text="{Binding SaleDetail.Sale.Total, StringFormat=Total: {0:N2}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="{Binding SaleDetail.Sale.CashTendered, StringFormat=Efectivo recibido: {0:N2}}" Style="{StaticResource MutedText}"/>
        <TextBlock Text="{Binding SaleDetail.Sale.Change, StringFormat=Cambio: {0:N2}}" Style="{StaticResource MutedText}"/>
        <DataGrid ItemsSource="{Binding SaleDetail.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="190" AutomationProperties.Name="SaleDetail.Lines">
          <DataGrid.Columns>
            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
            <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="95"/>
            <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, Converter={StaticResource UsdMoney}}" Width="100" ElementStyle="{StaticResource MoneyCellText}"/>
            <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource UsdMoney}}" Width="100" ElementStyle="{StaticResource MoneyCellText}"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Pagos registrados" Style="{StaticResource SectionHeading}" Margin="0,16,0,12"/>
        <DataGrid ItemsSource="{Binding SaleDetail.Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="140" AutomationProperties.Name="SaleDetail.Payments">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Forma" Binding="{Binding Method}" Width="*"/>
            <DataGridTextColumn Header="Importe" Binding="{Binding Amount, Converter={StaticResource UsdMoney}}" Width="120" ElementStyle="{StaticResource MoneyCellText}"/>
            <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="200"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
