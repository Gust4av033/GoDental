<UserControl x:Class="GoDental.Wpf.Views.Operations.OnlineMapView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Commerce.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <WrapPanel IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,8">
      <ComboBox ItemsSource="{Binding MapDepartments}" SelectedItem="{Binding MapDepartment}" Width="200" Margin="0,0,8,8" AutomationProperties.Name="Departamento del mapa"/>
      <Button Content="+" Command="{Binding ZoomMapInCommand}" Style="{StaticResource ActionButton}" AutomationProperties.Name="Acercar mapa" Margin="0,0,6,8"/>
      <Button Content="−" Command="{Binding ZoomMapOutCommand}" Style="{StaticResource ActionButton}" AutomationProperties.Name="Alejar mapa" Margin="0,0,6,8"/>
      <Button Content="Ajustar" Command="{Binding ResetMapZoomCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,8"/>
    </WrapPanel>
    <Border Style="{StaticResource SoftPanel}" Padding="0">
      <ScrollViewer Height="340" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Mapa de los 14 departamentos de El Salvador">
        <Viewbox Width="{Binding MapWidth}" Height="{Binding MapHeight}" Stretch="Uniform">
          <Grid Width="800" Height="440" Background="{DynamicResource SurfaceBrush}">
            <ItemsControl ItemsSource="{Binding MapRegions}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Path Data="{Binding PathData}" Stroke="{DynamicResource PrimaryBrush}" Focusable="True" Cursor="Hand" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" MouseLeftButtonUp="RegionClicked" KeyDown="RegionKeyDown">
                  <Path.Style><Style TargetType="Path"><Setter Property="StrokeThickness" Value="1.1"/><Setter Property="Fill" Value="{DynamicResource TintBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Fill" Value="{DynamicResource SidebarSelectionBrush}"/><Setter Property="StrokeThickness" Value="3"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="StrokeThickness" Value="3"/></Trigger></Style.Triggers></Style></Path.Style>
                </Path>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding MapRegions}" IsHitTestVisible="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding LabelX}"/><Setter Property="Canvas.Top" Value="{Binding LabelY}"/></Style></ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Viewbox>
      </ScrollViewer>
    </Border>
    <TextBlock Text="Límites departamentales de referencia. El municipio se elige con el catálogo vigente." Style="{StaticResource MutedText}" Margin="0,8,0,4"/>
    <TextBlock Style="{StaticResource MutedText}"><Run Text="Datos: Who’s On First / foursquare Quattroshapes · CC-BY 2.0 · "/><Hyperlink NavigateUri="https://github.com/whosonfirst-data/whosonfirst-data-admin-sv/blob/b8c0ae6f6469102c0dbf33fecdaab0209496ac9b/LICENSE.md" RequestNavigate="LicenseRequested">Licencia</Hyperlink><Run Text=" · "/><Hyperlink NavigateUri="https://github.com/foursquare/quattroshapes/" RequestNavigate="LicenseRequested">foursquare Quattroshapes</Hyperlink></TextBlock>
    <TextBlock Text="{Binding MapMessage}" Style="{StaticResource StatusMessage}" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel>
      <Button Content="Buscar negocios dentales" Command="{Binding DiscoverCommand}" IsEnabled="{Binding CanManage}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Content="Cancelar búsqueda" Command="{Binding DiscoverCancelCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Content="Revisar para registrar" Command="{Binding ReviewDiscoveredCommand}" IsEnabled="{Binding CanManage}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
    </WrapPanel>
    <DataGrid ItemsSource="{Binding Discovered}" SelectedItem="{Binding SelectedDiscovered}" Height="200" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AutomationProperties.Name="Negocios públicos encontrados sin guardar">
      <DataGrid.Columns><DataGridTextColumn Header="Negocio" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Teléfono publicado" Binding="{Binding Phone}" Width="150"/><DataGridTextColumn Header="Dirección publicada" Binding="{Binding Address}" Width="*"/></DataGrid.Columns>
    </DataGrid>
    <UniformGrid Columns="2" Margin="0,12,0,0"><ContentControl Style="{StaticResource CommerceField}" Tag="Fuente pública" Content="{Binding SelectedDiscovered.SourceUrl}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Correo publicado" Content="{Binding SelectedDiscovered.Email}"/><ContentControl Style="{StaticResource CommerceField}" Tag="WhatsApp publicado explícitamente" Content="{Binding SelectedDiscovered.WhatsApp}"/><ContentControl Style="{StaticResource CommerceField}" Tag="Sitio publicado" Content="{Binding SelectedDiscovered.Website}"/></UniformGrid>
    <TextBlock Style="{StaticResource MutedText}"><Run Text="© OpenStreetMap contributors · ODbL 1.0 · "/><Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" RequestNavigate="LicenseRequested">Licencia y atribución</Hyperlink></TextBlock>
    <TextBlock Text="Fuente comunitaria: puede estar incompleta o desactualizada. Consulta acotada, un minuto entre búsquedas. No se guardan ni contactan negocios automáticamente." Style="{StaticResource MutedText}" Margin="0,6,0,12"/>
  </StackPanel>
</UserControl>
