<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:GoDental.Wpf.Views.Shared" x:Class="GoDental.Wpf.Views.Inventory.CountStartDialogView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Inventory.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel IsEnabled="{Binding CanEdit}">
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Preparar conteo físico" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Selecciona el almacén y los productos que vas a verificar." Style="{StaticResource MutedText}"/>
    </StackPanel>
    <StackPanel Margin="0,0,16,16">
      <TextBlock Text="Almacén del conteo" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" AutomationProperties.Name="Almacén del conteo"/>
    </StackPanel>
    <TextBlock Text="Puedes incluir hasta 500 productos con existencias establecidas. El conteo incorpora todos sus lotes en ese almacén." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <shared:ProductPickerView DataContext="{Binding Picker}"/>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
      <StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Motivo de apertura" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo de apertura"/>
        </StackPanel>
        <CheckBox Content="Confirmo los productos y el almacén del conteo" IsChecked="{Binding Confirmed}" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
