<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Inventory.CountStartDialogView">
  <StackPanel xmlns:shared="clr-namespace:GoDental.Wpf.Views.Shared" IsEnabled="{Binding CanEdit}">
    <TextBlock Text="Almacén"/>
    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" AutomationProperties.Name="Almacén del conteo" Margin="0,6,0,12"/>
    <TextBlock Text="Selecciona hasta 500 productos con existencias establecidas. Se incluirán todos sus lotes en este almacén." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <shared:ProductPickerView DataContext="{Binding Picker}"/>
    <StackPanel Width="450" Margin="0,0,16,12">
      <TextBlock Text="Motivo de apertura" Margin="0,0,0,6"/>
      <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo de apertura"/>
    </StackPanel>
    <CheckBox Content="Confirmo los productos y el almacén del conteo" IsChecked="{Binding Confirmed}" Margin="0,6,16,12"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
