<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Inventory.CategoryDialogView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Inventory.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,16"/>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Categorías del catálogo" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Crea una categoría o selecciona una para actualizar su nombre o estado." Style="{StaticResource MutedText}"/>
    </StackPanel>
    <Button Content="Nueva categoría" Command="{Binding NewCategoryCommand}" IsEnabled="{Binding CanCreate}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
    <StackPanel Margin="0,0,16,16">
      <TextBlock Text="Categoría a administrar" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="CategoryInput" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" AutomationProperties.Name="Categoría a administrar" IsEnabled="{Binding CanChangeSelection}"/>
    </StackPanel>
    <TextBlock Text="No hay categorías para administrar." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <Border Style="{StaticResource SoftPanel}">
      <StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Nombre de categoría" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="CategoryNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre de categoría" MaxLength="120" IsEnabled="{Binding CanEdit}"/>
        </StackPanel>
        <CheckBox Content="Categoría activa" IsChecked="{Binding Active}" IsEnabled="{Binding CanSetActive}"/>
        <TextBlock Text="Las categorías nuevas se crean activas. Desactivar conserva la categoría y su historial." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
    <Button Content="Descartar cambios" Command="{Binding DiscardChangesCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
  </StackPanel>
</UserControl>
