<UserControl x:Class="GoDental.Wpf.Views.Inventory.CategoryDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Background="{DynamicResource TintBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,12">
      <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
    </Border>
    <TextBlock Text="Selecciona una categoría para cambiar su nombre o estado." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <Label Content="Categoría" Target="{Binding ElementName=CategoryInput}"/>
    <ComboBox x:Name="CategoryInput" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" IsEnabled="{Binding CanChangeSelection}" AutomationProperties.Name="Categoría a administrar"/>
    <TextBlock Text="No hay categorías para administrar." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
    <Label Content="Nombre" Target="{Binding ElementName=CategoryNameInput}" Margin="0,12,0,0"/>
    <TextBox x:Name="CategoryNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Nombre de categoría" IsEnabled="{Binding CanEdit}"/>
    <CheckBox Content="Categoría activa" IsChecked="{Binding Active}" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}"/>
    <Button Content="Descartar cambios del formulario" Command="{Binding DiscardChangesCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </StackPanel>
</UserControl>
