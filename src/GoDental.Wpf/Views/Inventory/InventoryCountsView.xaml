<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Inventory.InventoryCountsView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Inventory.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <ProgressBar Style="{StaticResource InlineLoadingIndicator}" IsIndeterminate="True" Height="3" AutomationProperties.Name="Cargando conteos"/>
    <StackPanel Style="{StaticResource MasterListPanel}">
      <DockPanel Margin="0,0,0,20">
        <Button DockPanel.Dock="Right" Content="Abrir conteo" Tag="" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryActionButton}" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Conteos de inventario" Style="{StaticResource Heading}"/>
          <TextBlock Text="Verifica cantidades físicas y revisa las diferencias antes de aplicarlas." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <Border Style="{StaticResource FilterPanel}" Margin="0,0,0,16">
        <WrapPanel IsEnabled="{Binding IsNotBusy}">
          <StackPanel Width="230" Margin="0,0,16,0">
            <TextBlock Text="Almacén" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" AutomationProperties.Name="Filtrar conteos por almacén"/>
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,16,0">
            <TextBlock Text="Estado" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" AutomationProperties.Name="Estado del conteo"/>
          </StackPanel>
          <Button Content="Buscar" Command="{Binding SearchCommand}" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
          <Button Content="" Style="{StaticResource InventoryIconButton}" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" ToolTip="Actualizar conteos" AutomationProperties.Name="Actualizar conteos"/>
        </WrapPanel>
      </Border>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
      <Grid>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="300">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource InventoryCell}"/>
            <DataGridTextColumn Header="Almacén" Binding="{Binding Warehouse}" Width="*" ElementStyle="{StaticResource InventoryCell}"/>
            <DataGridTemplateColumn Header="Estado" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource InventoryState}" Tag="{Binding State}">
                    <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Apertura" Binding="{Binding Opened, StringFormat=dd/MM/yyyy HH:mm}" Width="155" ElementStyle="{StaticResource InventoryCell}"/>
            <DataGridTextColumn Header="Autor" Binding="{Binding CreatedBy}" Width="140" ElementStyle="{StaticResource InventoryCell}"/>
            <DataGridTextColumn Header="Guardadas" Binding="{Binding CountedLines, StringFormat={}{0:0.####}}" Width="100" ElementStyle="{StaticResource InventoryNumber}"/>
            <DataGridTextColumn Header="Total" Binding="{Binding TotalLines, StringFormat={}{0:0.####}}" Width="70" ElementStyle="{StaticResource InventoryNumber}"/>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource InventoryEmpty}" Tag="{Binding Items.Count}" Content="No hay conteos con estos filtros. Ajusta la búsqueda o abre un conteo."/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <Button Content="Ver detalle" Command="{Binding OpenCommand}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <Button Content="‹" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
            <Button Content="›" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
          </StackPanel>
          <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
      </DockPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Content="Guardar cantidades" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryActionButton}" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="Actualizar detalle" Command="{Binding RefreshDetailCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding IsNotBusy}" Margin="16,0,0,0"/>
        <Button Content="Volver a conteos" Tag="" Command="{Binding ReturnToListCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" IsEnabled="{Binding IsNotBusy}"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,20">
        <Border Style="{StaticResource InventoryIdentitySymbol}" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="{Binding Header.Id, StringFormat=Conteo #{0}}" Style="{StaticResource Heading}" Margin="0,0,12,4"/>
            <Border Style="{StaticResource InventoryState}" Tag="{Binding Header.State}" VerticalAlignment="Center">
              <TextBlock Text="{Binding Header.State}" FontSize="11"/>
            </Border>
          </WrapPanel>
          <TextBlock Text="{Binding Header.Warehouse}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
      <UniformGrid Columns="3" Margin="0,0,-12,16">
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Líneas del conteo" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Header.TotalLines, StringFormat={}{0:0.####}, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Cantidades guardadas" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Header.CountedLines, StringFormat={}{0:0.####}, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource SuccessBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Pendientes" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding PendingLines, StringFormat={}{0:0.####}, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource WarningBrush}"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Style="{StaticResource SoftPanel}" Visibility="{Binding RequiresRecount, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
        <TextBlock Text="Hubo movimientos posteriores a la apertura. Revisa el Kardex, cancela este conteo y abre uno nuevo." Foreground="{DynamicResource DangerBrush}"/>
      </Border>
      <TabControl>
        <TabItem Header="Captura" Style="{StaticResource InventoryTab}">
          <StackPanel Margin="0,20,0,0">
            <DockPanel Margin="0,0,0,16">
              <Button Content="Descartar captura" Command="{Binding DiscardCaptureCommand}" Style="{StaticResource ActionButton}" Margin="16,0,0,0" DockPanel.Dock="Right" IsEnabled="{Binding CanEdit}"/>
              <StackPanel Margin="0">
                <TextBlock Text="Captura de cantidades" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Una celda vacía está pendiente. Introducir 0 registra una cantidad física de cero." Style="{StaticResource MutedText}"/>
              </StackPanel>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Height="260" RowHeight="48">
              <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Header="SKU" Binding="{Binding Data.Sku}" Width="110" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn IsReadOnly="True" Header="Producto" Binding="{Binding Data.Product}" Width="*" MinWidth="180" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn IsReadOnly="True" Header="Lote" Binding="{Binding Data.Lot}" Width="110" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn IsReadOnly="True" Header="Sistema" Binding="{Binding Data.SystemQuantity, StringFormat={}{0:0.####}}" Width="95" ElementStyle="{StaticResource InventoryNumber}"/>
                <DataGridTemplateColumn Header="Cantidad física" Width="140">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="Cantidad física; vacío significa pendiente"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn IsReadOnly="True" Header="Diferencia" Binding="{Binding Difference}" Width="110" ElementStyle="{StaticResource InventoryNumber}"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="Cierre y cancelación" Style="{StaticResource InventoryTab}">
          <StackPanel Margin="0,20,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Finalizar el conteo" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Guarda las cantidades y revisa las diferencias antes de cerrar. Cancelar conserva el historial." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <StackPanel IsEnabled="{Binding CanEdit}">
              <StackPanel Margin="0,0,16,16">
                <TextBlock Text="Motivo del cierre o cancelación" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo del cierre o cancelación" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
              <CheckBox Content="Confirmo el cierre o la cancelación del conteo mostrado" IsChecked="{Binding Confirmed}" Margin="0,0,0,20"/>
              <WrapPanel HorizontalAlignment="Right">
                <Button Content="Cancelar conteo" Command="{Binding CancelCommand}" Style="{StaticResource DestructiveActionButton}" Margin="0,0,8,0"/>
                <Button Content="Cerrar y aplicar" Command="{Binding CloseCommand}" IsEnabled="{Binding CanClose}" Style="{StaticResource PrimaryActionButton}" ToolTip="Cerrar el conteo y aplicar las diferencias de inventario"/>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </StackPanel>
</UserControl>
