<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Inventory.InventoryCountsView">
  <StackPanel>
    <TextBlock Text="CONTEOS FÍSICOS" Style="{StaticResource PageEyebrow}"/>
    <TextBlock Text="Verificar inventario" Style="{StaticResource Heading}"/>
    <TextBlock Text="Abre un conteo, captura cantidades y revisa diferencias antes de aplicarlas." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <StackPanel Width="230" Margin="0,0,12,12">
        <TextBlock Text="Almacén"/>
        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" AutomationProperties.Name="Filtrar conteos por almacén"/>
      </StackPanel>
      <StackPanel Width="170" Margin="0,0,12,12">
        <TextBlock Text="Estado"/>
        <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" AutomationProperties.Name="Estado del conteo"/>
      </StackPanel>
      <Button Content="Buscar" Command="{Binding SearchCommand}" Margin="0,0,8,8"/>
      <Button Content="Actualizar" Command="{Binding ReloadCommand}" Margin="0,0,8,8"/>
      <Button Content="Abrir conteo…" Command="{Binding StartCommand}" Margin="0,0,8,8" Visibility="{Binding CanRead, Converter={StaticResource BoolToVisibility}}"/>
    </WrapPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="No hay conteos para mostrar." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" Margin="0,0,0,12" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60"/>
        <DataGridTextColumn Header="Almacén" Binding="{Binding Warehouse}" Width="*"/>
        <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/>
        <DataGridTextColumn Header="Apertura" Binding="{Binding Opened}" Width="170"/>
        <DataGridTextColumn Header="Autor" Binding="{Binding CreatedBy}" Width="120"/>
        <DataGridTextColumn Header="Capturadas" Binding="{Binding CountedLines}" Width="90"/>
        <DataGridTextColumn Header="Total" Binding="{Binding TotalLines}" Width="60"/>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <Button Content="Anterior" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
      <Button Content="Siguiente" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
      <Button Content="Ver detalle / Recargar" Command="{Binding OpenCommand}" Margin="0,0,8,8"/>
      <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center"/>
    </WrapPanel>
    <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource SectionHeading}" Margin="0,16,0,8"/>
    <TextBlock Text="Hubo movimientos posteriores a la apertura. Revisa los movimientos, cancela este conteo y abre uno nuevo." Style="{StaticResource MutedText}" Visibility="{Binding RequiresRecount, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"/>
    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" Height="240" Margin="0,0,0,12">
      <DataGrid.Columns>
        <DataGridTextColumn IsReadOnly="True" Header="SKU" Binding="{Binding Data.Sku}" Width="110"/>
        <DataGridTextColumn IsReadOnly="True" Header="Producto" Binding="{Binding Data.Product}" Width="*"/>
        <DataGridTextColumn IsReadOnly="True" Header="Lote" Binding="{Binding Data.Lot}" Width="100"/>
        <DataGridTextColumn IsReadOnly="True" Header="Sistema" Binding="{Binding Data.SystemQuantity}" Width="95"/>
        <DataGridTemplateColumn Header="Cantidad física" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="Cantidad física; vacío significa pendiente"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn IsReadOnly="True" Header="Diferencia" Binding="{Binding Difference}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Visibility="{Binding CanRead, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEdit}">
      <Button Content="Guardar cantidades" Command="{Binding CaptureCommand}" Margin="0,0,8,8"/>
      <StackPanel Width="450" Margin="0,0,16,12">
        <TextBlock Text="Motivo del cierre o cancelación" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo del cierre o cancelación"/>
      </StackPanel>
      <CheckBox Content="Confirmo el cierre o la cancelación del conteo mostrado en el detalle" IsChecked="{Binding Confirmed}" Margin="0,6,16,12"/>
      <WrapPanel>
        <Button Content="Cerrar y aplicar diferencias" Command="{Binding CloseCommand}" Margin="0,0,8,8" Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Cancelar conteo" Command="{Binding CancelCommand}" Margin="0,0,8,8"/>
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
