<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Inventory.InventoryMovementDialogView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Inventory.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="{Binding Product.Name}" Style="{StaticResource SectionHeading}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Product.Sku}" Style="{StaticResource MutedText}"/>
          <TextBlock Text=" · " Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Warehouse.Name}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <StackPanel IsEnabled="{Binding CanWrite}">
      <TabControl>
        <TabItem Header="Movimiento" Style="{StaticResource InventoryTab}">
          <StackPanel Margin="0,20,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Datos del movimiento" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Cantidad positiva para entradas; negativa para bajas y transferencias." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <UniformGrid Columns="2" Margin="0,0,-16,0">
              <StackPanel Margin="0,0,16,16">
                <TextBlock Text="Tipo de movimiento" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="MovementTypeInput" ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding MovementType}" AutomationProperties.Name="Tipo de movimiento"/>
              </StackPanel>
              <StackPanel Margin="0,0,16,16">
                <TextBlock Text="Cantidad (+ / −)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="QuantityInput" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad (+ / −)"/>
              </StackPanel>
              <StackPanel Margin="0,0,16,16">
                <TextBlock Text="Costo USD (entrada)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UnitCostInput" Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Costo USD (entrada)"/>
              </StackPanel>
              <StackPanel Visibility="{Binding IsTransfer, Converter={StaticResource BoolToVisibility}}" Margin="0,0,16,16">
                <TextBlock Text="Destino (transferencia)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DestinationInput" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Destination}" DisplayMemberPath="Name" AutomationProperties.Name="Destino (transferencia)"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </TabItem>
        <TabItem Visibility="{Binding TracksLot, Converter={StaticResource BoolToVisibility}}" Header="Lote y vencimiento" Style="{StaticResource InventoryTab}">
          <StackPanel Margin="0,20,0,0">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Lote de la operación" Style="{StaticResource SectionHeading}"/>
              <TextBlock Text="Selecciona un lote existente o registra uno nuevo con una entrada." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Lote existente" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="LotInput" ItemsSource="{Binding Lots}" SelectedItem="{Binding SelectedLot}" AutomationProperties.Name="Lote existente" DisplayMemberPath="Number"/>
            </StackPanel>
            <CheckBox Content="Registrar un lote nuevo con esta entrada" IsChecked="{Binding CreateLot}" Margin="0,0,0,16"/>
            <StackPanel Visibility="{Binding CreateLot, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Margin="0,0,16,16">
                <TextBlock Text="Número de lote" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LotNumberInput" Text="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Número de lote" MaxLength="100"/>
              </StackPanel>
              <UniformGrid Columns="2" Margin="0,0,-16,0">
                <StackPanel Margin="0,0,16,16">
                  <TextBlock Text="Fabricación (opcional)" Style="{StaticResource FieldLabel}"/>
                  <DatePicker x:Name="ManufacturedInput" SelectedDate="{Binding Manufactured}" AutomationProperties.Name="Fabricación (opcional)"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,16">
                  <TextBlock Text="Vencimiento" Style="{StaticResource FieldLabel}"/>
                  <DatePicker x:Name="ExpiryInput" SelectedDate="{Binding Expires}" AutomationProperties.Name="Vencimiento"/>
                </StackPanel>
              </UniformGrid>
            </StackPanel>
            <Border Style="{StaticResource SoftPanel}">
              <StackPanel>
                <TextBlock Text="Estado del lote" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Usa el motivo y la confirmación de abajo antes de bloquear o reactivar el lote seleccionado." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <Button Content="Bloquear / reactivar" Command="{Binding ToggleLotCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
        <StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Motivo obligatorio" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ReasonInput" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo obligatorio" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" VerticalScrollBarVisibility="Auto" MaxLength="500"/>
          </StackPanel>
          <CheckBox Content="Verifiqué producto, almacén, lote, cantidad y motivo de esta operación." IsChecked="{Binding Confirmed}" Margin="0,0,0,12"/>
          <TextBlock Text="Los movimientos confirmados se corrigen mediante otro movimiento con su motivo." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
