<UserControl x:Class="GoDental.Wpf.Views.Inventory.ProductsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Inventory">
  <StackPanel>
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers><DataTrigger Binding="{Binding Inventory.IsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
      </StackPanel.Style>
    <DockPanel>
      <WrapPanel DockPanel.Dock="Right" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
        <Button Content="Administrar categorías" Command="{Binding ManageCategoriesCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0" />
        <Button Content="Editar seleccionado" Command="{Binding EditSelectedCommand}" IsEnabled="{Binding CanEditSelected}" Margin="0,0,8,0" />
        <Button Content="Nuevo producto" Command="{Binding NewProductCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryButton}" />
      </WrapPanel>
      <TextBlock Text="Inventario" Style="{StaticResource Heading}" />
    </DockPanel>
    <TextBlock Text="Tu catálogo, precios de referencia y existencias disponibles." Style="{StaticResource MutedText}" Margin="0,0,0,20" />
    <Border Background="{DynamicResource TintBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
      <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <Border Style="{StaticResource Card}" Padding="16">
      <StackPanel>
        <Grid IsEnabled="{Binding IsNotBusy}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <Label Content="Buscar por SKU, nombre o código de barras" Target="{Binding ElementName=SearchInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,6" />
            <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="200">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
            <Button Content="Buscar" Command="{Binding SearchCommand}" Margin="0,0,8,0" />
            <Button Content="Actualizar" Command="{Binding ReloadCommand}" />
          </WrapPanel>
        </Grid>
        <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
          <StackPanel Width="200" Margin="0,0,12,0"><Label Content="Categoría" Target="{Binding ElementName=CategoryFilterInput}"/><ComboBox x:Name="CategoryFilterInput" ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}" DisplayMemberPath="Name" AutomationProperties.Name="Filtro de categoría"/></StackPanel>
          <StackPanel Width="200" Margin="0,0,12,0"><Label Content="Marca" Target="{Binding ElementName=BrandFilterInput}"/><ComboBox x:Name="BrandFilterInput" ItemsSource="{Binding Brands}" SelectedItem="{Binding FilterBrand}" DisplayMemberPath="Name" AutomationProperties.Name="Filtro de marca"/></StackPanel>
          <Button Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <CheckBox Content="Sólo stock bajo" IsChecked="{Binding LowStockOnly}" Margin="0,12,0,0"/>
        <CheckBox Content="Incluir productos inactivos" IsChecked="{Binding IncludeInactive}" Margin="0,12,0,12" IsEnabled="{Binding IsNotBusy}" />
        <Button Content="Ver existencias, lotes y movimientos" Command="{Binding OpenInventoryCommand}" IsEnabled="{Binding CanOpenInventory}" HorizontalAlignment="Left" Margin="0,0,0,12" />
        <DataGrid MouseDoubleClick="OnProductDoubleClick" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="280" SelectionMode="Single" EnableRowVirtualization="True" AutomationProperties.Name="Catálogo de productos">
          <DataGrid.Columns>
            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
            <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="150" />
            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120" />
            <DataGridTextColumn Header="Precio USD" Binding="{Binding Price, StringFormat={}{0:0.00}}" Width="100" />
            <DataGridTextColumn Header="Disponible físico" Binding="{Binding AvailableStock, StringFormat={}{0:0.####}}" Width="95" />
            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Sin productos para estos filtros." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
        <DockPanel Margin="0,12,0,0">
          <WrapPanel DockPanel.Dock="Right" IsEnabled="{Binding IsNotBusy}">
            <Button Content="Anterior" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
            <Button Content="Siguiente" Command="{Binding NextCommand}" />
          </WrapPanel>
          <StackPanel>
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" />
            <TextBlock Text="Stock total de almacenes activos. No se modifica desde el catálogo." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,8,0" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    </StackPanel>
    <local:InventoryView DataContext="{Binding Inventory}" Visibility="{Binding Inventory.IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
  </StackPanel>
</UserControl>
