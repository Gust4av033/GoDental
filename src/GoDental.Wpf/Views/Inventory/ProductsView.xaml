<UserControl x:Class="GoDental.Wpf.Views.Inventory.ProductsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GoDental.Wpf.Views.Inventory">
  <StackPanel>
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers><DataTrigger Binding="{Binding Inventory.IsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
      </StackPanel.Style>
    <DockPanel>
      <WrapPanel DockPanel.Dock="Right" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
        <Button Content="Editar seleccionado" Command="{Binding EditSelectedCommand}" IsEnabled="{Binding CanEditSelected}" Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
        <Button Tag="&#xE710;" Content="Nuevo producto" Command="{Binding NewProductCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryActionButton}" />
      </WrapPanel>
      <StackPanel>
        <TextBlock Text="Productos" Style="{StaticResource Heading}" />
      </StackPanel>
    </DockPanel>
    <TextBlock Text="Administra tu catálogo, precios de referencia y existencias disponibles." Style="{StaticResource MutedText}" Margin="0,0,0,16" />
    <Border Background="{DynamicResource TintBrush}" Padding="12" CornerRadius="{StaticResource CardRadius}" Margin="0,0,0,16">
      <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <Border Style="{StaticResource Card}" Padding="16">
      <StackPanel>
        <Grid IsEnabled="{Binding IsNotBusy}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <Label Content="Buscar por SKU, nombre o código de barras" Target="{Binding ElementName=SearchInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,6" />
            <TextBox Style="{StaticResource SearchBox}" Tag="Buscar…" x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="200">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
            <Button Tag="&#xE721;" Content="Buscar" Command="{Binding SearchCommand}" Margin="0,0,8,0" />
            <Button Tag="&#xE72C;" Content="Actualizar" Command="{Binding ReloadCommand}" />
          </WrapPanel>
        </Grid>
        <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
          <StackPanel Width="200" Margin="0,0,12,0"><Label Content="Categoría" Target="{Binding ElementName=CategoryFilterInput}"/><ComboBox x:Name="CategoryFilterInput" ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}" DisplayMemberPath="Name" AutomationProperties.Name="Filtro de categoría"/></StackPanel>
          <StackPanel Width="200" Margin="0,0,12,0"><Label Content="Marca" Target="{Binding ElementName=BrandFilterInput}"/><ComboBox x:Name="BrandFilterInput" ItemsSource="{Binding Brands}" SelectedItem="{Binding FilterBrand}" DisplayMemberPath="Name" AutomationProperties.Name="Filtro de marca"/></StackPanel>
          <Button Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <WrapPanel Margin="0,12,0,12" IsEnabled="{Binding IsNotBusy}">
          <CheckBox Content="Sólo stock bajo" IsChecked="{Binding LowStockOnly}" Margin="0,0,24,0" VerticalAlignment="Center"/>
          <CheckBox Content="Incluir productos inactivos" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center"/>
        </WrapPanel>
        <Button Content="Ver existencias, lotes y movimientos" Command="{Binding OpenInventoryCommand}" IsEnabled="{Binding CanOpenInventory}" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding ShowCatalogTable, Converter={StaticResource BoolToVisibility}}" />
        <Border Background="{DynamicResource TintBrush}" CornerRadius="{StaticResource CardRadius}" Padding="24" Margin="0,0,0,12" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <StackPanel HorizontalAlignment="Center" MaxWidth="480">
            <TextBlock Text="Todavía no hay productos para mostrar" Style="{StaticResource SectionHeading}" TextAlignment="Center"/>
            <TextBlock Text="Prueba otros filtros, actualiza el catálogo o registra un producto nuevo." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Tag="&#xE710;" Content="Nuevo producto" Command="{Binding NewProductCommand}" Style="{StaticResource PrimaryActionButton}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource TintBrush}" CornerRadius="{StaticResource CardRadius}" Padding="24" Margin="0,0,0,12" Visibility="{Binding ShowErrorState, Converter={StaticResource BoolToVisibility}}">
          <StackPanel HorizontalAlignment="Center" MaxWidth="480">
            <TextBlock Text="No se pudo cargar el catálogo" Style="{StaticResource SectionHeading}" TextAlignment="Center"/>
            <TextBlock Text="Revisa el mensaje anterior y vuelve a intentarlo." Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="Reintentar" Command="{Binding ReloadCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
        <DataGrid MouseDoubleClick="OnProductDoubleClick" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="280" SelectionMode="Single" EnableRowVirtualization="True" AutomationProperties.Name="Catálogo de productos" Visibility="{Binding ShowCatalogTable, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
            <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="150" />
            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120" />
            <DataGridTextColumn Header="Precio USD" Binding="{Binding Price, StringFormat={}{0:0.00}}" Width="100" />
            <DataGridTextColumn Header="Disponible físico" Binding="{Binding AvailableStock, StringFormat={}{0:0.####}}" Width="95" />
            <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <DockPanel Margin="0,12,0,0" Visibility="{Binding ShowCatalogTable, Converter={StaticResource BoolToVisibility}}">
          <WrapPanel DockPanel.Dock="Right" IsEnabled="{Binding IsNotBusy}">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" />
          </WrapPanel>
          <StackPanel>
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" />
            <TextBlock Text="Stock total de almacenes activos. No se modifica desde el catálogo." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,8,0" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    </StackPanel>
    <local:InventoryView DataContext="{Binding Inventory}" Visibility="{Binding Inventory.IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
  </StackPanel>
</UserControl>
