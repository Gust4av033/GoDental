<UserControl x:Class="GoDental.Wpf.Views.Inventory.ProductsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DockPanel>
      <WrapPanel DockPanel.Dock="Right" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
        <Button Content="Editar seleccionado" Command="{Binding EditSelectedCommand}" Click="FocusEditor" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0" />
        <Button Content="Nuevo producto" Command="{Binding NewProductCommand}" Click="FocusEditor" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryButton}" />
      </WrapPanel>
      <TextBlock Text="Productos" Style="{StaticResource Heading}" />
    </DockPanel>
    <TextBlock Text="Tu catálogo, precios de referencia y existencias disponibles." Style="{StaticResource MutedText}" Margin="0,0,0,20" />
    <Border Background="{DynamicResource TintBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
      <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <Border Style="{StaticResource Card}" Padding="16">
      <StackPanel>
        <Grid IsEnabled="{Binding IsNotBusy}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <Label Content="Buscar por SKU, nombre o código de barras" Target="{Binding ElementName=SearchInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,6" />
            <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="200">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
            <Button Content="Buscar" Command="{Binding SearchCommand}" Margin="0,0,8,0" />
            <Button Content="Actualizar" Command="{Binding ReloadCommand}" />
          </WrapPanel>
        </Grid>
        <CheckBox Content="Incluir productos inactivos" IsChecked="{Binding IncludeInactive}" Margin="0,12,0,12" IsEnabled="{Binding IsNotBusy}" />
        <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="280" SelectionMode="Single" EnableRowVirtualization="True" AutomationProperties.Name="Catálogo de productos">
          <DataGrid.Columns>
            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
            <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="150" />
            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120" />
            <DataGridTextColumn Header="Precio USD" Binding="{Binding Price, StringFormat={}{0:0.00}}" Width="100" />
            <DataGridTextColumn Header="Disponible" Binding="{Binding AvailableStock, StringFormat={}{0:0.####}}" Width="95" />
            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Sin productos para estos filtros." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
        <DockPanel Margin="0,12,0,0">
          <WrapPanel DockPanel.Dock="Right" IsEnabled="{Binding IsNotBusy}">
            <Button Content="Anterior" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
            <Button Content="Siguiente" Command="{Binding NextCommand}" />
          </WrapPanel>
          <StackPanel>
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" />
            <TextBlock Text="Stock total de almacenes activos. No se modifica desde el catálogo." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,8,0" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    <Border x:Name="EditorPanel" Style="{StaticResource Card}" Margin="0,20,0,0" IsEnabled="{Binding CanEdit}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel Margin="0,0,0,16">
          <WrapPanel DockPanel.Dock="Right">
            <Button Content="Nuevo / limpiar" Command="{Binding NewProductCommand}" Margin="0,0,8,0" />
            <Button Content="Editar seleccionado" Command="{Binding EditSelectedCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionHeading}" />
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="SKU *" Target="{Binding ElementName=SkuInput}" />
            <TextBox x:Name="SkuInput" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />
            <Label Content="Nombre *" Target="{Binding ElementName=ProductNameInput}" Margin="0,8,0,0" />
            <TextBox x:Name="ProductNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
            <Label Content="Categoría *" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding Category}" AutomationProperties.Name="Categoría" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="Nombre de nueva categoría" AutomationProperties.Name="Nueva categoría" />
              <Button Grid.Column="1" Content="Crear categoría" Command="{Binding CreateCategoryCommand}" Margin="8,0,0,0" />
            </Grid>
            <Label Content="Marca" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="Name" SelectedItem="{Binding Brand}" AutomationProperties.Name="Marca" />
            <Label Content="Descripción" Margin="0,8,0,0" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" AutomationProperties.Name="Descripción" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Unidad de medida *" />
            <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name" SelectedItem="{Binding Unit}" AutomationProperties.Name="Unidad de medida" />
            <Label Content="Precio de referencia USD *" Margin="0,8,0,0" />
            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Precio de referencia" />
            <TextBlock Text="Usa punto decimal; por ejemplo, 12.50." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
            <Label Content="Stock mínimo" Margin="0,8,0,0" />
            <TextBox Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stock mínimo" />
            <Label Content="Stock máximo (opcional)" Margin="0,8,0,0" />
            <TextBox Text="{Binding MaximumStock, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stock máximo" />
            <CheckBox Content="Controla lotes" IsChecked="{Binding TracksLot}" Margin="0,16,0,0" />
            <CheckBox Content="Controla vencimiento" IsChecked="{Binding TracksExpiry}" Margin="0,12,0,0" />
            <CheckBox Content="Producto activo" IsChecked="{Binding Active}" Margin="0,12,0,0" />
            <Button Content="Guardar producto" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,24,0,0" />
            <TextBlock Text="Desactivar conserva el historial. Guardar no ingresa ni ajusta existencias." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>