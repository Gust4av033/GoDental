<UserControl x:Class="GoDental.Wpf.Views.Inventory.BarcodesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:operations="clr-namespace:GoDental.Wpf.Views.Operations">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="Códigos de barras" Style="{StaticResource SectionHeading}"/>
    <TextBlock Text="Registra códigos externos o genera el código interno para buscar el producto al vender." Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
    <WrapPanel>
      <Button Content="Actualizar códigos" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource ActionButton}" Margin="0,0,8,8"/>
      <Button Content="Agregar código" Command="{Binding AddCommand}" IsEnabled="{Binding CanManage}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8"/>
      <Button Content="Activar / desactivar" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Style="{StaticResource ActionButton}" Margin="0,0,0,8"/>
    </WrapPanel>
    <ProgressBar Style="{StaticResource InlineLoadingIndicator}" IsIndeterminate="True" Height="3"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,12"/>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="160" MaxHeight="300" AutomationProperties.Name="Códigos de barras del producto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="*" MinWidth="140"/>
        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="90"/>
        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active}" Width="65"/>
        <DataGridCheckBoxColumn Header="Interno" Binding="{Binding Generated}" Width="65"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="Etiquetas imprimibles" Style="{StaticResource SectionHeading}" Margin="0,16,0,0"/>
    <TextBlock Text="Selecciona un código activo. OTRO necesita una simbología definida. Las barras se muestran al generar la vista previa." Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <StackPanel Width="140" Margin="0,0,8,8"><TextBlock Text="Etiqueta" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PrintSettings.Presets}" SelectedItem="{Binding PrintSettings.Preset}" AutomationProperties.Name="Tamaño de etiqueta"/></StackPanel>
      <StackPanel Width="110" Margin="0,0,8,8"><TextBlock Text="Papel" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PrintSettings.Papers}" SelectedItem="{Binding PrintSettings.Paper}" AutomationProperties.Name="Papel de etiquetas"/></StackPanel>
      <StackPanel Width="90" Margin="0,0,8,8"><TextBlock Text="Ancho (mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Width, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Ancho de etiqueta en milímetros"/></StackPanel>
      <StackPanel Width="90" Margin="0,0,8,8"><TextBlock Text="Alto (mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Height, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Alto de etiqueta en milímetros"/></StackPanel>
      <StackPanel Width="75" Margin="0,0,8,8"><TextBlock Text="Copias" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Copies, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="Cantidad de etiquetas"/></StackPanel>
      <StackPanel Width="100" Margin="0,0,8,8"><TextBlock Text="Margen hoja (mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Margin, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Margen de hoja de etiquetas"/></StackPanel>
      <StackPanel Width="100" Margin="0,0,8,8"><TextBlock Text="Separación (mm)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PrintSettings.Gap, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Separación entre etiquetas"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="Etiqueta: una por página, sin papel fijo. Carta/A4: columnas automáticas según medidas, margen y separación. No se reduce el código para hacerlo caber." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
    <Button Content="Ver etiquetas" Command="{Binding PreviewReceiptCommand}" IsEnabled="{Binding CanPreview}" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
    <operations:ReceiptPreviewView Visibility="{Binding IsReceiptPreviewOpen, Converter={StaticResource BoolToVisibility}}"/>
    <operations:OperationStatusView DataContext="{Binding Operation}"/>
  </StackPanel>
</UserControl>
