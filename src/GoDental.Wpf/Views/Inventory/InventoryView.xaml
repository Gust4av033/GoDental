<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Inventory.InventoryView" x:Name="InventoryRoot" xmlns:operations="clr-namespace:GoDental.Wpf.Views.Operations">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Inventory.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
        <Button Content="Editar producto" Command="{Binding EditProductCommand, ElementName=InventoryRoot}" Visibility="{Binding CanEditProduct, ElementName=InventoryRoot, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
        <Button Content="Existencias iniciales" Command="{Binding OpenInitialInventoryCommand}" IsEnabled="{Binding CanInitialize}" Visibility="{Binding CanOfferInitial, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"/>
        <Button Content="Registrar movimiento" Command="{Binding OpenMovementDialogCommand}" IsEnabled="{Binding CanWrite}" Visibility="{Binding CanAdjust, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource PrimaryActionButton}"/>
      </StackPanel>
      <Button Content="Volver a productos" Tag="" Style="{StaticResource TextButton}" Command="{Binding CloseCommand}" IsEnabled="{Binding IsNotBusy}" HorizontalAlignment="Left"/>
    </DockPanel>
    <DockPanel Margin="0,0,0,20">
      <Border Style="{StaticResource InventoryIdentitySymbol}" DockPanel.Dock="Left" Margin="0,0,12,0">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel>
        <WrapPanel>
          <TextBlock Text="{Binding Product.Name}" Style="{StaticResource SectionHeading}" FontSize="18" Margin="0,0,12,4"/>
          <ContentControl Content="{Binding Product.Active}" ContentTemplate="{StaticResource ActiveBadge}" VerticalAlignment="Center"/>
        </WrapPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Product.Sku}" Style="{StaticResource MutedText}"/>
          <TextBlock Text=" · " Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding Product.Category}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cargando inventario"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <operations:OperationStatusView DataContext="{Binding InitialInventory.Operation}"/>
    <DockPanel Margin="0,0,0,16" IsEnabled="{Binding IsNotBusy}">
      <Button DockPanel.Dock="Right" Content="Actualizar" Tag="" Command="{Binding ReloadCommand}" Style="{StaticResource ActionButton}" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
      <StackPanel>
        <TextBlock Text="Almacén de operación" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="WarehouseInput" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" AutomationProperties.Name="Almacén de operación" MaxWidth="340" HorizontalAlignment="Left" MinWidth="220"/>
      </StackPanel>
    </DockPanel>
    <TabControl IsEnabled="{Binding IsNotBusy}">
      <TabItem Header="Ficha del producto" Style="{StaticResource InventoryTab}">
        <StackPanel Margin="0,20,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Ficha del producto" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Datos del catálogo y configuración de trazabilidad." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <UniformGrid Columns="2" Margin="0,0,-16,0">
            <ContentControl Style="{StaticResource InventoryField}" Tag="Nombre" Content="{Binding Product.Name}"/>
            <ContentControl Style="{StaticResource InventoryField}" Tag="Categoría" Content="{Binding Product.Category}"/>
            <ContentControl Style="{StaticResource InventoryField}" Tag="Unidad de medida" Content="{Binding Product.Unit}"/>
            <ContentControl Style="{StaticResource InventoryField}" Tag="Precio de referencia USD" Content="{Binding Product.Price, Converter={StaticResource UsdMoney}}"/>
            <ContentControl Style="{StaticResource InventoryField}" Tag="Stock mínimo" Content="{Binding Product.MinimumStock}"/>
            <ContentControl Style="{StaticResource InventoryField}" Tag="Stock máximo" Content="{Binding Product.MaximumStock}"/>
          </UniformGrid>
          <ContentControl Style="{StaticResource InventoryField}" Tag="Descripción" Content="{Binding Product.Description}"/>
          <WrapPanel Margin="0,0,0,16">
            <TextBlock Text="Control de lotes" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ContentControl Content="{Binding Product.TracksLot}" ContentTemplate="{StaticResource InventoryYesNo}" Margin="0,0,24,0"/>
            <TextBlock Text="Control de vencimiento" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ContentControl Content="{Binding Product.TracksExpiry}" ContentTemplate="{StaticResource InventoryYesNo}"/>
          </WrapPanel>
          <ContentControl Style="{StaticResource InventoryField}" Tag="Días de alerta de vencimiento" Content="{Binding Product.ExpiryAlertDays}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Existencias" Style="{StaticResource InventoryTab}">
        <StackPanel Margin="0,20,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Existencias por almacén" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Físico, reservas y stock vendible del almacén seleccionado." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <UniformGrid Columns="4" Margin="0,0,-12,16">
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Físico" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding SelectedStock.Quantity, StringFormat={}{0:0.####}, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Reservado" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding SelectedStock.Reserved, StringFormat={}{0:0.####}, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource WarningBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Disponible físico" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding SelectedStock.Available, StringFormat={}{0:0.####}, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Vendible" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding SelectedStock.Sellable, StringFormat={}{0:0.####}, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource SuccessBrush}"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Text="El físico incluye lotes bloqueados o vencidos. El vendible los excluye y descuenta reservas." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
          <Grid>
            <DataGrid ItemsSource="{Binding Stocks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="190">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Almacén" Binding="{Binding Warehouse}" Width="*" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Físico" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="105" ElementStyle="{StaticResource InventoryNumber}"/>
                <DataGridTextColumn Header="Reservado" Binding="{Binding Reserved, StringFormat={}{0:0.####}}" Width="105" ElementStyle="{StaticResource InventoryNumber}"/>
                <DataGridTextColumn Header="Disponible físico" Binding="{Binding Available, StringFormat={}{0:0.####}}" Width="130" ElementStyle="{StaticResource InventoryNumber}"/>
                <DataGridTextColumn Header="Vendible" Binding="{Binding Sellable, StringFormat={}{0:0.####}}" Width="105" ElementStyle="{StaticResource InventoryNumber}"/>
              </DataGrid.Columns>
            </DataGrid>
            <ContentControl Style="{StaticResource InventoryEmpty}" Tag="{Binding Stocks.Count}" Content="No hay existencias para mostrar."/>
          </Grid>
          <Border Style="{StaticResource SoftPanel}" Margin="0,16,0,0" Visibility="{Binding CanSeeCosts, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Costos promedio por almacén" Style="{StaticResource FieldLabel}"/>
              <ItemsControl ItemsSource="{Binding Stocks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4,0,0">
                      <TextBlock Text="{Binding AverageCost, Converter={StaticResource InventoryCost}}" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Warehouse}" Style="{StaticResource MutedText}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="Lotes y vencimientos" Style="{StaticResource InventoryTab}">
        <StackPanel Margin="0,20,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Lotes y vencimientos" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Lotes del almacén seleccionado, ordenados por vencimiento." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <Grid>
            <DataGrid ItemsSource="{Binding Lots}" SelectedItem="{Binding SelectedLot}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="260">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Lote" Binding="{Binding Number}" Width="*" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Fabricación" Binding="{Binding Manufactured, StringFormat=dd/MM/yyyy}" Width="120" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Vencimiento" Binding="{Binding Expires, StringFormat=dd/MM/yyyy}" Width="120" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="105" ElementStyle="{StaticResource InventoryNumber}"/>
                <DataGridTemplateColumn Header="Estado" Width="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource InventoryState}" Tag="{Binding Status}">
                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="NoWrap"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <ContentControl Style="{StaticResource InventoryEmpty}" Tag="{Binding Lots.Count}" Content="No hay lotes registrados para este producto."/>
          </Grid>
          <TextBlock Text="El bloqueo conserva saldo e historial. Selecciona un lote para consultar su costo o registrar una operación." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
          <Border Style="{StaticResource SoftPanel}" Margin="0,16,0,0" Visibility="{Binding CanSeeCosts, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Costo histórico de ingreso del lote seleccionado" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding SelectedLot.EntryCost, Converter={StaticResource InventoryCost}}" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="Kardex" Style="{StaticResource InventoryTab}">
        <StackPanel Margin="0,20,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Kardex del producto" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Consulta movimientos, saldos y referencias de origen." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <Border Style="{StaticResource FilterPanel}" Margin="0,0,0,16">
            <StackPanel>
              <WrapPanel>
                <StackPanel Width="150" Margin="0,0,12,12">
                  <TextBlock Text="Desde" Style="{StaticResource FieldLabel}"/>
                  <DatePicker x:Name="FromInput" SelectedDate="{Binding From}" AutomationProperties.Name="Kardex desde"/>
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,12,12">
                  <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}"/>
                  <DatePicker x:Name="UntilInput" SelectedDate="{Binding Until}" AutomationProperties.Name="Kardex hasta"/>
                </StackPanel>
                <StackPanel Width="170" Margin="0,0,12,12">
                  <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="HistoryTypeInput" ItemsSource="{Binding HistoryTypes}" SelectedItem="{Binding HistoryType}" AutomationProperties.Name="Filtro tipo Kardex"/>
                </StackPanel>
                <Button Content="Filtrar" Command="{Binding SearchHistoryCommand}" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
              </WrapPanel>
              <CheckBox Content="Sólo el lote seleccionado" IsChecked="{Binding FilterSelectedLot}"/>
            </StackPanel>
          </Border>
          <Grid>
            <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="260">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Fecha (SV)" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="145" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTemplateColumn Header="Tipo" Width="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource InventoryState}" Tag="{Binding Type}">
                        <TextBlock Text="{Binding Type}" FontSize="11" TextWrapping="NoWrap"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Lote" Binding="{Binding Lot}" Width="110" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:+0.####;-0.####;0}}" Width="105" ElementStyle="{StaticResource InventoryMovementQuantity}"/>
                <DataGridTextColumn Header="Anterior" Binding="{Binding Before, StringFormat={}{0:0.####}}" Width="105" ElementStyle="{StaticResource InventoryNumber}"/>
                <DataGridTextColumn Header="Posterior" Binding="{Binding After, StringFormat={}{0:0.####}}" Width="105" ElementStyle="{StaticResource InventoryNumber}"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="130" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="140" ElementStyle="{StaticResource InventoryCell}"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="240" ElementStyle="{StaticResource InventoryCell}"/>
              </DataGrid.Columns>
            </DataGrid>
            <ContentControl Style="{StaticResource InventoryEmpty}" Tag="{Binding Movements.Count}" Content="No hay movimientos con estos filtros."/>
          </Grid>
          <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsNotBusy}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Button Content="‹" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Margin="0,0,6,0"/>
              <Button Content="›" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente"/>
            </StackPanel>
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
