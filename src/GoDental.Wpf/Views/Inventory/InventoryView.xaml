<UserControl x:Class="GoDental.Wpf.Views.Inventory.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Margin="0">
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Volver al catálogo" Command="{Binding CloseCommand}" IsEnabled="{Binding IsNotBusy}" />
        <StackPanel><TextBlock Text="EXISTENCIAS Y TRAZABILIDAD" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeading}" Margin="0,6,16,16" /></StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
      <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <Button Content="Registrar movimiento" Command="{Binding OpenMovementDialogCommand}" IsEnabled="{Binding CanWrite}" Visibility="{Binding CanAdjust, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
      <StackPanel IsEnabled="{Binding IsNotBusy}">
        <WrapPanel Margin="0,0,0,16">
          <StackPanel Width="250" Margin="0,0,12,0"><Label Content="Almacén de operación" Target="{Binding ElementName=WarehouseInput}"/><ComboBox x:Name="WarehouseInput" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" AutomationProperties.Name="Almacén de operación" /></StackPanel>
          <Button Content="Actualizar existencias" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" />
        </WrapPanel>
        <TabControl>
          <TabItem Header="Existencias">
            <StackPanel Margin="0,16,0,0">
              <TextBlock Text="El físico incluye lotes bloqueados o vencidos. El vendible los excluye y descuenta reservas." Style="{StaticResource MutedText}" Margin="0,0,0,12" />
              <DataGrid ItemsSource="{Binding Stocks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="190" AutomationProperties.Name="Existencias por almacén">
                <DataGrid.Columns><DataGridTextColumn Header="Almacén" Binding="{Binding Warehouse}" Width="*"/><DataGridTextColumn Header="Físico" Binding="{Binding Quantity, StringFormat={}{0:0.####}}"/><DataGridTextColumn Header="Reservado" Binding="{Binding Reserved, StringFormat={}{0:0.####}}"/><DataGridTextColumn Header="Disponible físico" Binding="{Binding Available, StringFormat={}{0:0.####}}"/><DataGridTextColumn Header="Vendible" Binding="{Binding Sellable, StringFormat={}{0:0.####}}"/></DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="No hay existencias para este almacén." Visibility="{Binding IsStocksEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
              <ItemsControl ItemsSource="{Binding Stocks}" Visibility="{Binding CanSeeCosts, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Warehouse}" Margin="0,0,12,0" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding AverageCost, StringFormat='Costo promedio USD {0:0.000000}'}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </TabItem>
          <TabItem Header="Lotes y vencimientos">
            <StackPanel Margin="0,16,0,0">
              <TextBlock Text="Lotes del almacén seleccionado, ordenados por vencimiento. El bloqueo conserva saldo e historial." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
              <DataGrid ItemsSource="{Binding Lots}" SelectedItem="{Binding SelectedLot}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="260" AutomationProperties.Name="Lotes y vencimientos">
                <DataGrid.Columns><DataGridTextColumn Header="Lote" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="Fabricación" Binding="{Binding Manufactured, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Vencimiento" Binding="{Binding Expires, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:0.####}}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="145"/></DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="No hay lotes para este almacén." Visibility="{Binding IsLotsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
              <TextBlock Text="{Binding SelectedLot.EntryCost, StringFormat='Costo histórico de ingreso USD {0:0.000000}'}" Visibility="{Binding CanSeeCosts, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Kardex">
            <StackPanel Margin="0,16,0,0">
              <WrapPanel><StackPanel Width="155" Margin="0,0,12,12"><Label Content="Desde" Target="{Binding ElementName=FromInput}"/><DatePicker x:Name="FromInput" SelectedDate="{Binding From}" AutomationProperties.Name="Kardex desde"/></StackPanel><StackPanel Width="155" Margin="0,0,12,12"><Label Content="Hasta" Target="{Binding ElementName=UntilInput}"/><DatePicker x:Name="UntilInput" SelectedDate="{Binding Until}" AutomationProperties.Name="Kardex hasta"/></StackPanel><StackPanel Width="165" Margin="0,0,12,12"><Label Content="Tipo" Target="{Binding ElementName=HistoryTypeInput}"/><ComboBox x:Name="HistoryTypeInput" ItemsSource="{Binding HistoryTypes}" SelectedItem="{Binding HistoryType}" AutomationProperties.Name="Filtro tipo Kardex"/></StackPanel><Button Content="Filtrar" Command="{Binding SearchHistoryCommand}" VerticalAlignment="Bottom" Margin="0,0,0,12"/></WrapPanel>
              <CheckBox Content="Sólo el lote seleccionado" IsChecked="{Binding FilterSelectedLot}" Margin="0,0,0,12"/>
              <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="280" AutomationProperties.Name="Kardex de producto">
                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}"/><DataGridTextColumn Header="Fecha (SV)" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}"/><DataGridTextColumn Header="Lote" Binding="{Binding Lot}"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:0.####}}"/><DataGridTextColumn Header="Anterior" Binding="{Binding Before, StringFormat={}{0:0.####}}"/><DataGridTextColumn Header="Posterior" Binding="{Binding After, StringFormat={}{0:0.####}}"/><DataGridTextColumn Header="Usuario" Binding="{Binding User}"/><DataGridTextColumn Header="Referencia" Binding="{Binding Reference}"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="240"/></DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="No hay movimientos con estos filtros." Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
              <DockPanel Margin="0,12,0,0"><WrapPanel DockPanel.Dock="Right"><Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,0"/><Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}"/></WrapPanel><TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}"/></DockPanel>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
