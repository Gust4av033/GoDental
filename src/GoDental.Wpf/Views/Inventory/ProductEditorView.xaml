<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Inventory.ProductEditorView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Inventory.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,20">
      <DockPanel>
        <Border Style="{StaticResource InventoryIdentitySymbol}" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeading}"/>
          <TextBlock Text="{Binding SkuDisplay}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl x:Name="EditorSections" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Secciones del producto">
      <TabItem Header="Información general" Style="{StaticResource InventoryTab}">
        <StackPanel Margin="0,20,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Identificación del producto" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Nombre, clasificación y unidad de venta." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <UniformGrid Columns="2" Margin="0,0,-16,0">
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Nombre *" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="ProductNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre *" MaxLength="200"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="SKU automático" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="SkuInput" Text="{Binding SkuDisplay, Mode=OneWay}" IsReadOnly="True" MaxLength="60" AutomationProperties.Name="SKU"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Categoría *" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="CategoryInput" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" AutomationProperties.Name="Categoría *"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Marca" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="BrandInput" ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" DisplayMemberPath="Name" AutomationProperties.Name="Marca"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Unidad de medida *" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="UnitInput" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" DisplayMemberPath="Name" AutomationProperties.Name="Unidad de medida *"/>
            </StackPanel>
            <CheckBox Content="Producto activo" IsChecked="{Binding Active}" Margin="0,20,0,16"/>
          </UniformGrid>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Descripción" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DescriptionInput" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descripción" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" VerticalScrollBarVisibility="Auto" MaxLength="1000"/>
          </StackPanel>
          <Expander Header="Crear una categoría" Margin="0,0,0,16">
            <Border Style="{StaticResource SoftPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Se creará en el catálogo y quedará seleccionada para este producto." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Crear categoría" Command="{Binding CreateCategoryCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
                  <TextBox x:Name="NewCategoryInput" Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Nueva categoría"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </TabItem>
      <TabItem Header="Precio y stock" Style="{StaticResource InventoryTab}">
        <StackPanel Margin="0,20,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Precio y niveles de inventario" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="El stock real se consulta y se corrige desde los movimientos." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <UniformGrid Columns="2" Margin="0,0,-16,0">
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Precio de referencia USD *" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="PriceInput" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Precio de referencia USD *"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Stock mínimo" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="MinimumStockInput" Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stock mínimo"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Stock máximo (opcional)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="MaximumStockInput" Text="{Binding MaximumStock, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stock máximo (opcional)"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="Usa punto decimal; por ejemplo, 12.50. El máximo vacío conserva el valor sin configurar." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Lotes y vencimiento" Style="{StaticResource InventoryTab}">
        <StackPanel Margin="0,20,0,0">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Trazabilidad" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="Configura el seguimiento que requiere este producto." Style="{StaticResource MutedText}"/>
          </StackPanel>
          <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,16">
            <StackPanel>
              <CheckBox Content="Controla lotes" IsChecked="{Binding TracksLot}" Margin="0,0,0,16"/>
              <CheckBox Content="Controla vencimiento" IsChecked="{Binding TracksExpiry}"/>
              <TextBlock Text="El control de vencimiento requiere seguimiento por lote." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Días de alerta de vencimiento" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ExpiryDaysInput" Text="{Binding ExpiryAlertDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Días de alerta de vencimiento"/>
          </StackPanel>
          <TextBlock Text="Guardar conserva el historial y actualiza la ficha del producto." Style="{StaticResource MutedText}"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
