<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Shared.ProductPickerView">
  <StackPanel>
    <StackPanel.InputBindings>
      <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
    </StackPanel.InputBindings>
    <WrapPanel>
      <StackPanel Width="300" Margin="0,0,16,12">
        <TextBlock Text="SKU o nombre" Margin="0,0,0,6"/>
        <TextBox Style="{StaticResource SearchBox}" Tag="Buscar…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU o nombre"/>
      </StackPanel>
      <Button Tag="&#xE721;" Content="Buscar" Command="{Binding SearchCommand}" Margin="0,0,8,8"/>
    </WrapPanel>
    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" Height="190" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Elegir" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
        <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}" Width="140"/>
        <DataGridTextColumn Header="Producto" Binding="{Binding Product.Name}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Margin="0,8,0,0">
      <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
      <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
    </WrapPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
