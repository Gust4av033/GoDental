<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Shared.ProductPickerView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Inventory.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <DockPanel Margin="0,0,0,12" IsEnabled="{Binding IsNotBusy}">
      <Button DockPanel.Dock="Right" Content="Buscar" Tag="" Command="{Binding SearchCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
      <TextBox Style="{StaticResource SearchBox}" Tag="Buscar productos por SKU o nombre…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU o nombre">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
        </TextBox.InputBindings>
      </TextBox>
    </DockPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" Height="210" RowHeight="44" SelectionMode="Single" IsEnabled="{Binding IsNotBusy}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Elegir" Width="65">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Product.Name}" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn IsReadOnly="True" Header="SKU" Binding="{Binding Product.Sku}" Width="110" ElementStyle="{StaticResource InventoryCell}"/>
        <DataGridTemplateColumn Header="Producto" Width="*" MinWidth="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <DockPanel>
                <Border Style="{StaticResource InventorySymbol}" DockPanel.Dock="Left" Margin="0,0,10,0">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Product.Name}" Style="{StaticResource InventoryCell}"/>
              </DockPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn IsReadOnly="True" Header="Disponible físico" Binding="{Binding Product.AvailableStock, StringFormat={}{0:0.####}}" Width="125" ElementStyle="{StaticResource InventoryNumber}"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCount, StringFormat=Seleccionados: {0}}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsNotBusy}">
        <Button Content="‹" ToolTip="Página anterior" AutomationProperties.Name="Página anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,6,0"/>
        <Button Content="›" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}"/>
      </StackPanel>
    </DockPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0"/>
  </StackPanel>
</UserControl>
