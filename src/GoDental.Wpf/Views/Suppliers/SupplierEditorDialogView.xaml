<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Suppliers.SupplierEditorDialogView">
  <StackPanel xmlns:shared="clr-namespace:GoDental.Wpf.Views.Shared" IsEnabled="{Binding CanEdit}">
    <WrapPanel Visibility="{Binding IsSupplier, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Código automático" Margin="0,0,0,6"/>
        <TextBox Text="{Binding CodeDisplay, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Código"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Nombre" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Supplier.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="País" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Supplier.Country, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="País"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Dirección" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Supplier.Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dirección"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Correo" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Supplier.Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Correo"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Teléfono" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Supplier.Phone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Teléfono"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Sitio web" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Supplier.Website, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sitio web"/>
      </StackPanel>
      <CheckBox Content="Proveedor activo" IsChecked="{Binding Supplier.Active}" Margin="0,6,16,12"/>
    </WrapPanel>
    <WrapPanel Visibility="{Binding IsContact, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Nombre" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Contact.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Cargo" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Contact.Position, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cargo"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Correo" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Contact.Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Correo"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Teléfono" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Contact.Phone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Teléfono"/>
      </StackPanel>
      <CheckBox Content="Contacto principal" IsChecked="{Binding Contact.Primary}" Margin="0,6,16,12"/>
      <CheckBox Content="Contacto activo" IsChecked="{Binding Contact.Active}" Margin="0,6,16,12"/>
      <TextBlock Text="Para cambiar el contacto principal, desmarca primero el actual, guarda y después selecciona el nuevo." Style="{StaticResource MutedText}"/>
    </WrapPanel>
    <StackPanel Visibility="{Binding IsProduct, Converter={StaticResource BoolToVisibility}}">
      <shared:ProductPickerView DataContext="{Binding Picker}" Visibility="{Binding DataContext.IsNewProduct, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource BoolToVisibility}}"/>
      <TextBlock Text="{Binding Product.Product}" Style="{StaticResource SectionHeading}"/>
      <WrapPanel>
        <StackPanel Width="240" Margin="0,0,16,12">
          <TextBlock Text="SKU del proveedor" Margin="0,0,0,6"/>
          <TextBox Text="{Binding Product.SupplierSku, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU del proveedor"/>
        </StackPanel>
        <StackPanel Width="240" Margin="0,0,16,12">
          <TextBlock Text="Costo de referencia (6 decimales)" Margin="0,0,0,6"/>
          <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Costo de referencia (6 decimales)"/>
        </StackPanel>
        <StackPanel Width="240" Margin="0,0,16,12">
          <TextBlock Text="Moneda"/>
          <ComboBox ItemsSource="{Binding Currencies}" SelectedValue="{Binding CurrencyId}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="Moneda del costo"/>
        </StackPanel>
        <StackPanel Width="240" Margin="0,0,16,12">
          <TextBlock Text="Cantidad mínima / MOQ (4 decimales)" Margin="0,0,0,6"/>
          <TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad mínima / MOQ (4 decimales)"/>
        </StackPanel>
        <StackPanel Width="240" Margin="0,0,16,12">
          <TextBlock Text="Plazo en días" Margin="0,0,0,6"/>
          <TextBox Text="{Binding LeadTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plazo en días"/>
        </StackPanel>
        <CheckBox Content="Referencia preferida" IsChecked="{Binding Product.Preferred}" Margin="0,6,16,12"/>
        <CheckBox Content="Referencia activa" IsChecked="{Binding Product.Active}" Margin="0,6,16,12"/>
      </WrapPanel>
    </StackPanel>
    <StackPanel Width="450" Margin="0,0,16,12">
      <TextBlock Text="Motivo del cambio" Margin="0,0,0,6"/>
      <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo del cambio"/>
    </StackPanel>
    <CheckBox Content="He revisado los datos y el estado activo/inactivo" IsChecked="{Binding Confirmed}" Margin="0,6,16,12"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
