<UserControl x:Class="GoDental.Wpf.Views.Suppliers.SupplierEditorDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GoDental.Wpf.Controls" xmlns:shared="clr-namespace:GoDental.Wpf.Views.Shared">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GoDental;component/Themes/Directory.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="{Binding Supplier.Name}" Style="{StaticResource SectionHeading}" Margin="0,0,0,4"/>
    <TextBlock Text="Revisa la información y registra el motivo antes de guardar." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <TabControl x:Name="SupplierSections" Visibility="{Binding IsSupplier, Converter={StaticResource BoolToVisibility}}">
      <TabItem Header="Información general" Style="{StaticResource CommerceTab}">
        <StackPanel Style="{StaticResource DirectorySection}">
          <UniformGrid Columns="2" Margin="0,0,-16,0">
            <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Código automático" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CodeDisplay, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Código"/></StackPanel>
            <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Nombre comercial / Razón social" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Supplier.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Nombre"/></StackPanel>
          </UniformGrid>
          <StackPanel Margin="0,0,0,16"><TextBlock Text="País" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}" DisplayMemberPath="Name" IsTextSearchEnabled="True" AutomationProperties.Name="País"/></StackPanel>
          <StackPanel><TextBlock Text="Dirección" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Supplier.Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" AutomationProperties.Name="Dirección"/></StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Contacto y estado" Style="{StaticResource CommerceTab}">
        <StackPanel Style="{StaticResource DirectorySection}">
          <UniformGrid Columns="2" Margin="0,0,-16,0">
            <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Correo electrónico" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Supplier.Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Correo"/></StackPanel>
            <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/><controls:PhoneInput Text="{Binding Supplier.Phone, UpdateSourceTrigger=PropertyChanged}" Region="{Binding PhoneRegion}" MaxLength="40" Label="Teléfono"/></StackPanel>
          </UniformGrid>
          <StackPanel Margin="0,0,0,16"><TextBlock Text="Sitio web" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Supplier.Website, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Sitio web"/><TextBlock Text="Dirección completa con https:// o http://." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
          <CheckBox Content="Proveedor activo" IsChecked="{Binding Supplier.Active}"/>
          <TextBlock Text="Desactivar conserva contactos, productos e historial del proveedor." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Visibility="{Binding IsContact, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Datos de la persona de contacto" Style="{StaticResource SectionHeading}" Margin="0,0,0,16"/>
      <UniformGrid Columns="2" Margin="0,0,-16,0">
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Contact.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.Name="Nombre del contacto"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Cargo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Contact.Position, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Cargo"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Correo electrónico" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Contact.Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Correo del contacto"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/><controls:PhoneInput Text="{Binding Contact.Phone, UpdateSourceTrigger=PropertyChanged}" Region="{Binding PhoneRegion}" MaxLength="40" Label="Teléfono del contacto"/></StackPanel>
      </UniformGrid>
      <WrapPanel><CheckBox Content="Contacto principal" IsChecked="{Binding Contact.Primary}" Margin="0,0,24,8"/><CheckBox Content="Contacto activo" IsChecked="{Binding Contact.Active}" Margin="0,0,0,8"/></WrapPanel>
      <Border Style="{StaticResource DirectoryNote}"><TextBlock Text="Para cambiar el contacto principal, desmarca primero el actual, guarda y después selecciona el nuevo." Style="{StaticResource MutedText}"/></Border>
    </StackPanel>
    <StackPanel Visibility="{Binding IsProduct, Converter={StaticResource BoolToVisibility}}">
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20" Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVisibility}}">
        <StackPanel><TextBlock Text="1. Selecciona un producto del catálogo" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/><shared:ProductPickerView DataContext="{Binding Picker}"/></StackPanel>
      </Border>
      <TextBlock Text="Referencia comercial" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="{Binding Product.Product}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
      <UniformGrid Columns="2" Margin="0,0,-16,0">
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="SKU del proveedor" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Product.SupplierSku, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="SKU del proveedor"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Costo de referencia" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Costo de referencia (6 decimales)"/><TextBlock Text="Hasta 6 decimales, usando punto decimal." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Moneda del costo" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Currencies}" SelectedValue="{Binding CurrencyId}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="Moneda del costo"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Cantidad mínima (MOQ)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad mínima / MOQ (4 decimales)"/><TextBlock Text="Hasta 4 decimales." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><TextBlock Text="Plazo de entrega (días)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding LeadTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plazo en días"/></StackPanel>
        <StackPanel Style="{StaticResource DirectoryEditorField}"><CheckBox Content="Referencia preferida" IsChecked="{Binding Product.Preferred}" Margin="0,12,0,8"/><CheckBox Content="Referencia activa" IsChecked="{Binding Product.Active}"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="Esta referencia no modifica precios, existencias ni el costo del inventario." Style="{StaticResource MutedText}"/>
    </StackPanel>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="Motivo del cambio" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" AutomationProperties.Name="Motivo del cambio"/>
        <CheckBox IsChecked="{Binding Confirmed}" Margin="0,16,0,12"><TextBlock Text="He revisado los datos y el estado activo/inactivo" TextWrapping="Wrap"/></CheckBox>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
