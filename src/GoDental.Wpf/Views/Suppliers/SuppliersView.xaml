<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Suppliers.SuppliersView">
  <StackPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <StackPanel Style="{StaticResource MasterListPanel}">
    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="Nuevo proveedor" Command="{Binding NewCommand}" Margin="12,0,0,0" Style="{StaticResource PrimaryActionButton}" Tag="&#xE710;" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="Proveedores" Style="{StaticResource Heading}"/></DockPanel>
    <TextBlock Text="Contactos y referencias comerciales en una sola ficha." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <StackPanel Width="280" Margin="0,0,16,12">
        <TextBlock Text="Código, nombre o país" Margin="0,0,0,6"/>
        <TextBox Style="{StaticResource SearchBox}" Tag="Buscar…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Código, nombre o país"/>
      </StackPanel>
      <CheckBox Content="Incluir inactivos" IsChecked="{Binding IncludeInactive}" Margin="0,6,16,12"/>
      <Button Tag="&#xE721;" Content="Buscar / Actualizar" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" Margin="0,0,8,12"/>
    </WrapPanel>
    <TextBlock Text="No hay proveedores para mostrar." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="380" Margin="0,0,0,12" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/>
        <DataGridTemplateColumn Header="Proveedor" Width="*" MinWidth="180" CellTemplate="{StaticResource PersonName}"/>
        <DataGridTextColumn Header="País" Binding="{Binding Country}" Width="130"/>
        <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="150"/>
        <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
      <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
      <Button Content="Ver ficha" Command="{Binding OpenCommand}" Margin="0,0,8,8"/>
      <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center"/>
    </WrapPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="Actualizar ficha" Tag="&#xE72C;" Command="{Binding RefreshDetailCommand}" IsEnabled="{Binding IsNotBusy}"/>
        <Button Content="Volver a proveedores" Tag="&#xE72B;" Command="{Binding ReturnToListCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,18">
        <Border DockPanel.Dock="Left" Background="{DynamicResource SidebarSelectionBrush}" CornerRadius="22" Width="44" Height="44" Margin="0,0,12,0"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ContentControl DockPanel.Dock="Right" Content="{Binding Detail.Active}" ContentTemplate="{StaticResource ActiveBadge}" VerticalAlignment="Top"/>
        <StackPanel><TextBlock Text="{Binding Detail.Name}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Detail.Code}" Style="{StaticResource MutedText}"/></StackPanel>
      </DockPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
    <TabControl>
      <TabItem Header="Información general"><StackPanel Margin="16"><UniformGrid Columns="2">
<StackPanel Margin="0,0,20,16"><TextBlock Text="País" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Detail.Country}" Margin="0,4,0,0"/></StackPanel>
<StackPanel Margin="0,0,20,16"><TextBlock Text="Dirección" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Detail.Address}" Margin="0,4,0,0"/></StackPanel>
<StackPanel Margin="0,0,20,16"><TextBlock Text="Correo electrónico" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Detail.Email}" Margin="0,4,0,0"/></StackPanel>
<StackPanel Margin="0,0,20,16"><TextBlock Text="Teléfono" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Detail.Phone}" Margin="0,4,0,0"/></StackPanel>
<StackPanel Margin="0,0,20,16"><TextBlock Text="Sitio web" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Detail.Website}" Margin="0,4,0,0"/></StackPanel>
      </UniformGrid><Button Content="Editar proveedor" Tag="&#xE70F;" Command="{Binding EditSupplierCommand}" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEdit}"/></StackPanel></TabItem>
      <TabItem Header="Contactos">
        <StackPanel Margin="16">
          <DataGrid ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="200" Margin="0,0,0,12" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Cargo" Binding="{Binding Position}" Width="120"/>
              <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="170"/>
              <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="120"/>
              <DataGridTextColumn Header="Principal" Binding="{Binding Primary}" Width="70"/>
              <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEditChildren}">
            <Button Tag="&#xE710;" Content="Nuevo contacto…" Command="{Binding NewContactCommand}" Margin="0,0,8,8"/>
            <Button Content="Editar / Estado…" Command="{Binding EditContactCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Productos y referencias">
        <StackPanel Margin="16">
          <DataGrid ItemsSource="{Binding References}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="200" Margin="0,0,0,12" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SKU local" Binding="{Binding LocalSku}" Width="90"/>
              <DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="*"/>
              <DataGridTextColumn Header="SKU externo" Binding="{Binding SupplierSku}" Width="110"/>
              <DataGridTemplateColumn Header="Costo / moneda" Width="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding LastCost}" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding Currency}"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="MOQ" Binding="{Binding MinimumQuantity}" Width="70"/>
              <DataGridTextColumn Header="Días" Binding="{Binding LeadTimeDays}" Width="50"/>
              <DataGridTextColumn Header="Preferido" Binding="{Binding Preferred}" Width="70"/>
              <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEditChildren}">
            <Button Tag="&#xE710;" Content="Nueva referencia…" Command="{Binding NewProductCommand}" Margin="0,0,8,8"/>
            <Button Content="Editar / Estado…" Command="{Binding EditProductCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
    </StackPanel>
  </StackPanel>
</UserControl>
