<UserControl x:Class="GoDental.Wpf.Views.Auth.UserCreateDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Background="{DynamicResource TintBrush}" Padding="12" CornerRadius="{StaticResource CardRadius}" Margin="0,0,0,12"><TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"/></Border>
    <Grid IsEnabled="{Binding CanEdit}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
        <Label Content="Usuario" Target="{Binding ElementName=UserNameInput}"/>
        <TextBox x:Name="UserNameInput" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Nuevo usuario"/>
        <Label Content="Nombre completo" Target="{Binding ElementName=DisplayNameInput}" Margin="0,8,0,0"/>
        <TextBox x:Name="DisplayNameInput" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.Name="Nombre completo del usuario"/>
        <Label Content="Rol" Target="{Binding ElementName=RoleInput}" Margin="0,8,0,0"/>
        <ComboBox x:Name="RoleInput" ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedItem="{Binding Role}" AutomationProperties.Name="Rol del usuario"/>
        <TextBlock Text="No hay roles disponibles para asignar." Visibility="{Binding IsRolesEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Label Content="Contraseña temporal" Target="{Binding ElementName=NewPassword}"/>
        <PasswordBox x:Name="NewPassword" MaxLength="128" AutomationProperties.Name="Contraseña temporal"/>
        <Label Content="Repite la contraseña temporal" Target="{Binding ElementName=NewConfirmation}" Margin="0,8,0,0"/>
        <PasswordBox x:Name="NewConfirmation" MaxLength="128" AutomationProperties.Name="Confirmación de contraseña temporal"/>
        <TextBlock Text="El usuario deberá elegir una contraseña propia en su primer ingreso." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
