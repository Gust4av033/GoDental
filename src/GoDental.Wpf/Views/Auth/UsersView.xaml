<UserControl x:Class="GoDental.Wpf.Views.Auth.UsersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GoDental;component/Themes/Directory.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <DockPanel Margin="0,0,0,20">
      <Button DockPanel.Dock="Right" Content="Crear cuenta" Tag="&#xE710;" Command="{Binding OpenCreateCommand}" Style="{StaticResource PrimaryActionButton}" IsEnabled="{Binding CanOpenDialog}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" Margin="16,0,0,0"/>
      <Button DockPanel.Dock="Right" Content="&#xE72C;" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource CommerceIconButton}" ToolTip="Actualizar usuarios" AutomationProperties.Name="Actualizar usuarios" Margin="16,0,0,0"/>
      <StackPanel><TextBlock Text="Usuarios" Style="{StaticResource Heading}"/><TextBlock Text="Administra las cuentas y el acceso de tu equipo." Style="{StaticResource MutedText}"/></StackPanel>
    </DockPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cargando usuarios"/>
    <Grid>
      <DataGrid MouseDoubleClick="OnUserDoubleClick" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="300" RowHeight="48" SelectionMode="Single" AutomationProperties.Name="Usuarios">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeCode}" Width="130" ElementStyle="{StaticResource CommerceCell}"/>
          <DataGridTemplateColumn Header="Nombre y cuenta" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate>
            <DockPanel><Border Style="{StaticResource DirectoryAvatar}" DockPanel.Dock="Left" Margin="0,0,10,0"><TextBlock Text="{Binding DisplayName, Converter={StaticResource CommerceInitials}}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource CommerceCell}" FontWeight="SemiBold"/><TextBlock Text="{Binding UserName}" Style="{StaticResource CommerceCell}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="120" ElementStyle="{StaticResource CommerceCell}"/>
          <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Cambio de clave" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding MustChangePassword}" ContentTemplate="{StaticResource CommerceYesNo}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Bloqueo hasta" Binding="{Binding LockedUntil, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue=—}" Width="150" ElementStyle="{StaticResource CommerceCell}"/>
        </DataGrid.Columns>
      </DataGrid>
      <ContentControl Style="{StaticResource CommerceEmpty}" Tag="{Binding Users.Count}" Content="No hay usuarios para mostrar. Actualiza el listado o crea una cuenta si tienes permiso."/>
    </Grid>
    <DockPanel Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Administrar cuenta" Tag="&#xE70F;" Command="{Binding OpenManageCommand}" IsEnabled="{Binding CanManageSelected}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ActionButton}" Margin="16,0,0,0"/>
      <TextBlock Text="{Binding Users.Count, StringFormat='Cuentas registradas: {0}'}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Style="{StaticResource DirectoryNote}"><TextBlock Text="Cada persona debe usar su propia cuenta. Selecciona un usuario o haz doble clic en su fila para administrar su acceso." Style="{StaticResource MutedText}"/></Border>
  </StackPanel>
</UserControl>
