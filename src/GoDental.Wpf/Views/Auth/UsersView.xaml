<UserControl x:Class="GoDental.Wpf.Views.Auth.UsersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Actualizar usuarios" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsNotBusy}" />
      <TextBlock Text="Usuarios y acceso" Style="{StaticResource Heading}" />
    </DockPanel>
    <TextBlock Text="Cuentas individuales para administradores y vendedores." Style="{StaticResource MutedText}" Margin="0,0,0,16" />
    <Border Background="{DynamicResource TintBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
      <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12" />
    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="260" SelectionMode="Single" AutomationProperties.Name="Usuarios">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="140" />
        <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="*" MinWidth="180" />
        <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="140" />
        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active}" Width="80" />
        <DataGridCheckBoxColumn Header="Cambio de clave" Binding="{Binding MustChangePassword}" Width="130" />
        <DataGridTextColumn Header="Bloqueado hasta" Binding="{Binding LockedUntil, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="170" />
      </DataGrid.Columns>
    </DataGrid>
    <Border Style="{StaticResource Card}" Margin="0,20,0,0" IsEnabled="{Binding CanEdit}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="Crear cuenta" Style="{StaticResource SectionHeading}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="Usuario" />
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Nuevo usuario" />
            <Label Content="Nombre completo" Margin="0,8,0,0" />
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.Name="Nombre completo del usuario" />
            <Label Content="Rol" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedItem="{Binding Role}" AutomationProperties.Name="Rol del usuario" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Contraseña temporal" Target="{Binding ElementName=NewPassword}" />
            <PasswordBox x:Name="NewPassword" MaxLength="128" />
            <Label Content="Repite la contraseña temporal" Margin="0,8,0,0" Target="{Binding ElementName=NewConfirmation}" />
            <PasswordBox x:Name="NewConfirmation" MaxLength="128" />
            <TextBlock Text="El usuario deberá elegir una contraseña propia en su primer ingreso." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
            <Button Content="Crear usuario" Click="CreateClicked" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,20,0,0" IsEnabled="{Binding CanEdit}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="Administrar cuenta seleccionada" Style="{StaticResource SectionHeading}" />
        <TextBlock Text="{Binding SelectedUser.DisplayName, TargetNullValue=Selecciona una cuenta del listado.}" Style="{StaticResource MutedText}" />
        <Label Content="Motivo del cambio" Margin="0,12,0,0" />
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Motivo del cambio de usuario" />
        <Button Content="Activar / desactivar seleccionado" Command="{Binding ToggleActiveCommand}" HorizontalAlignment="Left" Margin="0,12,0,16" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="Nueva contraseña temporal" Target="{Binding ElementName=ResetPassword}" />
            <PasswordBox x:Name="ResetPassword" MaxLength="128" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Repite la contraseña temporal" Target="{Binding ElementName=ResetConfirmation}" />
            <PasswordBox x:Name="ResetConfirmation" MaxLength="128" />
          </StackPanel>
        </Grid>
        <Button Content="Restablecer contraseña y desbloquear" Click="ResetClicked" HorizontalAlignment="Left" Margin="0,16,0,0" />
        <TextBlock Text="Tu propia contraseña se cambia desde Acceso de usuarios. No puedes desactivar tu cuenta." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>