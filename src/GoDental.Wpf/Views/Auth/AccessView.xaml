<UserControl x:Class="GoDental.Wpf.Views.Auth.AccessView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel MaxWidth="680" HorizontalAlignment="Left">
    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Heading}" />
    <TextBlock Text="Cada operación quedará asociada a tu usuario y a este equipo." Style="{StaticResource MutedText}" Margin="0,0,0,20" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding IdentityLabel}" Style="{StaticResource SectionHeading}" />
          <Button Content="Cambiar mi contraseña" Command="{Binding BeginPasswordChangeCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />
        </StackPanel>
        <StackPanel Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVisibility}}">
          <Button Content="Comprobar acceso / preparar cuenta" Command="{Binding PrepareCommand}" IsEnabled="{Binding IsNotBusy}" HorizontalAlignment="Left" Margin="0,0,0,20" />
          <StackPanel IsEnabled="{Binding IsNotBusy}">
            <Label Content="_Usuario" Target="{Binding ElementName=UserInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,6" />
            <TextBox x:Name="UserInput" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" MinWidth="350" />
            <StackPanel Visibility="{Binding IsBootstrap, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
              <Label Content="_Nombre completo" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,6" />
              <TextBox x:Name="NameInput" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />
            </StackPanel>
            <StackPanel Visibility="{Binding MustChangePassword, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
              <Label Content="Contraseña _actual" Target="{Binding ElementName=CurrentPasswordInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,6" />
              <PasswordBox x:Name="CurrentPasswordInput" MaxLength="128" />
            </StackPanel>
            <Label Content="_Contraseña" Target="{Binding ElementName=PasswordInput}" Foreground="{DynamicResource TextBrush}" Padding="0,12,0,6" />
            <PasswordBox x:Name="PasswordInput" MaxLength="128" />
            <StackPanel Visibility="{Binding NeedsConfirmation, Converter={StaticResource BoolToVisibility}}">
              <Label Content="_Repite la contraseña" Target="{Binding ElementName=ConfirmationInput}" Foreground="{DynamicResource TextBrush}" Padding="0,12,0,6" />
              <PasswordBox x:Name="ConfirmationInput" MaxLength="128" />
              <TextBlock Text="Puedes usar una frase de 10 a 128 caracteres." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
            <Button Content="Continuar" Style="{StaticResource PrimaryButton}" Click="SubmitClicked" IsEnabled="{Binding IsReady}" HorizontalAlignment="Left" Margin="0,20,0,0" />
          </StackPanel>
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0" />
        <Border Background="{DynamicResource TintBrush}" CornerRadius="6" Padding="16" Margin="0,20,0,0">
          <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>