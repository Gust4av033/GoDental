<UserControl x:Class="GoDental.Wpf.Views.Auth.UserManageDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Background="{DynamicResource TintBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,12"><TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"/></Border>
    <TextBlock Text="{Binding SelectedUser.DisplayName, TargetNullValue=Selecciona una cuenta del listado.}" Style="{StaticResource SectionHeading}"/>
    <TextBlock Text="Los cambios de estado y contraseña quedan auditados." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <StackPanel IsEnabled="{Binding CanEdit}">
      <Label Content="Motivo del cambio" Target="{Binding ElementName=ReasonInput}"/>
      <TextBox x:Name="ReasonInput" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Motivo del cambio de usuario"/>
      <Button Content="Activar / desactivar seleccionado" Command="{Binding ToggleActiveCommand}" HorizontalAlignment="Left" Margin="0,12,0,16"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><Label Content="Nueva contraseña temporal" Target="{Binding ElementName=ResetPassword}"/><PasswordBox x:Name="ResetPassword" MaxLength="128" AutomationProperties.Name="Nueva contraseña temporal"/></StackPanel>
        <StackPanel Grid.Column="2"><Label Content="Repite la contraseña temporal" Target="{Binding ElementName=ResetConfirmation}"/><PasswordBox x:Name="ResetConfirmation" MaxLength="128" AutomationProperties.Name="Confirmación de nueva contraseña temporal"/></StackPanel>
      </Grid>
      <Button Content="Restablecer contraseña y desbloquear" Click="ResetClicked" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      <TextBlock Text="Tu propia contraseña se cambia desde Acceso de usuarios. No puedes desactivar tu cuenta." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
  </StackPanel>
</UserControl>
