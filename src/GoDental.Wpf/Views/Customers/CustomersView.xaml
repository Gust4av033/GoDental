<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GoDental.Wpf.Views.Customers.CustomersView">
  <StackPanel>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
    <StackPanel Style="{StaticResource MasterListPanel}">
    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="Nuevo cliente" Command="{Binding NewCommand}" Margin="12,0,0,0" Style="{StaticResource PrimaryActionButton}" Tag="&#xE710;" IsEnabled="{Binding CanCreate}"/><TextBlock Text="Clientes" Style="{StaticResource Heading}"/></DockPanel>
    <TextBlock Text="Información comercial, contactos y direcciones para tu operación." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <StackPanel Width="280" Margin="0,0,16,12">
        <TextBlock Text="Código, nombre, documento o teléfono" Margin="0,0,0,6"/>
        <TextBox Style="{StaticResource SearchBox}" Tag="Buscar…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Código, nombre, documento o teléfono"/>
      </StackPanel>
      <StackPanel Width="240" Margin="0,0,16,12">
        <TextBlock Text="Tipo de cliente"/>
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" DisplayMemberPath="Name" AutomationProperties.Name="Tipo de cliente"/>
      </StackPanel>
      <CheckBox Content="Incluir inactivos" IsChecked="{Binding IncludeInactive}" Margin="0,6,16,12"/>
      <Button Tag="&#xE721;" Content="Buscar" Command="{Binding SearchCommand}" VerticalAlignment="Bottom" Margin="0,0,8,12"/>
      <Button Tag="&#xE72C;" Content="Actualizar" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" Margin="0,0,8,12"/>
    </WrapPanel>
    <TextBlock Text="No hay clientes para mostrar." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="380" Margin="0,0,0,12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="95"/>
        <DataGridTemplateColumn Header="Cliente" Width="*" MinWidth="180" CellTemplate="{StaticResource PersonName}"/>
        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="140"/>
        <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="120"/>
        <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel IsEnabled="{Binding IsNotBusy}">
      <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
      <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
      <Button Content="Ver ficha" Command="{Binding OpenCommand}" Margin="0,0,8,8"/>
      <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center"/>
    </WrapPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="Actualizar ficha" Tag="&#xE72C;" Command="{Binding RefreshDetailCommand}" IsEnabled="{Binding IsNotBusy}"/>
        <Button Content="Volver a clientes" Tag="&#xE72B;" Command="{Binding ReturnToListCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,18">
        <Border DockPanel.Dock="Left" Background="{DynamicResource SidebarSelectionBrush}" CornerRadius="22" Width="44" Height="44" Margin="0,0,12,0"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ContentControl DockPanel.Dock="Right" Content="{Binding Detail.Active}" ContentTemplate="{StaticResource ActiveBadge}" VerticalAlignment="Top"/>
        <StackPanel><TextBlock Text="{Binding Detail.Name}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Detail.Code}" Style="{StaticResource MutedText}"/></StackPanel>
      </DockPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
    <TabControl>
      <TabItem Header="Información general">
        <StackPanel Margin="16">
<UniformGrid Columns="2" MaxWidth="940"><StackPanel Margin="0,0,20,16">
            <TextBlock Text="Código" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.Code}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="Nombre comercial" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.CommercialName}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="Teléfono" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.Phone}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="WhatsApp" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.WhatsApp}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="Correo" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.Email}" TextWrapping="Wrap"/></Border>
          </StackPanel></UniformGrid>

          <CheckBox Content="Cliente activo" IsChecked="{Binding Detail.Active, Mode=OneWay}" IsEnabled="False" Margin="0,0,0,12"/>
          <Button Content="Editar ficha" Tag="&#xE70F;" HorizontalAlignment="Left" Command="{Binding EditCustomerCommand}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Contactos">
        <StackPanel Margin="16">
          <DataGrid ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="190" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Cargo" Binding="{Binding Position}" Width="100"/>
              <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="110"/>
              <DataGridTextColumn Header="WhatsApp" Binding="{Binding WhatsApp}" Width="110"/>
              <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="150"/>
              <DataGridTextColumn Header="Principal" Binding="{Binding Primary}" Width="65"/>
              <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel IsEnabled="{Binding CanEditChildren}">
            <Button Tag="&#xE710;" Content="Nuevo contacto…" Command="{Binding NewContactCommand}" Margin="0,0,8,8"/>
            <Button Content="Editar / Estado…" Command="{Binding EditContactCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Direcciones">
        <StackPanel Margin="16">
          <DataGrid ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="190" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="85"/>
              <DataGridTextColumn Header="Departamento" Binding="{Binding Department}" Width="110"/>
              <DataGridTextColumn Header="Municipio" Binding="{Binding Municipality}" Width="110"/>
              <DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="*"/>
              <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="130"/>
              <DataGridTextColumn Header="Principal" Binding="{Binding Primary}" Width="65"/>
              <DataGridTemplateColumn Header="Estado" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel IsEnabled="{Binding CanEditChildren}">
            <Button Tag="&#xE710;" Content="Nueva dirección…" Command="{Binding NewAddressCommand}" Margin="0,0,8,8"/>
            <Button Content="Editar / Estado…" Command="{Binding EditAddressCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Datos fiscales">
        <StackPanel Margin="16">
<UniformGrid Columns="2" MaxWidth="940"><StackPanel Margin="0,0,20,16">
            <TextBlock Text="NIT" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.Nit}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="NRC" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.Nrc}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="DUI" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.Dui}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="Giro / Actividad económica" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.BusinessActivity}" TextWrapping="Wrap"/></Border>
          </StackPanel></UniformGrid>

          <Button Content="Editar ficha" Tag="&#xE70F;" HorizontalAlignment="Left" Command="{Binding EditCustomerCommand}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Comercial">
        <StackPanel Margin="16">
<UniformGrid Columns="2" MaxWidth="940"><StackPanel Margin="0,0,20,16">
            <TextBlock Text="Tipo de cliente" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.Type}" TextWrapping="Wrap"/></Border>
          </StackPanel>
<StackPanel Margin="0,0,20,16">
            <TextBlock Text="Lista de precios asignada" Style="{StaticResource MutedText}"/>
            <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,7" MinHeight="34" Margin="0,4,0,0"><TextBlock Text="{Binding Detail.PriceList}" TextWrapping="Wrap"/></Border>
          </StackPanel></UniformGrid>

          <Button Content="Editar ficha" Tag="&#xE70F;" HorizontalAlignment="Left" Command="{Binding EditCustomerCommand}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Crédito">
        <StackPanel Margin="16">
          <CheckBox Content="Crédito habilitado" IsChecked="{Binding Credit.Enabled, Mode=OneWay}" IsEnabled="False" Margin="0,0,0,12"/>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Límite configurado" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Credit.Limit}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Plazo en días" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Credit.Days}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Intervalo de avisos" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Credit.NoticeDays}" TextWrapping="Wrap"/>
          </StackPanel>
          <CheckBox Content="Crédito bloqueado" IsChecked="{Binding Credit.Blocked, Mode=OneWay}" IsEnabled="False" Margin="0,0,0,12"/>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Motivo de bloqueo" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Credit.BlockReason}" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Content="Configurar crédito…" Command="{Binding EditCreditCommand}" Margin="0,0,8,8" IsEnabled="{Binding CanConfigureCredit}"/>
          <StackPanel Visibility="{Binding CanReadHistory, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Consultar saldo y disponible" Command="{Binding LoadAccountsCommand}" Margin="0,0,8,8"/>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="Saldo utilizado" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Balance.Outstanding}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="Saldo vencido" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Balance.Overdue}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="Disponible nominal" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Balance.Available}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="La disponibilidad es informativa. Revisa habilitación y bloqueo; cada venta vuelve a validar sus condiciones." Style="{StaticResource MutedText}"/>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Historial de ventas" Visibility="{Binding CanReadHistory, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="16">
          <Button Content="Consultar ventas" Command="{Binding LoadSalesCommand}" Margin="0,0,8,8"/>
          <DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="190" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Venta" Binding="{Binding Number}" Width="130"/>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/>
              <DataGridTemplateColumn Header="Estado" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StateBadge}" Tag="{Binding State}"><TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource UsdMoney}}" Width="110" ElementStyle="{StaticResource MoneyCellText}"/>
              <DataGridTextColumn Header="Pendiente" Binding="{Binding Pending, Converter={StaticResource UsdMoney}}" Width="110" ElementStyle="{StaticResource MoneyCellText}"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel IsEnabled="{Binding IsNotBusy}">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousSalesCommand}" Margin="0,0,8,8"/>
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextSalesCommand}" Margin="0,0,8,8"/>
            <TextBlock Text="{Binding SalesLabel}"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Estado de cuenta" Visibility="{Binding CanReadHistory, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="16">
          <Button Content="Consultar cuentas y saldo" Command="{Binding LoadAccountsCommand}" Margin="0,0,8,8"/>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Saldo utilizado" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Balance.Outstanding}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Saldo vencido" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Balance.Overdue}" TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="190" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Cuenta" Binding="{Binding Id}" Width="70"/>
              <DataGridTextColumn Header="Venta" Binding="{Binding Sale}" Width="120"/>
              <DataGridTextColumn Header="Emisión" Binding="{Binding Issued, StringFormat=dd/MM/yyyy}" Width="140"/>
              <DataGridTextColumn Header="Vence" Binding="{Binding Due, StringFormat=dd/MM/yyyy}" Width="140"/>
              <DataGridTextColumn Header="Original" Binding="{Binding Original, Converter={StaticResource UsdMoney}}" Width="90" ElementStyle="{StaticResource MoneyCellText}"/>
              <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, Converter={StaticResource UsdMoney}}" Width="90" ElementStyle="{StaticResource MoneyCellText}"/>
              <DataGridTemplateColumn Header="Estado" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StateBadge}" Tag="{Binding State}"><TextBlock Text="{Binding State}" FontSize="11" TextWrapping="NoWrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel IsEnabled="{Binding IsNotBusy}">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousAccountsCommand}" Margin="0,0,8,8"/>
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextAccountsCommand}" Margin="0,0,8,8"/>
            <TextBlock Text="{Binding AccountsLabel}"/>
          </WrapPanel>
          <Button Content="Consultar abonos" Command="{Binding LoadPaymentsCommand}" Margin="0,0,8,8"/>
          <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="190" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Recibo" Binding="{Binding Receipt}" Width="130"/>
              <DataGridTextColumn Header="Cuenta" Binding="{Binding AccountId}" Width="70"/>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/>
              <DataGridTextColumn Header="Monto" Binding="{Binding Amount, Converter={StaticResource UsdMoney}}" Width="100" ElementStyle="{StaticResource MoneyCellText}"/>
              <DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="110"/>
              <DataGridTextColumn Header="Anulado" Binding="{Binding Voided}" Width="75"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel IsEnabled="{Binding IsNotBusy}">
            <Button Content="‹" ToolTip="Anterior" AutomationProperties.Name="Anterior" Style="{StaticResource PaginationButton}" Command="{Binding PreviousPaymentsCommand}" Margin="0,0,8,8"/>
            <Button Content="›" ToolTip="Siguiente" AutomationProperties.Name="Siguiente" Style="{StaticResource PaginationButton}" Command="{Binding NextPaymentsCommand}" Margin="0,0,8,8"/>
            <TextBlock Text="{Binding PaymentsLabel}"/>
          </WrapPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
    </StackPanel>
  </StackPanel>
</UserControl>
