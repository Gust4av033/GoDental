<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GoDental.Wpf.Controls" xmlns:behaviors="clr-namespace:GoDental.Wpf.Behaviors" x:Class="GoDental.Wpf.Views.Customers.CustomerEditorDialogView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GoDental;component/Themes/Customers.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel IsEnabled="{Binding CanEdit}">
    <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,20">
      <DockPanel>
        <Border DockPanel.Dock="Left" Style="{StaticResource CustomerIdentityAvatar}" Margin="0,0,12,0">
          <TextBlock Text="{Binding Customer.Name, Converter={StaticResource CustomerInitials}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Customer.Name, Converter={StaticResource CustomerOptionalText}, ConverterParameter=Nuevo cliente}" Style="{StaticResource SectionHeading}"/>
          <TextBlock Text="{Binding CodeDisplay}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}">
      <TabItem Header="Información general" Style="{StaticResource CustomerTab}">
        <UniformGrid Columns="2" Margin="0,16,-16,0">
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Nombre / Razón social" Style="{StaticResource FieldLabel}"/>
            <TextBox MaxLength="200" Text="{Binding Customer.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre / Razón social"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Nombre comercial" Style="{StaticResource FieldLabel}"/>
            <TextBox MaxLength="200" Text="{Binding Customer.CommercialName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre comercial"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
            <controls:PhoneInput Text="{Binding Customer.Phone, UpdateSourceTrigger=PropertyChanged}" Label="Teléfono"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="WhatsApp" Style="{StaticResource FieldLabel}"/>
            <controls:PhoneInput Text="{Binding Customer.WhatsApp, UpdateSourceTrigger=PropertyChanged}" Label="WhatsApp"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Correo" Style="{StaticResource FieldLabel}"/>
            <TextBox MaxLength="254" Text="{Binding Customer.Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Correo"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Código automático" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding CodeDisplay, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Código"/>
          </StackPanel>
        </UniformGrid>
      </TabItem>
      <TabItem Header="Datos fiscales" Style="{StaticResource CustomerTab}">
        <UniformGrid Columns="2" Margin="0,16,-16,0">
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="NIT" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding NitFormats}" SelectedItem="{Binding NitDigits}" AutomationProperties.Name="Dígitos del NIT"/>
            <TextBlock Text="14: NIT · 9: DUI como NIT" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,6"/>
            <TextBox Text="{Binding NitText, UpdateSourceTrigger=PropertyChanged}" behaviors:IdentityMask.Digits="{Binding NitDigits}" AutomationProperties.Name="NIT"/>
            <TextBlock Text="0000-000000-000-0 o 00000000-0" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="NRC" Style="{StaticResource FieldLabel}"/>
            <TextBox MaxLength="30" Text="{Binding Customer.Nrc, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="NRC"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="DUI" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding DuiText, UpdateSourceTrigger=PropertyChanged}" behaviors:IdentityMask.Digits="9" AutomationProperties.Name="DUI"/>
            <TextBlock Text="00000000-0 · opcional" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Giro / Actividad económica" Style="{StaticResource FieldLabel}"/>
            <TextBox MaxLength="250" Text="{Binding Customer.BusinessActivity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Giro / Actividad económica"/>
          </StackPanel>
        </UniformGrid>
      </TabItem>
      <TabItem Header="Comercial y estado" Style="{StaticResource CustomerTab}">
        <StackPanel>
          <UniformGrid Columns="2" Margin="0,16,-16,0">
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Tipo de cliente" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Types}" SelectedValue="{Binding SelectedTypeId}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="Tipo de cliente"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,16">
              <TextBlock Text="Lista de precios" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding PriceLists}" SelectedValue="{Binding PriceListId}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="Lista de precios"/>
            </StackPanel>
          </UniformGrid>
          <CheckBox Content="Cliente activo" IsChecked="{Binding Customer.Active}" Margin="0,0,0,16"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Visibility="{Binding IsContact, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Datos del contacto" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Cargar contacto" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
      <ComboBox ItemsSource="{Binding ContactSources}" SelectedItem="{Binding SelectedContactSource}" DisplayMemberPath="Name" AutomationProperties.Name="Cargar contacto"/>
      <TextBlock Text="{Binding ContactSourceHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
      <UniformGrid Columns="2" Margin="0,16,-16,0">
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
          <TextBox MaxLength="150" Text="{Binding Contact.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Cargo" Style="{StaticResource FieldLabel}"/>
          <TextBox MaxLength="100" Text="{Binding Contact.Position, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cargo"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
          <controls:PhoneInput Text="{Binding Contact.Phone, UpdateSourceTrigger=PropertyChanged}" Label="Teléfono"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="WhatsApp" Style="{StaticResource FieldLabel}"/>
          <controls:PhoneInput Text="{Binding Contact.WhatsApp, UpdateSourceTrigger=PropertyChanged}" Label="WhatsApp"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Correo" Style="{StaticResource FieldLabel}"/>
          <TextBox MaxLength="254" Text="{Binding Contact.Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Correo"/>
        </StackPanel>
      </UniformGrid>
      <WrapPanel>
        <CheckBox Content="Contacto principal" IsChecked="{Binding Contact.Primary}" Margin="0,0,24,16"/>
        <CheckBox Content="Contacto activo" IsChecked="{Binding Contact.Active}" Margin="0,0,0,16"/>
      </WrapPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsAddress, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Ubicación del cliente" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Dirección histórica: conserva sus valores o selecciona la división actual completa." Style="{StaticResource MutedText}" Visibility="{Binding Location.HasLegacyLocation, Converter={StaticResource BoolToVisibility}}"/>
      <TextBlock Text="14 departamentos · 44 municipios · distrito opcional" Style="{StaticResource MutedText}"/>
      <UniformGrid Columns="2" Margin="0,16,-16,0">
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Tipo de dirección" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding AddressTypes}" SelectedItem="{Binding Address.Type}" AutomationProperties.Name="Tipo de dirección"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding Location.Departments}" SelectedItem="{Binding Location.Department}" IsTextSearchEnabled="True" AutomationProperties.Name="Departamento"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Municipio" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding Location.Municipalities}" SelectedItem="{Binding Location.Municipality}" IsTextSearchEnabled="True" AutomationProperties.Name="Municipio"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Distrito (opcional)" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding Location.Districts}" SelectedItem="{Binding Location.District}" IsTextSearchEnabled="True" AutomationProperties.Name="Distrito"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Referencia" Style="{StaticResource FieldLabel}"/>
          <TextBox MaxLength="300" Text="{Binding Address.Reference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Referencia"/>
        </StackPanel>
      </UniformGrid>
      <StackPanel Margin="0,0,16,16">
        <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}"/>
        <TextBox MaxLength="500" Text="{Binding Address.Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dirección" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
      <WrapPanel>
        <CheckBox Content="Dirección principal" IsChecked="{Binding Address.Primary}" Margin="0,0,24,16"/>
        <CheckBox Content="Dirección activa" IsChecked="{Binding Address.Active}" Margin="0,0,0,16"/>
      </WrapPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Condiciones de crédito" Style="{StaticResource SectionHeading}"/>
      <WrapPanel Margin="0,16,0,0">
        <CheckBox Content="Crédito habilitado" IsChecked="{Binding Credit.Enabled}" Margin="0,0,24,0"/>
        <CheckBox Content="Crédito bloqueado" IsChecked="{Binding Credit.Blocked}"/>
      </WrapPanel>
      <UniformGrid Columns="2" Margin="0,16,-16,0">
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Límite de crédito (2 decimales)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Límite de crédito (2 decimales)"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Plazo en días" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plazo en días"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Intervalo de avisos en días" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding NoticeDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Intervalo de avisos en días"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,16">
          <TextBlock Text="Motivo del bloqueo" Style="{StaticResource FieldLabel}"/>
          <TextBox MaxLength="500" Text="{Binding Credit.BlockReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo del bloqueo"/>
        </StackPanel>
      </UniformGrid>
      <TextBlock Text="Cada venta valida las condiciones del cliente al confirmarla." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    </StackPanel>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock Text="Confirmación del cambio" Style="{StaticResource SectionHeading}"/>
        <StackPanel Margin="0,12,0,16">
          <TextBlock Text="Motivo del cambio" Style="{StaticResource FieldLabel}"/>
          <TextBox MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo del cambio"/>
        </StackPanel>
        <CheckBox Content="He revisado los datos y el estado del registro" IsChecked="{Binding Confirmed}" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
