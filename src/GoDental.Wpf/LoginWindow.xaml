<Window x:Class="GoDental.Wpf.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:brand="clr-namespace:GoDental.Wpf.Controls" xmlns:auth="clr-namespace:GoDental.Wpf.Views.Auth" Title="Acceso · GoDental" Width="980" Height="680" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFontFamily}" FontSize="14">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="24">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" MaxWidth="270">
          <Border Style="{StaticResource BrandPlate}" Margin="0,0,0,26">
            <brand:BrandLogoView MaxHeight="200"/>
          </Border>
          <TextBlock Text="Todo listo para tu día." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="Tus productos, ventas y entregas en un solo lugar." Style="{StaticResource MutedText}" Margin="0,12,0,0" LineHeight="22"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
          <Button Content="Ajustes de conexión" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Abrir ajustes de conexión" HorizontalAlignment="Stretch"/>
          <TextBlock Text="¿Primer acceso? Revisa la conexión de este equipo." Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,24,4">
        <Label Content="Tema oscuro" Target="{Binding ElementName=LoginThemeSwitch}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ToggleButton x:Name="LoginThemeSwitch" Style="{StaticResource ThemeSwitch}" IsChecked="{Binding Connection.IsDark}" Command="{Binding Connection.SaveThemePreferenceCommand}" AutomationProperties.Name="Tema oscuro"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
        <auth:AccessView DataContext="{Binding Access}" Margin="24,20,24,28"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
