<Window x:Class="GoDental.Wpf.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:auth="clr-namespace:GoDental.Wpf.Views.Auth" Title="Acceso · GoDental" Width="980" Height="640" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="3.5*"/><ColumnDefinition Width="6.5*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource TintBrush}" ClipToBounds="True">
      <Grid>
        <Ellipse Width="470" Height="350" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-150" IsHitTestVisible="False"/>
        <Ellipse Width="330" Height="250" Fill="{DynamicResource BackgroundBrush}" Opacity="0.65" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-130,0,0,-158" IsHitTestVisible="False"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28" MaxWidth="300">
          <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock Text="G" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="GoDental" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" TextAlignment="Center"/>
          <TextBlock Text="TU OPERACIÓN, CONECTADA" Style="{StaticResource PageEyebrow}" TextAlignment="Center" Margin="0,16,0,0"/>
          <TextBlock Text="Gestión para tu depósito dental" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,24">
          <Button Content="Ajustes de conexión" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Abrir ajustes de conexión" HorizontalAlignment="Stretch"/>
          <TextBlock Text="Configura el servidor antes de iniciar sesión." Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,28,0">
        <Label Content="Tema oscuro" Target="{Binding ElementName=LoginThemeSwitch}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ToggleButton x:Name="LoginThemeSwitch" Style="{StaticResource ThemeSwitch}" IsChecked="{Binding Connection.IsDark}" Command="{Binding Connection.SaveThemePreferenceCommand}" AutomationProperties.Name="Tema oscuro"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <auth:AccessView DataContext="{Binding Access}" Margin="28,16,28,28" VerticalAlignment="Center"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
