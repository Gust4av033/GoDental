<Window x:Class="GoDental.Wpf.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:auth="clr-namespace:GoDental.Wpf.Views.Auth" Title="Acceso · GoDental" Width="920" Height="660" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" Padding="24,32">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="Ajustes de conexión" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Abrir ajustes de conexión" Margin="0,0,0,12"/>
          <TextBlock Text="Conexión, base de datos y apariencia" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="GoDental" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}"/>
          <TextBlock Text="GESTIÓN COMERCIAL" FontSize="11" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,6,0,28"/>
          <TextBlock Text="Acceso de usuarios" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" TextWrapping="Wrap"/>
          <TextBlock Text="Ingresa con tu cuenta para trabajar con el inventario y los módulos disponibles." Foreground="{DynamicResource SidebarMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Label Content="Tema oscuro" Target="{Binding ElementName=LoginThemeSwitch}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ToggleButton x:Name="LoginThemeSwitch" Style="{StaticResource ThemeSwitch}" IsChecked="{Binding Connection.IsDark}" Command="{Binding Connection.SaveThemePreferenceCommand}" AutomationProperties.Name="Tema oscuro"/>
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <auth:AccessView DataContext="{Binding Access}" Margin="32,28"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
